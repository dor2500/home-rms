                                    <TextBlock x:Name="SystemAdminText" Text="AGENT: STANDARD USER" FontFamily="{StaticResource MonoFont}" FontSize="10.5" FontWeight="SemiBold" Foreground="#FBBF24"/>
                                </Border>
                                <StackPanel>
                                    <TextBlock x:Name="Win11PageTitle" Text="Home" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="Win11PageSubtitle" Text="Device overview and remote settings" FontSize="11.5" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Border DockPanel.Dock="Top" Style="{StaticResource CardStyle}" Padding="12,8" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.4*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock x:Name="SystemTargetLabel" Text="Target" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="SystemTargetBox" FontFamily="{StaticResource MonoFont}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock x:Name="SystemExtraLabel" Text="Extra" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="SystemExtraBox" FontFamily="{StaticResource MonoFont}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border DockPanel.Dock="Bottom" Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="4" Height="200" Margin="0,10,0,0">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="10,6,10,6">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <TextBlock Text="FILTER" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBox x:Name="SystemFilterBox" Width="170" TextChanged="OnSystemFilterChanged"/>
                                    </StackPanel>
                                    <TextBlock x:Name="SystemMessageText" Text="Select any operation above to execute on the endpoint." FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource MutedBrush}" FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                                <TextBlock x:Name="SystemHeaderText" DockPanel.Dock="Top" FontFamily="{StaticResource MonoFont}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="10,0,10,4"/>
                                <ListBox x:Name="SystemRowsList" Background="Transparent" BorderThickness="0" FontFamily="{StaticResource MonoFont}" FontSize="11.5" Foreground="#E2E8F0" SelectionChanged="OnSystemRowSelected"/>
                            </DockPanel>
                        </Border>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="Win11CardsPanel"/>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>

                <!-- ==================== 7. REVERSE-PROXIED WEB UI & APPLIANCE VIEW ==================== -->
                <DockPanel x:Name="WebUiPanel" Visibility="Collapsed">
                    <Border DockPanel.Dock="Top" Style="{StaticResource CardStyle}" Padding="14,12" Margin="0,0,0,10">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Open in Browser (Proxied)" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="OnOpenProxiedWebUiClick"/>
                                <Button Content="Refresh Health" Style="{StaticResource GhostButton}" Click="OnRefreshApplianceHealthClick"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock x:Name="WebUiTitleText" Text="Appliance Web UI (Central Reverse Proxy)" Style="{StaticResource Caption}" Margin="0,0,0,2"/>
                                <TextBlock x:Name="WebUiUrlText" Text="http://localhost:7480/proxy/..." FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{StaticResource AccentBrush}"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" Padding="18">
                        <StackPanel>
                            <TextBlock Text="APPLIANCE &amp; SERVICE TELEMETRY" Style="{StaticResource Caption}" Margin="0,0,0,8"/>
                            <TextBlock x:Name="ApplianceMetricsText" Text="Select an appliance or click Refresh Health to query Ping / HTTP / SSH metrics."
                                       FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" Margin="0,0,0,14"/>
                            <TextBlock Text="All traffic is reverse-proxied through the Central Home RMS Server so dashboards (Home Assistant, TrueNAS, Synology, Proxmox) remain accessible from both the Desktop Console and Mobile Web App without exposing direct LAN ports."
                                       FontSize="11.5" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </DockPanel>

                <!-- ==================== 8-10. FEATURE VIEWS (Views\*.xaml, wired in MainWindow.Features.cs) ==================== -->
                <ContentControl x:Name="FilesHost" Visibility="Collapsed"/>
                <ContentControl x:Name="ServicesHost" Visibility="Collapsed"/>
                <ContentControl x:Name="ScriptsHost" Visibility="Collapsed"/>

            </Grid>
        </Grid>

        <!-- ==================== ADD / EDIT ENDPOINT SLIDE-OUT DRAWER ==================== -->
        <Grid x:Name="EndpointDrawerOverlay" Grid.RowSpan="2" Visibility="Collapsed" Background="#B3090A0D">
            <Border Width="400" HorizontalAlignment="Right" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0,0,0" Padding="20,16">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Content="Close" Style="{StaticResource SmallPillButton}" Click="OnCloseEndpointDrawerClick"/>
                        <StackPanel>
                            <TextBlock Text="ENDPOINT CONFIGURATION" Style="{StaticResource Caption}" Margin="0,0,0,2"/>
                            <TextBlock x:Name="DrawerTitleText" Text="Add or Edit Managed Endpoint" FontSize="14.5" FontWeight="SemiBold"/>
                        </StackPanel>
                    </DockPanel>

                    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <Button Content="Save Endpoint" Style="{StaticResource PrimaryButton}" Margin="0,0,0,8" Click="OnSaveMachineClick"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Delete" Style="{StaticResource DangerButton}" Click="OnRemoveMachineClick"/>
                            <Button Grid.Column="2" Content="Cancel" Style="{StaticResource GhostButton}" Click="OnCloseEndpointDrawerClick"/>
                        </Grid>
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,4,0">
                            <TextBlock Text="ENDPOINT TYPE &amp; CONNECTION MODE" Style="{StaticResource Caption}"/>
                            <ComboBox x:Name="EndpointKindCombo" SelectedIndex="0" Margin="0,0,0,10" SelectionChanged="OnEndpointKindChanged"
                                      Background="{StaticResource FieldBrush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource LineBrush}">
                                <ComboBoxItem Content="Windows — Agent (mTLS)" Tag="WindowsAgent"/>
                                <ComboBoxItem Content="Windows — Agentless (WinRM / RDP)" Tag="WindowsAgentless"/>
                                <ComboBoxItem Content="Home Assistant" Tag="HomeAssistant"/>
                                <ComboBoxItem Content="NAS / Storage Appliance" Tag="Nas"/>
                                <ComboBoxItem Content="Linux Server (SSH)" Tag="Linux"/>
                                <ComboBoxItem Content="Local Web Service" Tag="WebService"/>
                            </ComboBox>

                            <TextBlock Text="DISPLAY NAME" Style="{StaticResource Caption}"/>
                            <TextBox x:Name="NameBox" Text="Living Room PC" Margin="0,0,0,10"/>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="HOST / LAN IP" Style="{StaticResource Caption}"/>
                                    <TextBox x:Name="HostBox" FontFamily="{StaticResource MonoFont}" Text="localhost"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="PORT" Style="{StaticResource Caption}"/>
                                    <TextBox x:Name="PortBox" FontFamily="{StaticResource MonoFont}" Text="7443"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="MAC ADDRESS (WAKE-ON-LAN)" Style="{StaticResource Caption}"/>
                            <TextBox x:Name="MacBox" FontFamily="{StaticResource MonoFont}" Text="" Margin="0,0,0,10"/>

                            <!-- Credentials / Agentless / SSH / Web UI Fields -->
                            <StackPanel x:Name="CredentialsPanel" Visibility="Collapsed">
                                <TextBlock Text="USERNAME (WINRM / RDP / SSH)" Style="{StaticResource Caption}"/>
                                <TextBox x:Name="UsernameBox" FontFamily="{StaticResource MonoFont}" Margin="0,0,0,10"/>

                                <TextBlock Text="PASSWORD (STORED DPAPI-ENCRYPTED)" Style="{StaticResource Caption}"/>
                                <PasswordBox x:Name="EndpointPasswordBox" Background="{StaticResource FieldBrush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="9,6" Margin="0,0,0,10"/>

                                <Grid x:Name="SshFieldsGrid" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="SSH PORT" Style="{StaticResource Caption}"/>
                                        <TextBox x:Name="SshPortBox" FontFamily="{StaticResource MonoFont}" Text="22"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="SSH PRIVATE KEY PATH (OPTIONAL)" Style="{StaticResource Caption}"/>
                                        <TextBox x:Name="SshKeyBox" FontFamily="{StaticResource MonoFont}"/>
                                    </StackPanel>
                                </Grid>

                                <StackPanel x:Name="WebUrlPanel" Margin="0,0,0,10">
                                    <TextBlock Text="WEB UI URL (REVERSE PROXY)" Style="{StaticResource Caption}"/>
                                    <TextBox x:Name="WebUrlBox" FontFamily="{StaticResource MonoFont}" ToolTip="e.g. http://192.168.1.50:8123"/>
                                </StackPanel>

                                <CheckBox x:Name="UseMultimonCheck" Content="Enable Multi-Monitor RDP (/multimon)" IsChecked="True" Margin="0,0,0,10"/>

                                <Grid x:Name="AgentlessActionsGrid" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="Prep Script" Style="{StaticResource SmallPillButton}" Click="OnCopyPrepScriptClick" ToolTip="Copy path/command for Prepare-AgentlessHost.ps1"/>
                                    <Button Grid.Column="2" Content="Install Agent" Style="{StaticResource SmallPillButton}" Click="OnInstallAgentRemotelyClick" ToolTip="One-click install Home RMS Agent remotely via WinRM"/>
                                </Grid>
                            </StackPanel>

                            <Border Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="5" Padding="10,8">
                                <TextBlock Text="All credentials (DPAPI) and Mutual-TLS X.509 certificates are stored and managed strictly on the Central Home RMS Server." FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ==================== CLIENT HEALTH & ALERT CENTER DRAWER ==================== -->
        <Grid x:Name="AlertDrawerOverlay" Grid.RowSpan="2" Visibility="Collapsed" Background="#B3090A0D">
            <Border Width="430" HorizontalAlignment="Right" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0,0,0" Padding="20,16">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Ack All" Style="{StaticResource SmallPillButton}" Margin="0,0,6,0" Click="OnAckAllAlertsClick"/>
                            <Button Content="Clear" Style="{StaticResource SmallPillButton}" Margin="0,0,6,0" Click="OnClearAlertsClick"/>
                            <Button Content="Close" Style="{StaticResource SmallPillButton}" Click="OnCloseAlertCenterClick"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="HEALTH MONITORING &amp; ALERTS" Style="{StaticResource Caption}" Margin="0,0,0,2"/>
                            <TextBlock Text="Alert Center" FontSize="15" FontWeight="SemiBold"/>
                        </StackPanel>
                    </DockPanel>

                    <Border DockPanel.Dock="Bottom" Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="ALERT THRESHOLDS" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="CPU %" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBox x:Name="CpuThresholdBox" FontFamily="{StaticResource MonoFont}" Text="90"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="RAM %" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBox x:Name="RamThresholdBox" FontFamily="{StaticResource MonoFont}" Text="90"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Disk Min%" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBox x:Name="DiskThresholdBox" FontFamily="{StaticResource MonoFont}" Text="10"/>
                                </StackPanel>
                                <StackPanel Grid.Column="6">
                                    <TextBlock Text="Temp °C" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBox x:Name="TempThresholdBox" FontFamily="{StaticResource MonoFont}" Text="85"/>
                                </StackPanel>
                            </Grid>
                            <Button Content="Save Thresholds" Style="{StaticResource SmallPillButton}" HorizontalAlignment="Right" Margin="0,8,0,0" Click="OnSaveAlertThresholdsClick"/>
                        </StackPanel>
                    </Border>

                    <ListBox x:Name="AlertsListBox" Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="4">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="5" Padding="10,8" Margin="0,0,0,6">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,3">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding TimeText}" FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding SeverityText}" FontFamily="{StaticResource MonoFont}" FontSize="10" FontWeight="Bold" Foreground="{Binding SeverityBrush}" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </DockPanel>
                                        <TextBlock Text="{Binding EndpointName}" FontFamily="{StaticResource MonoFont}" FontSize="10.5" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,2"/>
                                        <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>

