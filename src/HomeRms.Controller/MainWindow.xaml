                        </DockPanel>
                    </Border>

                    <!-- Winstall-Style App Cards Grid -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="WingetCatalogList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="236" Margin="0,0,10,10" Padding="12,10" Background="{StaticResource CardBrush}"
                                            BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,6">
                                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Top" Click="OnWingetCardSelectionChanged"/>
                                                <Border Width="30" Height="30" CornerRadius="5" Background="#111317" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Margin="0,0,9,0" DockPanel.Dock="Left">
                                                    <Grid>
                                                        <TextBlock Text="{Binding Monogram}" FontFamily="{StaticResource MonoFont}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        <Image Source="{Binding IconUrl}" Width="18" Height="18" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                    </Grid>
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
