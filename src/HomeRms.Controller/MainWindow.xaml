            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Border Style="{StaticResource CardStyle}" Width="440" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="22,20" Margin="0,16">
                <StackPanel>
                    <DockPanel Margin="0,0,0,14">
                        <Button DockPanel.Dock="Right" Content="Close" Style="{StaticResource SmallPillButton}" Click="OnCloseAboutClick"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Home RMS Central Server &amp; PKI" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="Hub &amp; Relay Architecture (mTLS / HTTP2)" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                    </DockPanel>

                    <Border Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="5" Padding="12,10" Margin="0,0,0,14">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock DockPanel.Dock="Right" x:Name="AboutVersionText" Text="v2.0.0" FontFamily="{StaticResource MonoFont}" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                                <TextBlock Text="Server Build" Foreground="{StaticResource MutedBrush}"/>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock DockPanel.Dock="Right" Text=".NET 11.0 (Central Hub &amp; Console)" FontFamily="{StaticResource MonoFont}" FontSize="11.5"/>
                                <TextBlock Text="Runtime" Foreground="{StaticResource MutedBrush}"/>
                            </DockPanel>
                            <TextBlock Text="SERVER X.509 SHA-256 FINGERPRINT" Style="{StaticResource Caption}" Margin="0,4,0,4"/>
                            <TextBox x:Name="AboutFingerprintBox" IsReadOnly="True" FontFamily="{StaticResource MonoFont}" FontSize="10.5" Padding="8,5" Margin="0,0,0,10"/>

                            <!-- Security: unreadable 2FA config warning -->
                            <Border x:Name="SecurityWarningBorder" Visibility="Collapsed" BorderBrush="{StaticResource WarnBrush}" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,0,0,8">
                                <TextBlock x:Name="SecurityWarningText" FontSize="10.5" Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap"/>
                            </Border>
                            <CheckBox x:Name="Require2FaStartupCheck" Content="Lock console on startup (Windows Hello / TOTP / master password)" Margin="0,0,0,6" Checked="OnToggleStartup2Fa" Unchecked="OnToggleStartup2Fa"/>
                            <CheckBox x:Name="AllowPasskeyCheck" Content="Allow Windows Hello (fingerprint / face / PIN) to unlock" Margin="0,0,0,8" Checked="OnToggleAllowPasskey" Unchecked="OnToggleAllowPasskey"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="TOTP Authenticator Secret:" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="AboutTotpSecretBox" IsReadOnly="True" FontFamily="{StaticResource MonoFont}" FontSize="10.5" Padding="8,5" Margin="0,0,0,8"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Button Content="Copy URI" Style="{StaticResource SmallPillButton}" Margin="0,0,6,0" Click="OnCopyController2FaUriClick"/>
                                        <Button Content="Regen Backup" Style="{StaticResource SmallPillButton}" Click="OnRegenerateBackupCodesClick"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="Remember device (days):" FontSize="10.5" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBox x:Name="RememberDaysBox" FontFamily="{StaticResource MonoFont}" Text="30" Width="44" Padding="5,2" LostFocus="OnRememberDaysLostFocus"/>
                                    </StackPanel>
                                </StackPanel>
                                <Border Grid.Column="2" Background="White" CornerRadius="4" Padding="5" VerticalAlignment="Center">
                                    <Image x:Name="AboutQrImage" Width="104" Height="104" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                </Border>
                            </Grid>
                            <TextBlock Text="ONE-TIME BACKUP CODES" Style="{StaticResource Caption}" Margin="0,8,0,3"/>
                            <TextBox x:Name="AboutBackupCodesBox" IsReadOnly="True" FontFamily="{StaticResource MonoFont}" FontSize="10" Padding="7,4"/>

                            <!-- Security diagnostics -->
                            <TextBlock Text="UNLOCK FACTORS" Style="{StaticResource Caption}" Margin="0,12,0,3"/>
                            <TextBlock x:Name="SecurityDiagText" FontFamily="{StaticResource MonoFont}" FontSize="10.5" TextWrapping="Wrap" Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Button x:Name="TestHelloButton" Content="Test Windows Hello" Style="{StaticResource SmallPillButton}" Margin="0,0,6,0" Click="OnTestWindowsHelloClick"/>
                                <Button x:Name="ForgetDeviceButton" Content="Forget This Device" Style="{StaticResource SmallPillButton}" Click="OnForgetDeviceClick"/>
                            </StackPanel>
                            <TextBlock x:Name="TestHelloResultText" FontSize="10.5" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,4"/>

                            <!-- Master password (optional fallback) -->
                            <TextBlock Text="MASTER PASSWORD (OPTIONAL FALLBACK)" Style="{StaticResource Caption}" Margin="0,10,0,3"/>
                            <TextBlock Text="Current password, TOTP or backup code (leave empty to verify with Windows Hello):" FontSize="10.5" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,3"/>
                            <PasswordBox x:Name="CurrentFactorBox" Background="{StaticResource FieldBrush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="8,5" Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="New password:" FontSize="10.5" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,3"/>
                                    <PasswordBox x:Name="NewMasterPasswordBox" Background="{StaticResource FieldBrush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="8,5"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Confirm:" FontSize="10.5" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,3"/>
                                    <PasswordBox x:Name="ConfirmMasterPasswordBox" Background="{StaticResource FieldBrush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="8,5"/>
                                </StackPanel>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Button x:Name="SetMasterPasswordButton" Content="Set / Change Password" Style="{StaticResource SmallPillButton}" Margin="0,0,6,0" Click="OnSetMasterPasswordClick"/>
                                <Button x:Name="ClearMasterPasswordButton" Content="Remove Password" Style="{StaticResource SmallPillButton}" Click="OnClearMasterPasswordClick"/>
                            </StackPanel>
                            <TextBlock x:Name="MasterPasswordStatusText" FontSize="10.5" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Repository:" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
                    <TextBlock Margin="0,0,0,14" FontFamily="{StaticResource MonoFont}" FontSize="11.5">
                        <Hyperlink NavigateUri="https://github.com/dor2500/home-rms" RequestNavigate="OnOpenProjectLinkClick" Foreground="{StaticResource AccentBrush}">
                            https://github.com/dor2500/home-rms
                        </Hyperlink>
                    </TextBlock>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Copy Agent --pin Command" Style="{StaticResource GhostButton}" Click="OnCopyPinCommandClick"/>
                        <Button Grid.Column="2" Content="Done" Style="{StaticResource PrimaryButton}" Click="OnCloseAboutClick"/>
                    </Grid>
                </StackPanel>
            </Border>
            </ScrollViewer>
        </Grid>

        <!-- ==================== AUTO-LOCK OVERLAY: Windows Hello -> TOTP / backup code -> master password ==================== -->
        <Grid x:Name="LockOverlay" Grid.RowSpan="2" Visibility="Collapsed" Background="#F20E0F12" Panel.ZIndex="100"
              KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Cycle">
            <Border Style="{StaticResource CardStyle}" Width="370" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="22,20">
                <StackPanel>
                    <TextBlock Text="CONSOLE LOCKED" Style="{StaticResource Caption}" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,4"/>
                    <TextBlock Text="Verify with Windows Hello, an authenticator / backup code, or your master password." FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,12"/>

                    <Button x:Name="HelloUnlockButton" Content="Use Windows Hello" Style="{StaticResource PrimaryButton}" Margin="0,0,0,4" Click="OnUnlockWithPasskeyClick"/>
                    <TextBlock x:Name="HelloStatusText" Text="Checking Windows Hello..." FontSize="10.5" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                    <TextBlock Text="AUTHENTICATOR OR BACKUP CODE" Style="{StaticResource Caption}"/>
                    <PasswordBox x:Name="UnlockPinBox" Background="{StaticResource FieldBrush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="10,7" Margin="0,0,0,6" KeyDown="OnUnlockPinBoxKeyDown"/>
                    <Button x:Name="UnlockCodeButton" Content="Unlock with Code" Style="{StaticResource GhostButton}" Margin="0,0,0,10" Click="OnUnlockDashboardClick"/>

                    <StackPanel x:Name="MasterPasswordUnlockPanel" Visibility="Collapsed">
                        <TextBlock Text="MASTER PASSWORD" Style="{StaticResource Caption}"/>
                        <PasswordBox x:Name="UnlockPasswordBox" Background="{StaticResource FieldBrush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="10,7" Margin="0,0,0,6" KeyDown="OnUnlockPasswordBoxKeyDown"/>
                        <Button x:Name="UnlockPasswordButton" Content="Unlock with Password" Style="{StaticResource GhostButton}" Margin="0,0,0,10" Click="OnUnlockWithPasswordClick"/>
                    </StackPanel>

                    <CheckBox x:Name="RememberDeviceCheck" Content="Remember this device (skip startup lock)" IsChecked="False" Margin="0,0,0,8"/>
                    <TextBlock x:Name="LockStatusText" Text="" FontSize="11" Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap" Visibility="Collapsed"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ==================== AGENT INITIAL 2FA PAIRING MODAL ==================== -->
        <Grid x:Name="AgentPair2FaOverlay" Grid.RowSpan="2" Visibility="Collapsed" Background="#B3090A0D">
            <Border Style="{StaticResource CardStyle}" Width="380" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="22,20">
                <StackPanel>
                    <TextBlock Text="ENDPOINT 2FA PAIRING" Style="{StaticResource Caption}" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,4"/>
                    <TextBlock x:Name="AgentPairPromptText" Text="Enter the 6-digit TOTP code displayed on the remote endpoint to pair with the Central Server." FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <TextBox x:Name="Agent2FaCodeBox" FontFamily="{StaticResource MonoFont}" FontSize="16" TextAlignment="Center" Padding="10,7" Margin="0,0,0,12"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Verify &amp; Pair" Style="{StaticResource PrimaryButton}" Click="OnSubmitAgent2FaClick"/>
                        <Button Grid.Column="2" Content="Cancel" Style="{StaticResource GhostButton}" Click="OnCancelAgent2FaClick"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
