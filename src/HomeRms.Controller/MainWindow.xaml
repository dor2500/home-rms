<Window x:Class="HomeRms.Controller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Home RMS — Fleet Command Center" Height="840" Width="1360"
        MinHeight="680" MinWidth="1020"
        Icon="Assets/controller.ico"
        PreviewKeyDown="OnWindowPreviewKeyDown"
        PreviewKeyUp="OnWindowPreviewKeyUp"
        WindowStartupLocation="CenterScreen">

    <Grid Background="{StaticResource DeepBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ==================== TOP GLOBAL COMMAND BAR ==================== -->
        <Border x:Name="TopBarBorder" Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="14,10">
            <DockPanel LastChildFill="True">
                <!-- Right Global Action Cluster -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Border Background="#111726" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="10,6" Margin="0,0,8,0" VerticalAlignment="Center"
                            ToolTip="All endpoint sessions use Mutual-TLS (X.509 PKI)">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource OkBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="mTLS Active" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="ProbeBtn" Content="↻ Scan LAN" Style="{StaticResource GhostButton}"
                            Padding="11,6" Margin="0,0,8,0" Click="OnProbeMachinesClick"/>
                    <Button x:Name="UpdateBtn" Content="↻ Updates" Style="{StaticResource SmallPillButton}"
                            Margin="0,0,8,0" ToolTip="Check GitHub Releases (dor2500/home-rms) for updates"
                            Click="OnCheckOrApplyUpdateClick"/>
                    <Button x:Name="AddEndpointTopBtn" Content="+ Add Endpoint" Style="{StaticResource PrimaryButton}"
                            Padding="13,7" Click="OnOpenAddEndpointDrawerClick"/>
                </StackPanel>

                <!-- Left Brand + Sidebar Toggle + Global Fleet Status -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="SidebarToggleBtn" Content="☰" Style="{StaticResource GhostButton}"
                            Width="34" Height="34" Padding="0" FontSize="15" Margin="0,0,10,0"
                            ToolTip="Collapse / Expand Navigation Sidebar" Click="OnToggleSidebarClick"/>
                    <Image Source="Assets/controller.png" Width="30" Height="30" Margin="0,0,10,0"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="HOME RMS" FontSize="14" FontWeight="Bold"/>
                        <TextBlock Text="Operations Platform" FontSize="10.5" Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>

                    <Border x:Name="ConnBadgeBorder" Background="#1A0EA5E9" BorderBrush="#330EA5E9" BorderThickness="1"
                            CornerRadius="7" Padding="10,4" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock x:Name="ConnBadgeText" Text="0 Online • Disconnected" FontSize="11"
                                   FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                    </Border>
                </StackPanel>

                <!-- Center Global Status Readout -->
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TargetTitleText" Text="Fleet Operations Center" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="StatusText" Text="Global telemetry active. Scan LAN or select an endpoint in Fleet to connect."
                               FontSize="11" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ==================== MAIN BODY: COLLAPSIBLE SIDEBAR + WORKSPACE ==================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="RailColumn" Width="204"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Industrial Collapsible Sidebar -->
            <Border x:Name="RailBorder" Grid.Column="0" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0" Padding="0,12">
                <DockPanel>
                    <TextBlock x:Name="SidebarSectionLabel" DockPanel.Dock="Top" Text="NAVIGATION"
                               Style="{StaticResource Caption}" Margin="18,0,0,8"/>

                    <StackPanel DockPanel.Dock="Bottom" Margin="10,8,10,0">
                        <Button Style="{StaticResource GhostButton}" Padding="10,8" Margin="0,0,0,8"
                                HorizontalContentAlignment="Left" ToolTip="About Home RMS" Click="OnOpenAboutClick">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="ℹ" FontSize="14" Width="22" TextAlignment="Center" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="NavLabelAbout" Text="About" FontSize="12" FontWeight="Medium" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Border Background="#0A0E18" BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1" CornerRadius="9" Padding="10,8">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource OkBrush}" Margin="0,0,8,0"/>
                                <TextBlock x:Name="SidebarFooterText" Text="mTLS PKI Ready" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel>
                        <RadioButton x:Name="NavOverview" Style="{StaticResource RailTab}" IsChecked="True" Checked="OnNavTabChanged" ToolTip="Overview Dashboard">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📈" FontSize="14.5" Width="22" TextAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock x:Name="NavLabelOverview" Text="Overview" FontSize="12.5" FontWeight="Medium" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavFleet" Style="{StaticResource RailTab}" Checked="OnNavTabChanged" ToolTip="Managed LAN Fleet">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🌐" FontSize="14.5" Width="22" TextAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock x:Name="NavLabelFleet" Text="Fleet" FontSize="12.5" FontWeight="Medium" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavDesktop" Style="{StaticResource RailTab}" Checked="OnNavTabChanged" ToolTip="Remote Desktop Stream">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🖥️" FontSize="14.5" Width="22" TextAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock x:Name="NavLabelDesktop" Text="Desktop" FontSize="12.5" FontWeight="Medium" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavInventory" Style="{StaticResource RailTab}" Checked="OnNavTabChanged" ToolTip="System Monitor &amp; Processes">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📊" FontSize="14.5" Width="22" TextAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock x:Name="NavLabelMonitor" Text="Monitor" FontSize="12.5" FontWeight="Medium" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavShell" Style="{StaticResource RailTab}" Checked="OnNavTabChanged" ToolTip="Remote PowerShell Terminal">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="⌨️" FontSize="14.5" Width="22" TextAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock x:Name="NavLabelShell" Text="Shell" FontSize="12.5" FontWeight="Medium" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavDeploy" Style="{StaticResource RailTab}" Checked="OnNavTabChanged" ToolTip="Silent Software &amp; Script Deploy">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📦" FontSize="14.5" Width="22" TextAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock x:Name="NavLabelDeploy" Text="Deploy" FontSize="12.5" FontWeight="Medium" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavUpdates" Style="{StaticResource RailTab}" Checked="OnNavTabChanged" ToolTip="Remote Windows Updates">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🔄" FontSize="14.5" Width="22" TextAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock x:Name="NavLabelUpdates" Text="Updates" FontSize="12.5" FontWeight="Medium" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavSystem" Style="{StaticResource RailTab}" Checked="OnNavTabChanged" ToolTip="Remote System &amp; Settings">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="⚙️" FontSize="14.5" Width="22" TextAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock x:Name="NavLabelSettings" Text="Settings" FontSize="12.5" FontWeight="Medium" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Workspace Area -->
            <Grid x:Name="WorkspaceGrid" Grid.Column="1" Background="{StaticResource BgBrush}" Margin="20,16,20,16">

                <!-- ==================== 0. OVERVIEW DASHBOARD (LANDING) ==================== -->
                <DockPanel x:Name="OverviewPanel" Visibility="Visible">
                    <!-- Top Header -->
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                        <Button DockPanel.Dock="Right" Content="View Full Fleet →" Style="{StaticResource GhostButton}"
                                Padding="12,6" Click="OnGoToFleetClick"/>
                        <StackPanel>
                            <TextBlock Text="OPERATIONS OVERVIEW" Style="{StaticResource Caption}" Margin="0,0,0,2"/>
                            <TextBlock Text="Real-time fleet health, LAN telemetry, and recent system events" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Macro KPI Strip -->
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="16,14">
                            <StackPanel>
                                <TextBlock Text="ENDPOINTS ONLINE" Style="{StaticResource Caption}"/>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                    <TextBlock x:Name="KpiOnlineCount" Text="0 / 0" FontSize="24" FontWeight="Bold"/>
                                    <TextBlock x:Name="KpiOfflineSub" Text="0 offline" FontSize="11.5" Foreground="{StaticResource MutedBrush}" Margin="10,0,0,4"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="16,14">
                            <StackPanel>
                                <TextBlock Text="ACTIVE SESSION" Style="{StaticResource Caption}"/>
                                <TextBlock x:Name="KpiActiveSession" Text="Standby" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="KpiActiveLatency" Text="No active mTLS tunnel" FontSize="11.5" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="4" Style="{StaticResource CardStyle}" Padding="16,14">
                            <StackPanel>
                                <TextBlock Text="FLEET CPU / RAM" Style="{StaticResource Caption}"/>
                                <TextBlock x:Name="KpiFleetLoad" Text="--% CPU • --% RAM" FontSize="18" FontWeight="Bold"/>
                                <ProgressBar x:Name="KpiLoadBar" Style="{StaticResource ThinProgressBar}" Value="0" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="6" Style="{StaticResource CardStyle}" Padding="16,14">
                            <StackPanel>
                                <TextBlock Text="NETWORK LATENCY (RTT)" Style="{StaticResource Caption}"/>
                                <DockPanel>
                                    <TextBlock x:Name="KpiAvgLatency" Text="-- ms" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <Canvas Width="110" Height="28" DockPanel.Dock="Right" HorizontalAlignment="Right">
                                        <Polyline x:Name="OverviewSparkline" Stroke="{StaticResource AccentBrush}" StrokeThickness="2" Points="0,20 20,18 40,22 60,14 80,16 100,12"/>
                                    </Canvas>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Middle Row: Network Traffic Sparkline & Recent Alerts -->
                    <Grid DockPanel.Dock="Top" Height="200" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="16,14">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                    <TextBlock DockPanel.Dock="Right" x:Name="TrafficPeakText" Text="Peak: -- ms" FontSize="11.5" Foreground="{StaticResource AccentBrush}"/>
                                    <TextBlock Text="LAN TELEMETRY &amp; THROUGHPUT SPARKLINE" Style="{StaticResource Caption}" Margin="0"/>
                                </DockPanel>
                                <Border Background="#080B12" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="12,10">
                                    <Grid>
                                        <Viewbox Stretch="Fill">
                                            <Canvas Width="400" Height="110">
                                                <Line X1="0" Y1="27" X2="400" Y2="27" Stroke="#161D2E" StrokeThickness="1"/>
                                                <Line X1="0" Y1="55" X2="400" Y2="55" Stroke="#161D2E" StrokeThickness="1"/>
                                                <Line X1="0" Y1="82" X2="400" Y2="82" Stroke="#161D2E" StrokeThickness="1"/>
                                                <Polyline x:Name="TrafficSparkline" Stroke="{StaticResource AccentBrush}" StrokeThickness="2.5"
                                                          Points="0,85 45,78 90,82 135,62 180,68 225,52 270,58 315,44 360,48 400,38"/>
                                                <Polyline x:Name="CpuSparkline" Stroke="{StaticResource IndigoBrush}" StrokeThickness="2"
                                                          Points="0,92 45,88 90,84 135,79 180,82 225,74 270,76 315,70 360,72 400,66"/>
                                            </Canvas>
                                        </Viewbox>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Left">
                                            <Border Background="#1A0EA5E9" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                                <TextBlock Text="● RTT / Traffic" FontSize="10" Foreground="{StaticResource AccentBrush}"/>
                                            </Border>
                                            <Border Background="#1A6366F1" CornerRadius="4" Padding="6,2">
                                                <TextBlock Text="● Fleet CPU" FontSize="10" Foreground="#A5B4FC"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DockPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="16,14">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="RECENT SYSTEM ALERTS &amp; EVENTS" Style="{StaticResource Caption}" Margin="0,0,0,8"/>
                                <ListBox x:Name="OverviewEventsList" Background="Transparent" BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,3">
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding Timestamp}" FontFamily="Cascadia Mono, Consolas" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,0,8,0"/>
                                                <Border DockPanel.Dock="Left" Background="{Binding BadgeBackground}" CornerRadius="4" Padding="6,1" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding Category}" FontSize="10" FontWeight="Bold" Foreground="{Binding BadgeForeground}"/>
                                                </Border>
                                                <TextBlock Text="{Binding Message}" FontSize="11.5" TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <!-- Bottom Row: Quick Fleet Snapshot -->
                    <Border Style="{StaticResource CardStyle}" Padding="16,14">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                <TextBlock DockPanel.Dock="Right" Text="Click Connect on any host to open mTLS session" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock Text="ENDPOINT SNAPSHOT" Style="{StaticResource Caption}" Margin="0"/>
                            </DockPanel>
                            <ListBox x:Name="OverviewFleetList" Background="Transparent" BorderThickness="0"
                                     HorizontalContentAlignment="Stretch"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,4">
                                            <Button DockPanel.Dock="Right" Content="{Binding ConnectActionText}" Style="{StaticResource SmallPillButton}"
                                                    Tag="{Binding}" Click="OnCardConnectClick"/>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding LatencyLabel}" FontFamily="Cascadia Mono, Consolas"
                                                       FontSize="11.5" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="16,0,14,0" Width="64" TextAlignment="Right"/>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse Width="9" Height="9" Fill="{Binding DotBrush}" Margin="0,0,10,0">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect Color="{Binding DotGlowColor}" BlurRadius="10" ShadowDepth="0" Opacity="0.9"/>
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                                <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" Width="210" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Address}" FontFamily="Cascadia Mono, Consolas" FontSize="11.5" Foreground="{StaticResource AccentBrush}" Width="165"/>
                                                <TextBlock Text="{Binding OsTag}" FontSize="11.5" Foreground="{StaticResource MutedBrush}" Width="110"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                </DockPanel>

                <!-- ==================== 1. FLEET COMMAND GRID ==================== -->
                <DockPanel x:Name="FleetPanel" Visibility="Collapsed">
                    <!-- Slim Fleet Toolbar -->
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <TextBox x:Name="FleetFilterBox" Width="220" Margin="0,0,10,0" ToolTip="Filter endpoints by name, IP, or OS" TextChanged="OnFleetFilterChanged"/>
                            <Button Content="+ Add Endpoint" Style="{StaticResource PrimaryButton}" Padding="14,7" Click="OnOpenAddEndpointDrawerClick"/>
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="MANAGED LAN FLEET" Style="{StaticResource Caption}" Margin="0,0,0,2"/>
                            <TextBlock x:Name="FleetSummaryText" Text="Hover any card for Connect, Terminal, or Restart quick actions. Double-click to connect."
                                       FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Live Activity Log / Recent Events Feed (Docked Bottom) -->
                    <Border DockPanel.Dock="Bottom" Style="{StaticResource CardStyle}" Padding="14,12" Height="170" Margin="0,12,0,0">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <Button DockPanel.Dock="Right" Content="Clear" Style="{StaticResource SmallPillButton}" Click="OnClearActivityLogClick"/>
                                <TextBlock Text="LIVE ACTIVITY LOG &amp; RECENT EVENTS" Style="{StaticResource Caption}" Margin="0" VerticalAlignment="Center"/>
                            </DockPanel>
                            <ListBox x:Name="FleetActivityList" Background="#080B12" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                     Padding="6,4" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="2,2">
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Timestamp}" FontFamily="Cascadia Mono, Consolas" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,0,10,0"/>
                                            <Border DockPanel.Dock="Left" Background="{Binding BadgeBackground}" CornerRadius="4" Padding="6,1" Margin="0,0,10,0">
                                                <TextBlock Text="{Binding Category}" FontSize="10" FontWeight="Bold" Foreground="{Binding BadgeForeground}"/>
                                            </Border>
                                            <TextBlock Text="{Binding Message}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <!-- Responsive Upgraded Endpoint Cards Grid -->
                    <ListBox x:Name="MachinesList" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="OnMachineSelectionChanged"
                             MouseDoubleClick="OnMachineDoubleClick">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel IsItemsHost="True"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,14,14"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="CardBd" Width="335" Background="{StaticResource CardBrush}"
                                                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                                    CornerRadius="14" Padding="16,15">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="CardBd" Property="Background" Value="{StaticResource CardHoverBrush}"/>
                                                    <Setter TargetName="CardBd" Property="BorderBrush" Value="#334155"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="CardBd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                    <Setter TargetName="CardBd" Property="Background" Value="#121E33"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <!-- Header: Glowing Status Dot + Hostname + Status Badge -->
                                    <DockPanel Margin="0,0,0,8">
                                        <Border DockPanel.Dock="Right" Background="{Binding BadgeBackground}" CornerRadius="6" Padding="8,3">
                                            <TextBlock Text="{Binding StatusLabel}" FontSize="10.5" FontWeight="SemiBold"/>
                                        </Border>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="10" Height="10" Fill="{Binding DotBrush}" Margin="0,0,9,0">
                                                <Ellipse.Effect>
                                                    <DropShadowEffect Color="{Binding DotGlowColor}" BlurRadius="12" ShadowDepth="0" Opacity="0.95"/>
                                                </Ellipse.Effect>
                                            </Ellipse>
                                            <TextBlock Text="{Binding DisplayTitle}" FontSize="15" FontWeight="Bold" TextTrimming="CharacterEllipsis" MaxWidth="185"/>
                                        </StackPanel>
                                    </DockPanel>

                                    <!-- Address + OS Badge -->
                                    <DockPanel Margin="0,0,0,10">
                                        <Border DockPanel.Dock="Right" Background="#0D1322" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="5" Padding="7,2">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding OsGlyph}" FontSize="11" Margin="0,0,5,0" Foreground="{StaticResource AccentBrush}"/>
                                                <TextBlock Text="{Binding OsTag}" FontSize="10.5" Foreground="{StaticResource MutedBrush}"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="{Binding Address}" FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                                    </DockPanel>

                                    <!-- CPU / RAM Real-Time Mini Bars -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <DockPanel Margin="0,0,0,3">
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding CpuLabel}" FontSize="10.5" FontWeight="SemiBold"/>
                                                <TextBlock Text="CPU" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
                                            </DockPanel>
                                            <ProgressBar Style="{StaticResource ThinProgressBar}" Value="{Binding CpuPercent, Mode=OneWay}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <DockPanel Margin="0,0,0,3">
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding RamLabel}" FontSize="10.5" FontWeight="SemiBold"/>
                                                <TextBlock Text="RAM" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
                                            </DockPanel>
                                            <ProgressBar Style="{StaticResource ThinProgressBar}" Foreground="{StaticResource IndigoBrush}" Value="{Binding RamPercent, Mode=OneWay}"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Hover Quick Action Bar -->
                                    <Border x:Name="QuickActionsBar" Visibility="Collapsed" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,9,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="{Binding ConnectActionText}" Style="{StaticResource PrimaryButton}" Padding="10,4" FontSize="11" Margin="0,0,6,0" Tag="{Binding}" Click="OnCardConnectClick"/>
                                            <Button Content="Terminal" Style="{StaticResource SmallPillButton}" Padding="9,4" FontSize="11" Margin="0,0,6,0" Tag="{Binding}" Click="OnCardTerminalClick"/>
                                            <Button Content="Restart" Style="{StaticResource SmallPillButton}" Padding="9,4" FontSize="11" Margin="0,0,6,0" Tag="{Binding}" Click="OnCardRestartClick"/>
                                            <Button Content="Edit" Style="{StaticResource SmallPillButton}" Padding="9,4" FontSize="11" Tag="{Binding}" Click="OnCardEditClick"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsMouseOver}" Value="True">
                                        <Setter TargetName="QuickActionsBar" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                        <Setter TargetName="QuickActionsBar" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <!-- ==================== 2. REMOTE DESKTOP VIEW ==================== -->
                <DockPanel x:Name="DesktopPanel" Visibility="Collapsed">
                    <Border x:Name="DesktopToolbarBorder" DockPanel.Dock="Top" Style="{StaticResource CardStyle}" Padding="12,10" Margin="0,0,0,12">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                <Button Content="📋 Paste" Style="{StaticResource SmallPillButton}" Margin="0,0,6,0" Click="OnSendClipboardClick"/>
                                <Button Content="📥 Copy" Style="{StaticResource SmallPillButton}" Margin="0,0,8,0" Click="OnGetClipboardClick"/>
                                <Border Background="#0B0D14" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                        CornerRadius="7" Padding="9,5" Margin="0,0,8,0">
                                    <TextBlock x:Name="StreamStatus" Text="Idle" FontSize="11.5" Foreground="{StaticResource MutedBrush}"/>
                                </Border>
                                <Button x:Name="FullScreenBtn" Content="⛶ Full Screen (F11)" Style="{StaticResource GhostButton}" Padding="10,6" Click="OnToggleFullScreenClick"/>
                            </StackPanel>

                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="StreamBtn" Content="▶ Start Stream" Width="126" Style="{StaticResource PrimaryButton}" Padding="10,7" Click="OnToggleStream"/>
                                <CheckBox x:Name="ControlCheck" Content="Control" Margin="12,0,0,0" Checked="OnControlCheckChanged" Unchecked="OnControlCheckChanged"/>
                                <Border Width="1" Height="20" Background="{StaticResource LineBrush}" Margin="12,0"/>
                                <TextBlock Text="FPS:" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBox x:Name="FpsBox" Text="20" Width="38" Margin="0,0,8,0"/>
                                <TextBlock Text="Q:" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBox x:Name="QualityBox" Text="65" Width="38" Margin="0,0,8,0"/>
                                <ComboBox x:Name="ScaleBox" Width="106" SelectedIndex="0" Margin="0,0,6,0" Background="#0C0F17" Foreground="#F8FAFC" BorderBrush="#23293B">
                                    <ComboBoxItem Content="1080p (Fast)" Tag="1920"/>
                                    <ComboBoxItem Content="720p (Ultra)" Tag="1280"/>
                                    <ComboBoxItem Content="Native" Tag="0"/>
                                </ComboBox>
                                <ComboBox x:Name="UpscaleBox" Width="76" SelectedIndex="0" SelectionChanged="OnUpscaleModeChanged" Background="#0C0F17" Foreground="#F8FAFC" BorderBrush="#23293B">
                                    <ComboBoxItem Content="Sharp+" Tag="cas"/>
                                    <ComboBoxItem Content="Sharp" Tag="bicubic"/>
                                    <ComboBoxItem Content="Off" Tag="none"/>
                                </ComboBox>
                            </WrapPanel>
                        </DockPanel>
                    </Border>

                    <Border x:Name="ScreenCanvasBorder" Background="#050609" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="14" ClipToBounds="True">
                        <Grid>
                            <Grid x:Name="SharpenHost">
                                <Image x:Name="ScreenImage" Stretch="Uniform" Focusable="True"
                                       SizeChanged="OnScreenImageSizeChanged"
                                       MouseMove="OnScreenMouseMove" MouseDown="OnScreenMouseDown" MouseUp="OnScreenMouseUp"
                                       MouseWheel="OnScreenMouseWheel" KeyDown="OnScreenKeyDown" KeyUp="OnScreenKeyUp"/>
                            </Grid>
                            <Canvas x:Name="CursorLayer" IsHitTestVisible="False">
                                <Image x:Name="RemoteCursorImage" Stretch="None" Visibility="Collapsed"/>
                            </Canvas>

                            <Border x:Name="FullscreenHud" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="0,14,18,0" Background="#D90E1118" BorderBrush="{StaticResource LineBrush}"
                                    BorderThickness="1" CornerRadius="10" Padding="12,7">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="FullscreenHudText" Text="Full Screen" Foreground="#F8FAFC" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <Button x:Name="HudUpscaleBtn" Style="{StaticResource SmallPillButton}" Margin="0,0,6,0" Click="OnHudUpscaleClick">
                                        <TextBlock x:Name="HudUpscaleText" Text="Sharp+"/>
                                    </Button>
                                    <Button Content="📋 Paste" Style="{StaticResource SmallPillButton}" Margin="0,0,6,0" Click="OnSendClipboardClick"/>
                                    <Button Content="📥 Copy" Style="{StaticResource SmallPillButton}" Margin="0,0,8,0" Click="OnGetClipboardClick"/>
                                    <Button Content="⛶ Exit (Esc)" Style="{StaticResource SmallPillButton}" Margin="0,0,8,0" Click="OnToggleFullScreenClick"/>
                                    <Button Content="⏹ Stop" Style="{StaticResource DangerButton}" Padding="10,4" FontSize="11.5" Click="OnToggleStream"/>
                                </StackPanel>
                            </Border>

                            <StackPanel x:Name="DesktopOverlay" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="🖥️  Remote Desktop Canvas" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock Text="Click 'Start Stream' above or press F11 for Full Screen. Consent prompt appears on the target PC."
                                           Foreground="{StaticResource MutedBrush}" FontSize="12.5" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DockPanel>

                <!-- ==================== 3. MONITOR & INVENTORY VIEW ==================== -->
                <DockPanel x:Name="InventoryPanel" Visibility="Collapsed">
                    <UniformGrid DockPanel.Dock="Top" Columns="4" Margin="0,0,0,14">
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="PROCESSOR" Style="{StaticResource Caption}"/>
                                <TextBlock x:Name="CpuValueText" Text="—" Style="{StaticResource ValueText}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="CpuSubText" Text="Connect to inspect" FontSize="11.5" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}" Margin="4,0,4,0">
                            <StackPanel>
                                <TextBlock Text="MEMORY" Style="{StaticResource Caption}"/>
                                <TextBlock x:Name="RamValueText" Text="—" Style="{StaticResource ValueText}"/>
                                <TextBlock x:Name="RamSubText" Text="RAM &amp; processes" FontSize="11.5" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}" Margin="4,0,4,0">
                            <StackPanel>
                                <TextBlock Text="GRAPHICS" Style="{StaticResource Caption}"/>
                                <TextBlock x:Name="GpuValueText" Text="—" Style="{StaticResource ValueText}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="GpuSubText" Text="Display adapter" FontSize="11.5" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="STORAGE" Style="{StaticResource Caption}"/>
                                <TextBlock x:Name="DiskValueText" Text="—" Style="{StaticResource ValueText}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="DiskSubText" Text="Fixed drives" FontSize="11.5" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <Button x:Name="RefreshInvBtn" DockPanel.Dock="Right" Content="↻ Refresh" Style="{StaticResource PrimaryButton}" Click="OnRefreshInventory" Padding="14,7"/>
                        <TextBlock x:Name="InventoryTimestampText" DockPanel.Dock="Right" Text="" Foreground="{StaticResource MutedBrush}" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Filter:" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox x:Name="SearchBox" Width="300" TextChanged="OnSearchChanged"/>
                        </StackPanel>
                    </DockPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.15*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="0.85*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="0">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" Padding="14,10" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right" Background="#1F38BDF8" CornerRadius="6" Padding="8,2">
                                            <TextBlock x:Name="AppsCountText" Text="0 apps" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                                        </Border>
                                        <TextBlock Text="INSTALLED APPLICATIONS" Style="{StaticResource Caption}" Margin="0"/>
                                    </DockPanel>
                                </Border>
                                <DataGrid x:Name="AppsGrid">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Application" Binding="{Binding Name}" Width="2*"/>
                                        <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="110"/>
                                        <DataGridTextColumn Header="Publisher" Binding="{Binding Publisher}" Width="1.2*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="0">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" Padding="14,10" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Button Content="✕ End Process" Style="{StaticResource SmallPillButton}" Margin="0,0,8,0" Click="OnKillSelectedProcessClick"/>
                                            <Border Background="#1F10B981" CornerRadius="6" Padding="8,2" VerticalAlignment="Center">
                                                <TextBlock x:Name="ProcsCountText" Text="0 procs" FontSize="11" FontWeight="SemiBold" Foreground="#34D399"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="RUNNING PROCESSES" Style="{StaticResource Caption}" Margin="0" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </Border>
                                <DataGrid x:Name="ProcGrid">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="68"/>
                                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                                        <DataGridTextColumn Header="RAM (MB)" Binding="{Binding MemoryMb}" Width="88"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>
                    </Grid>
                </DockPanel>

                <!-- ==================== 4. REMOTE SHELL VIEW ==================== -->
                <DockPanel x:Name="ShellPanel" Visibility="Collapsed">
                    <Border DockPanel.Dock="Top" Style="{StaticResource CardStyle}" Padding="14,10" Margin="0,0,0,12">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Clear" Style="{StaticResource SmallPillButton}" Click="OnClearShellClick"/>
                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="QUICK:" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <Button Content="whoami" Tag="whoami; hostname; $PSVersionTable.PSVersion.ToString()" Style="{StaticResource SmallPillButton}" Margin="0,0,6,0" Click="OnQuickCommandClick"/>
                                <Button Content="IP Config" Tag="Get-NetIPAddress -AddressFamily IPv4 | Select-Object InterfaceAlias, IPAddress | Format-Table -AutoSize" Style="{StaticResource SmallPillButton}" Margin="0,0,6,0" Click="OnQuickCommandClick"/>
                                <Button Content="Top CPU" Tag="Get-Process | Sort-Object CPU -Descending | Select-Object -First 10 Id, ProcessName, @{N='CPU(s)';E={[math]::Round($_.CPU,1)}}, @{N='RAM(MB)';E={[math]::Round($_.WorkingSet64/1MB,1)}} | Format-Table -AutoSize" Style="{StaticResource SmallPillButton}" Margin="0,0,6,0" Click="OnQuickCommandClick"/>
                                <Button Content="Disks" Tag="Get-PSDrive -PSProvider FileSystem | Select-Object Name, @{N='Used(GB)';E={[math]::Round($_.Used/1GB,1)}}, @{N='Free(GB)';E={[math]::Round($_.Free/1GB,1)}} | Format-Table -AutoSize" Style="{StaticResource SmallPillButton}" Margin="0,0,6,0" Click="OnQuickCommandClick"/>
                                <Button Content="Uptime" Tag="(Get-Date) - (Get-CimInstance Win32_OperatingSystem).LastBootUpTime | Select-Object Days, Hours, Minutes | Format-List" Style="{StaticResource SmallPillButton}" Click="OnQuickCommandClick"/>
                            </WrapPanel>
                        </DockPanel>
                    </Border>

                    <Border DockPanel.Dock="Bottom" Style="{StaticResource CardStyle}" Padding="10" Margin="0,12,0,0">
                        <DockPanel>
                            <Button x:Name="ShellSendBtn" DockPanel.Dock="Right" Content="Run" Width="110" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" Click="OnShellSend"/>
                            <Border DockPanel.Dock="Left" Background="#172033" CornerRadius="7" Padding="10,6" Margin="0,0,10,0">
                                <TextBlock Text="PS &gt;" FontFamily="Cascadia Mono, Consolas" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                            </Border>
                            <TextBox x:Name="ShellInputBox" FontFamily="Cascadia Mono, Consolas" FontSize="13" KeyDown="OnShellInputKeyDown"/>
                        </DockPanel>
                    </Border>

                    <Border Background="#07090F" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="14" Padding="4">
                        <TextBox x:Name="ShellOutput" IsReadOnly="True" Background="Transparent" Foreground="#E2E8F0" BorderThickness="0" Padding="14,12"
                                 FontFamily="Cascadia Mono, Consolas" FontSize="12.5" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" AcceptsReturn="True"/>
                    </Border>
                </DockPanel>

                <!-- ==================== 5. SILENT DEPLOY VIEW ==================== -->
                <DockPanel x:Name="DeployPanel" Visibility="Collapsed" AllowDrop="True" PreviewDragOver="OnDeployDragOver" Drop="OnDeployFileDrop">
                    <Border DockPanel.Dock="Top" Style="{StaticResource CardStyle}" Padding="18,16" Margin="0,0,0,14">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <Border DockPanel.Dock="Right" Background="#1F38BDF8" CornerRadius="6" Padding="10,3">
                                    <TextBlock x:Name="DeployStatusBadge" Text="Ready" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="SILENT DEPLOY &amp; SCRIPT RUNNER (.EXE / .MSI / .MSP / .PS1 / .CMD / .BAT)" Style="{StaticResource Caption}" Margin="0,0,0,3"/>
                                    <TextBlock Text="Drag &amp; drop any installer or script (.cmd / .bat / .ps1) here, or upload to run it silently over mTLS." FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                                </StackPanel>
                            </DockPanel>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Installer or Script File" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="DeployFilePathBox"/>
                                </StackPanel>
                                <Button Grid.Column="2" Content="📂 Browse…" Style="{StaticResource GhostButton}" VerticalAlignment="Bottom" Click="OnBrowseDeployFileClick"/>
                                <Button Grid.Column="4" Content="📜 Run Script…" Style="{StaticResource GhostButton}" VerticalAlignment="Bottom" ToolTip="Upload a .cmd, .bat, or .ps1 script and run it silently" Click="OnUploadAndRunScriptClick"/>
                                <StackPanel Grid.Column="6">
                                    <TextBlock Text="Silent Flags / Script Args (AUTO)" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="DeployArgsBox" Text="AUTO"/>
                                </StackPanel>
                                <Button x:Name="DeployRunBtn" Grid.Column="8" Content="🚀 Run / Install Silently" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom" Click="OnStartDeployClick"/>
                            </Grid>

                            <WrapPanel>
                                <Button Content="AUTO" Tag="AUTO" Style="{StaticResource SmallPillButton}" Margin="0,0,6,0" Click="OnDeployPresetFlagClick"/>
                                <Button Content="NSIS (/S)" Tag="/S" Style="{StaticResource SmallPillButton}" Margin="0,0,6,0" Click="OnDeployPresetFlagClick"/>
                                <Button Content="Inno (/VERYSILENT)" Tag="/VERYSILENT /SUPPRESSMSGBOXES /NORESTART /SP-" Style="{StaticResource SmallPillButton}" Margin="0,0,6,0" Click="OnDeployPresetFlagClick"/>
                                <Button Content="MSI (/qn /norestart)" Tag="/qn /norestart" Style="{StaticResource SmallPillButton}" Margin="0,0,6,0" Click="OnDeployPresetFlagClick"/>
                                <Button Content="WiX (/quiet /norestart)" Tag="/quiet /norestart" Style="{StaticResource SmallPillButton}" Click="OnDeployPresetFlagClick"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border DockPanel.Dock="Top" Style="{StaticResource CardStyle}" Padding="14,10" Margin="0,0,0,14">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Clear" Style="{StaticResource SmallPillButton}" Click="OnClearDeployLogClick"/>
                            <WrapPanel VerticalAlignment="Center">
                                <TextBlock Text="WINGET 1-CLICK:" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <Button Content="7-Zip" Tag="7zip.7zip" Style="{StaticResource SmallPillButton}" Margin="0,0,6,0" Click="OnWingetQuickInstallClick"/>
                                <Button Content="Chrome" Tag="Google.Chrome" Style="{StaticResource SmallPillButton}" Margin="0,0,6,0" Click="OnWingetQuickInstallClick"/>
                                <Button Content="Firefox" Tag="Mozilla.Firefox" Style="{StaticResource SmallPillButton}" Margin="0,0,6,0" Click="OnWingetQuickInstallClick"/>
                                <Button Content="VLC" Tag="VideoLAN.VLC" Style="{StaticResource SmallPillButton}" Margin="0,0,6,0" Click="OnWingetQuickInstallClick"/>
                                <Button Content="Notepad++" Tag="Notepad++.Notepad++" Style="{StaticResource SmallPillButton}" Margin="0,0,6,0" Click="OnWingetQuickInstallClick"/>
                                <Button Content="VS Code" Tag="Microsoft.VisualStudioCode" Style="{StaticResource SmallPillButton}" Click="OnWingetQuickInstallClick"/>
                            </WrapPanel>
                        </DockPanel>
                    </Border>

                    <Border Background="#07090F" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="14" Padding="4">
                        <TextBox x:Name="DeployOutputBox" IsReadOnly="True" Background="Transparent" Foreground="#E2E8F0" BorderThickness="0" Padding="14,12"
                                 FontFamily="Cascadia Mono, Consolas" FontSize="12.5" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" AcceptsReturn="True"/>
                    </Border>
                </DockPanel>

                <!-- ==================== 6. WINDOWS 11 SETTINGS & UPDATES VIEW ==================== -->
                <Grid x:Name="SystemPanel" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="228"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="12">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                <TextBlock Text="WINDOWS SETTINGS" Style="{StaticResource Caption}" Margin="2,0,0,6"/>
                                <TextBox x:Name="SettingsSearchBox" TextChanged="OnSettingsSearchChanged"/>
                            </StackPanel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="Win11SidebarPanel"/>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <DockPanel Grid.Column="2" LastChildFill="True">
                        <Border DockPanel.Dock="Top" Style="{StaticResource CardStyle}" Padding="16,12" Margin="0,0,0,12">
                            <DockPanel>
                                <Border x:Name="SystemAdminBadge" DockPanel.Dock="Right" Background="#24F59E0B" CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                                    <TextBlock x:Name="SystemAdminText" Text="⚠ Agent: Standard User" FontSize="11.5" FontWeight="SemiBold" Foreground="#FBBF24"/>
                                </Border>
                                <StackPanel>
                                    <TextBlock x:Name="Win11PageTitle" Text="Home" FontSize="18" FontWeight="Bold"/>
                                    <TextBlock x:Name="Win11PageSubtitle" Text="Device overview and remote settings" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Border DockPanel.Dock="Top" Style="{StaticResource CardStyle}" Padding="14,10" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.4*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock x:Name="SystemTargetLabel" Text="Target" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="SystemTargetBox"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock x:Name="SystemExtraLabel" Text="Extra" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="SystemExtraBox"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border DockPanel.Dock="Bottom" Background="#07090F" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="14" Padding="4" Height="210" Margin="0,12,0,0">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="12,8,12,6">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <TextBlock Text="Filter:" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBox x:Name="SystemFilterBox" Width="170" TextChanged="OnSystemFilterChanged"/>
                                    </StackPanel>
                                    <TextBlock x:Name="SystemMessageText" Text="Click any setting action above to execute on the remote PC." Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                                <TextBlock x:Name="SystemHeaderText" DockPanel.Dock="Top" FontFamily="Cascadia Mono, Consolas" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="12,0,12,4"/>
                                <ListBox x:Name="SystemRowsList" Background="Transparent" BorderThickness="0" FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="#E2E8F0" SelectionChanged="OnSystemRowSelected"/>
                            </DockPanel>
                        </Border>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="Win11CardsPanel"/>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>

            </Grid>
        </Grid>

        <!-- ==================== ADD / EDIT ENDPOINT SLIDE-OUT DRAWER ==================== -->
        <Grid x:Name="EndpointDrawerOverlay" Grid.RowSpan="2" Visibility="Collapsed" Background="#9904060A">
            <Border Width="380" HorizontalAlignment="Right" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0,0,0" Padding="24,22">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,18">
                        <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource SmallPillButton}" Click="OnCloseEndpointDrawerClick"/>
                        <StackPanel>
                            <TextBlock Text="ENDPOINT CONFIGURATION" Style="{StaticResource Caption}" Margin="0,0,0,2"/>
                            <TextBlock x:Name="DrawerTitleText" Text="Add or Edit Managed Endpoint" FontSize="16" FontWeight="Bold"/>
                        </StackPanel>
                    </DockPanel>

                    <StackPanel DockPanel.Dock="Bottom">
                        <Button Content="+ Save Endpoint" Style="{StaticResource PrimaryButton}" Margin="0,0,0,8" Click="OnSaveMachineClick"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Remove" Style="{StaticResource DangerButton}" Click="OnRemoveMachineClick"/>
                            <Button Grid.Column="2" Content="Cancel" Style="{StaticResource GhostButton}" Click="OnCloseEndpointDrawerClick"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="DISPLAY NAME" Style="{StaticResource Caption}"/>
                        <TextBox x:Name="NameBox" Text="Living Room PC" Margin="0,0,0,16"/>

                        <TextBlock Text="HOST / LAN IP" Style="{StaticResource Caption}"/>
                        <TextBox x:Name="HostBox" Text="localhost" Margin="0,0,0,16"/>

                        <TextBlock Text="PORT (DEFAULT 7443)" Style="{StaticResource Caption}"/>
                        <TextBox x:Name="PortBox" Text="7443" Margin="0,0,0,16"/>

                        <Border Background="#0A0E18" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="14,12">
                            <TextBlock Text="Endpoints authenticate automatically using your Home RMS Mutual-TLS PKI certificate." FontSize="11.5" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
        <!-- ==================== ABOUT MODAL ==================== -->
        <Grid x:Name="AboutOverlay" Grid.RowSpan="2" Visibility="Collapsed" Background="#AA04060A">
            <Border Style="{StaticResource CardStyle}" Width="430" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="26,24">
                <StackPanel>
                    <DockPanel Margin="0,0,0,14">
                        <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource SmallPillButton}" Click="OnCloseAboutClick"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="Assets/controller.png" Width="34" Height="34" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <StackPanel>
                                <TextBlock Text="Home RMS Controller" FontSize="16" FontWeight="Bold"/>
                                <TextBlock Text="Operations Platform (mTLS / HTTP2)" FontSize="11.5" Foreground="{StaticResource MutedBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>

                    <Border Background="#0A0E18" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,14">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock DockPanel.Dock="Right" x:Name="AboutVersionText" Text="v1.5.2" FontFamily="Cascadia Mono, Consolas" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                <TextBlock Text="Version" Foreground="{StaticResource MutedBrush}"/>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock DockPanel.Dock="Right" Text=".NET 11.0 (WPF Self-Contained)" FontSize="12"/>
                                <TextBlock Text="Runtime" Foreground="{StaticResource MutedBrush}"/>
                            </DockPanel>
                            <TextBlock Text="Unique Controller Signature (SHA-256):" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,2"/>
                            <TextBox x:Name="AboutFingerprintBox" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" FontSize="10.5" Padding="8,5"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Project Repository (GitHub):" FontSize="11.5" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
                    <TextBlock Margin="0,0,0,14">
                        <Hyperlink NavigateUri="https://github.com/dor2500/home-rms" RequestNavigate="OnOpenProjectLinkClick" Foreground="#38BDF8">
                            https://github.com/dor2500/home-rms
                        </Hyperlink>
                    </TextBlock>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="📋 Copy --pin Command for Agent" Style="{StaticResource GhostButton}" Click="OnCopyPinCommandClick"/>
                        <Button Grid.Column="2" Content="Close" Style="{StaticResource PrimaryButton}" Click="OnCloseAboutClick"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
