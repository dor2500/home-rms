<Window x:Class="HomeRms.Controller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Home RMS — Remote Management Console" Height="820" Width="1320"
        MinHeight="680" MinWidth="1040"
        Icon="Assets/controller.ico"
        PreviewKeyDown="OnWindowPreviewKeyDown"
        WindowStartupLocation="CenterScreen">

    <Grid Background="{StaticResource BgBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="325"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ==================== LEFT SIDEBAR: COMPUTERS ==================== -->
        <Border x:Name="SidebarBorder" Grid.Column="0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True" Margin="18">

                <!-- Brand Header -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,2,0,20">
                    <Image Source="Assets/controller.png" Width="44" Height="44" Margin="0,0,12,0"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Home RMS" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="Consent-Based LAN Console" FontSize="11.5" Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Add / Edit Endpoint Card (Docked Bottom) -->
                <Border DockPanel.Dock="Bottom" Style="{StaticResource CardStyle}" Padding="14" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="ADD / EDIT ENDPOINT" Style="{StaticResource Caption}" Margin="0,0,0,10"/>

                        <TextBlock Text="Display Name" FontSize="11.5" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="NameBox" Text="Living Room PC" Margin="0,0,0,8"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="82"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Host / LAN IP" FontSize="11.5" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
                                <TextBox x:Name="HostBox" Text="localhost"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Port" FontSize="11.5" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
                                <TextBox x:Name="PortBox" Text="7443"/>
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Save Endpoint" Style="{StaticResource GhostButton}"
                                    Click="OnSaveMachineClick" Padding="10,7"/>
                            <Button Grid.Column="2" Content="Remove" Style="{StaticResource GhostButton}"
                                    Click="OnRemoveMachineClick" Padding="12,7"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Computers Section Header -->
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <Button x:Name="ProbeBtn" DockPanel.Dock="Right" Content="↻ Check Status"
                            Style="{StaticResource SmallPillButton}" Click="OnProbeMachinesClick"/>
                    <TextBlock Text="HOME COMPUTERS" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0"/>
                </DockPanel>

                <!-- Computers List -->
                <ListBox x:Name="MachinesList" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ItemContainerStyle="{StaticResource MachineItem}"
                         SelectionChanged="OnMachineSelectionChanged"
                         MouseDoubleClick="OnMachineDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Ellipse Grid.Column="0" Width="10" Height="10" Fill="{Binding DotBrush}"
                                         VerticalAlignment="Center" Margin="2,0,12,0"/>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" FontSize="13.5"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Subtitle}" FontSize="11.5"
                                               Foreground="{StaticResource MutedBrush}"
                                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                </StackPanel>

                                <Border Grid.Column="2" Background="{Binding BadgeBackground}" CornerRadius="6"
                                        Padding="8,3" VerticalAlignment="Center" Margin="6,0,0,0">
                                    <TextBlock Text="{Binding StatusLabel}" FontSize="10.5" FontWeight="SemiBold"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

            </DockPanel>
        </Border>

        <!-- ==================== RIGHT WORKSPACE ==================== -->
        <DockPanel Grid.Column="1" LastChildFill="True">

            <!-- Top Machine Connection Bar -->
            <Border x:Name="TopBarBorder" DockPanel.Dock="Top" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="24,16">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#1A2232" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="12,7" Margin="0,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="🔒 Mutual TLS (Zero-Prompt PKI)" FontSize="11.5"
                                       Foreground="{StaticResource MutedBrush}"/>
                        </Border>
                        <Button x:Name="ConnectBtn" Content="Connect" Width="136"
                                Style="{StaticResource PrimaryButton}" Click="OnConnectClick"/>
                    </StackPanel>

                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock x:Name="TargetTitleText" Text="Select or connect to a computer"
                                       FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Border x:Name="ConnBadgeBorder" Background="#256B7280" CornerRadius="6"
                                    Padding="9,3" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="ConnBadgeText" Text="Disconnected" FontSize="11"
                                           FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="StatusText"
                                   Text="Choose an endpoint on the left or enter a host/IP and click Connect."
                                   FontSize="12.5" Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Navigation Tabs Bar -->
            <Border x:Name="NavBarBorder" DockPanel.Dock="Top" Background="{StaticResource BgBrush}"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="24,12">
                <DockPanel>
                    <TextBlock x:Name="SessionHintText" DockPanel.Dock="Right"
                               Text="All actions are logged on the remote agent"
                               FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="NavInventory" Content="📊  System Inventory"
                                     Style="{StaticResource NavTab}" IsChecked="True"
                                     Checked="OnNavTabChanged"/>
                        <RadioButton x:Name="NavDesktop" Content="🖥️  Remote Desktop"
                                     Style="{StaticResource NavTab}"
                                     Checked="OnNavTabChanged"/>
                        <RadioButton x:Name="NavShell" Content="⌨️  Remote PowerShell"
                                     Style="{StaticResource NavTab}"
                                     Checked="OnNavTabChanged"/>
                        <RadioButton x:Name="NavDeploy" Content="📦  Silent Software Deploy"
                                     Style="{StaticResource NavTab}"
                                     Checked="OnNavTabChanged"/>
                        <RadioButton x:Name="NavSystem" Content="⚙️  System Control"
                                     Style="{StaticResource NavTab}"
                                     Checked="OnNavTabChanged"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Workspace Body -->
            <Grid x:Name="WorkspaceGrid" Margin="24,18,24,22">

                <!-- ==================== 1. SYSTEM INVENTORY VIEW ==================== -->
                <DockPanel x:Name="InventoryPanel" Visibility="Visible">

                    <!-- Hardware Summary Stat Cards -->
                    <UniformGrid DockPanel.Dock="Top" Columns="4" Margin="0,0,0,16">
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="PROCESSOR (CPU)" Style="{StaticResource Caption}"/>
                                <TextBlock x:Name="CpuValueText" Text="—" Style="{StaticResource ValueText}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="CpuSubText" Text="Connect to inspect CPU" FontSize="11.5"
                                           Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Margin="5,0,5,0">
                            <StackPanel>
                                <TextBlock Text="SYSTEM MEMORY (RAM)" Style="{StaticResource Caption}"/>
                                <TextBlock x:Name="RamValueText" Text="—" Style="{StaticResource ValueText}"/>
                                <TextBlock x:Name="RamSubText" Text="Physical memory &amp; processes" FontSize="11.5"
                                           Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Margin="5,0,5,0">
                            <StackPanel>
                                <TextBlock Text="GRAPHICS &amp; DISPLAY" Style="{StaticResource Caption}"/>
                                <TextBlock x:Name="GpuValueText" Text="—" Style="{StaticResource ValueText}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="GpuSubText" Text="Primary monitor resolution" FontSize="11.5"
                                           Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Margin="10,0,0,0">
                            <StackPanel>
                                <TextBlock Text="STORAGE VOLUMES" Style="{StaticResource Caption}"/>
                                <TextBlock x:Name="DiskValueText" Text="—" Style="{StaticResource ValueText}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="DiskSubText" Text="Free / total capacity" FontSize="11.5"
                                           Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Filter & Refresh Toolbar -->
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                        <Button x:Name="RefreshInvBtn" DockPanel.Dock="Right" Content="↻  Refresh Inventory"
                                Style="{StaticResource PrimaryButton}" Click="OnRefreshInventory" Padding="16,8"/>
                        <TextBlock x:Name="InventoryTimestampText" DockPanel.Dock="Right"
                                   Text="" Foreground="{StaticResource MutedBrush}" FontSize="12"
                                   VerticalAlignment="Center" Margin="0,0,16,0"/>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Filter apps &amp; processes:" Foreground="{StaticResource MutedBrush}"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox x:Name="SearchBox" Width="280" TextChanged="OnSearchChanged"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- DataGrids Split View -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.15*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="0.85*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Installed Apps Card -->
                        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="0">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" Padding="16,12" BorderBrush="{StaticResource LineBrush}"
                                        BorderThickness="0,0,0,1">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right" Background="#243B82F6" CornerRadius="6" Padding="8,2">
                                            <TextBlock x:Name="AppsCountText" Text="0 apps" FontSize="11"
                                                       FontWeight="SemiBold" Foreground="#93C5FD"/>
                                        </Border>
                                        <TextBlock Text="INSTALLED APPLICATIONS (REGISTRY)" Style="{StaticResource Caption}" Margin="0"/>
                                    </DockPanel>
                                </Border>
                                <DataGrid x:Name="AppsGrid">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Application Name" Binding="{Binding Name}" Width="2*"/>
                                        <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="110"/>
                                        <DataGridTextColumn Header="Publisher" Binding="{Binding Publisher}" Width="1.2*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>

                        <!-- Running Processes Card -->
                        <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="0">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" Padding="16,12" BorderBrush="{StaticResource LineBrush}"
                                        BorderThickness="0,0,0,1">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="✕ End Process" Style="{StaticResource SmallPillButton}"
                                                    Margin="0,0,8,0" Click="OnKillSelectedProcessClick"/>
                                            <Border Background="#2422C55E" CornerRadius="6" Padding="8,2" VerticalAlignment="Center">
                                                <TextBlock x:Name="ProcsCountText" Text="0 processes" FontSize="11"
                                                           FontWeight="SemiBold" Foreground="#86EFAC"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="RUNNING PROCESSES" Style="{StaticResource Caption}" Margin="0" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </Border>
                                <DataGrid x:Name="ProcGrid">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="72"/>
                                        <DataGridTextColumn Header="Process Name" Binding="{Binding Name}" Width="*"/>
                                        <DataGridTextColumn Header="RAM (MB)" Binding="{Binding MemoryMb}" Width="95"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>
                    </Grid>
                </DockPanel>

                <!-- ==================== 2. REMOTE DESKTOP VIEW ==================== -->
                <DockPanel x:Name="DesktopPanel" Visibility="Collapsed">

                    <!-- Remote Desktop Toolbar Card -->
                    <Border x:Name="DesktopToolbarBorder" DockPanel.Dock="Top" Style="{StaticResource CardStyle}" Padding="16,12" Margin="0,0,0,14">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="📋 Paste to Remote" Style="{StaticResource SmallPillButton}"
                                        ToolTip="Send your local clipboard text to the remote PC (and paste if control is active)"
                                        Margin="0,0,8,0" Click="OnSendClipboardClick"/>
                                <Button Content="📥 Copy from Remote" Style="{StaticResource SmallPillButton}"
                                        ToolTip="Pull the remote PC's clipboard text into your local clipboard"
                                        Margin="0,0,10,0" Click="OnGetClipboardClick"/>
                                <Border Background="#141822" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                        CornerRadius="7" Padding="10,6" Margin="0,0,10,0">
                                    <TextBlock x:Name="StreamStatus" Text="Idle — not streaming"
                                               FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                                </Border>
                                <Button x:Name="FullScreenBtn" Content="⛶  Full Screen (F11)"
                                        Style="{StaticResource GhostButton}" Padding="12,7" Click="OnToggleFullScreenClick"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="StreamBtn" Content="▶  Start Viewing" Width="142"
                                        Style="{StaticResource PrimaryButton}" Click="OnToggleStream"/>

                                <CheckBox x:Name="ControlCheck" Content="Control + Auto Copy/Paste"
                                          Margin="16,0,0,0" Checked="OnControlCheckChanged"
                                          Unchecked="OnControlCheckChanged"/>

                                <Border Width="1" Height="22" Background="{StaticResource LineBrush}" Margin="16,0"/>

                                <TextBlock Text="FPS:" Foreground="{StaticResource MutedBrush}"
                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox x:Name="FpsBox" Text="20" Width="40" Margin="0,0,10,0"/>

                                <TextBlock Text="Quality:" Foreground="{StaticResource MutedBrush}"
                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox x:Name="QualityBox" Text="65" Width="40" Margin="0,0,10,0"/>

                                <TextBlock Text="Res:" Foreground="{StaticResource MutedBrush}"
                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox x:Name="ScaleBox" Width="118" SelectedIndex="0"
                                          Background="#11141C" Foreground="#F3F4F6" BorderBrush="#282F40">
                                    <ComboBoxItem Content="1080p (Fast)" Tag="1920"/>
                                    <ComboBoxItem Content="720p (Ultra)" Tag="1280"/>
                                    <ComboBoxItem Content="Native (Full)" Tag="0"/>
                                </ComboBox>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Screen Canvas -->
                    <Border x:Name="ScreenCanvasBorder" Background="#07090D" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                            CornerRadius="12" ClipToBounds="True">
                        <Grid>
                            <Image x:Name="ScreenImage" Stretch="Uniform" Focusable="True"
                                   MouseMove="OnScreenMouseMove" MouseDown="OnScreenMouseDown" MouseUp="OnScreenMouseUp"
                                   MouseWheel="OnScreenMouseWheel" KeyDown="OnScreenKeyDown" KeyUp="OnScreenKeyUp"/>

                            <!-- Floating HUD in Full Screen Mode -->
                            <Border x:Name="FullscreenHud" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="0,14,18,0" Background="#CC151922" BorderBrush="{StaticResource LineBrush}"
                                    BorderThickness="1" CornerRadius="10" Padding="12,7">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="FullscreenHudText" Text="Full Screen Remote Control" Foreground="#E2E8F0"
                                               FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <Button Content="📋 Paste" Style="{StaticResource SmallPillButton}"
                                            Margin="0,0,6,0" Click="OnSendClipboardClick"/>
                                    <Button Content="📥 Copy" Style="{StaticResource SmallPillButton}"
                                            Margin="0,0,8,0" Click="OnGetClipboardClick"/>
                                    <Button Content="⛶  Exit Full Screen (Esc)" Style="{StaticResource SmallPillButton}"
                                            Margin="0,0,8,0" Click="OnToggleFullScreenClick"/>
                                    <Button Content="⏹  Stop Stream" Style="{StaticResource DangerButton}"
                                            Padding="10,4" FontSize="11.5" Click="OnToggleStream"/>
                                </StackPanel>
                            </Border>

                            <!-- Empty state overlay when not streaming -->
                            <StackPanel x:Name="DesktopOverlay" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="64" Height="64" CornerRadius="16" Background="#151A24"
                                        BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                        HorizontalAlignment="Center" Margin="0,0,0,14">
                                    <TextBlock Text="🖥️" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Remote Desktop Stream Ready" FontSize="16" FontWeight="SemiBold"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Click 'Start Viewing' above (or press F11 for Full Screen). The remote computer will show an on-screen Allow/Deny consent prompt."
                                           Foreground="{StaticResource MutedBrush}" FontSize="12.5"
                                           HorizontalAlignment="Center" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DockPanel>

                <!-- ==================== 3. REMOTE SHELL VIEW ==================== -->
                <DockPanel x:Name="ShellPanel" Visibility="Collapsed">

                    <!-- Quick Commands Toolbar -->
                    <Border DockPanel.Dock="Top" Style="{StaticResource CardStyle}" Padding="14,10" Margin="0,0,0,12">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Clear Console" Style="{StaticResource SmallPillButton}"
                                    Click="OnClearShellClick"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="QUICK COMMANDS:" Style="{StaticResource Caption}"
                                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <Button Content="whoami &amp; hostname" Tag="whoami; hostname; $PSVersionTable.PSVersion.ToString()"
                                        Style="{StaticResource SmallPillButton}" Margin="0,0,8,0" Click="OnQuickCommandClick"/>
                                <Button Content="IP Configuration" Tag="Get-NetIPAddress -AddressFamily IPv4 | Select-Object InterfaceAlias, IPAddress | Format-Table -AutoSize"
                                        Style="{StaticResource SmallPillButton}" Margin="0,0,8,0" Click="OnQuickCommandClick"/>
                                <Button Content="Top CPU Processes" Tag="Get-Process | Sort-Object CPU -Descending | Select-Object -First 10 Id, ProcessName, @{N='CPU(s)';E={[math]::Round($_.CPU,1)}}, @{N='RAM(MB)';E={[math]::Round($_.WorkingSet64/1MB,1)}} | Format-Table -AutoSize"
                                        Style="{StaticResource SmallPillButton}" Margin="0,0,8,0" Click="OnQuickCommandClick"/>
                                <Button Content="Disk Volumes" Tag="Get-PSDrive -PSProvider FileSystem | Select-Object Name, @{N='Used(GB)';E={[math]::Round($_.Used/1GB,1)}}, @{N='Free(GB)';E={[math]::Round($_.Free/1GB,1)}} | Format-Table -AutoSize"
                                        Style="{StaticResource SmallPillButton}" Margin="0,0,8,0" Click="OnQuickCommandClick"/>
                                <Button Content="Uptime" Tag="(Get-Date) - (Get-CimInstance Win32_OperatingSystem).LastBootUpTime | Select-Object Days, Hours, Minutes | Format-List"
                                        Style="{StaticResource SmallPillButton}" Click="OnQuickCommandClick"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Command Input Bar (Docked Bottom) -->
                    <Border DockPanel.Dock="Bottom" Style="{StaticResource CardStyle}" Padding="10" Margin="0,12,0,0">
                        <DockPanel>
                            <Button x:Name="ShellSendBtn" DockPanel.Dock="Right" Content="Run Command"
                                    Width="130" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0"
                                    Click="OnShellSend"/>
                            <Border DockPanel.Dock="Left" Background="#1E293B" CornerRadius="6" Padding="10,6" Margin="0,0,10,0">
                                <TextBlock Text="PS &gt;" FontFamily="Cascadia Mono, Consolas" FontWeight="Bold"
                                           Foreground="#60A5FA" VerticalAlignment="Center"/>
                            </Border>
                            <TextBox x:Name="ShellInputBox" FontFamily="Cascadia Mono, Consolas" FontSize="13"
                                     KeyDown="OnShellInputKeyDown"/>
                        </DockPanel>
                    </Border>

                    <!-- Terminal Output -->
                    <Border Background="#090C12" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                            CornerRadius="12" Padding="4">
                        <TextBox x:Name="ShellOutput" IsReadOnly="True" Background="Transparent"
                                 Foreground="#E2E8F0" BorderThickness="0" Padding="14,12"
                                 FontFamily="Cascadia Mono, Consolas" FontSize="12.5"
                                 VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" AcceptsReturn="True"/>
                    </Border>
                </DockPanel>

                <!-- ==================== 4. SILENT SOFTWARE DEPLOYMENT VIEW ==================== -->
                <DockPanel x:Name="DeployPanel" Visibility="Collapsed" AllowDrop="True"
                           PreviewDragOver="OnDeployDragOver" Drop="OnDeployFileDrop">

                    <!-- Upload Installer Card (.exe / .msi / .ps1) -->
                    <Border DockPanel.Dock="Top" Style="{StaticResource CardStyle}" Padding="18,16" Margin="0,0,0,14">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <Border DockPanel.Dock="Right" Background="#243B82F6" CornerRadius="6" Padding="10,3">
                                    <TextBlock x:Name="DeployStatusBadge" Text="Ready to Deploy" FontSize="11.5"
                                               FontWeight="SemiBold" Foreground="#93C5FD"/>
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="UPLOAD &amp; SILENTLY INSTALL PACKAGE (.EXE / .MSI / .MSP / .PS1)" Style="{StaticResource Caption}" Margin="0,0,0,3"/>
                                    <TextBlock Text="Streams your local installer file over Mutual TLS to the remote computer and executes it in hidden/silent mode (or drag &amp; drop a file here)."
                                               FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                                </StackPanel>
                            </DockPanel>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Local Installer File (.exe, .msi, .msp, .ps1)" FontSize="11.5" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="DeployFilePathBox" Text="" ToolTip="Select or drop a local .exe / .msi installer file"/>
                                </StackPanel>

                                <Button Grid.Column="2" Content="📂  Browse File…" Style="{StaticResource GhostButton}"
                                        VerticalAlignment="Bottom" Padding="14,8" Click="OnBrowseDeployFileClick"/>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Silent Flags (AUTO detects NSIS / Inno / MSI / Burn, or enter custom)" FontSize="11.5" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="DeployArgsBox" Text="AUTO"/>
                                </StackPanel>

                                <Button x:Name="DeployRunBtn" Grid.Column="6" Content="🚀  Upload &amp; Install Silently"
                                        Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom"
                                        Padding="18,8" Click="OnStartDeployClick"/>
                            </Grid>

                            <!-- Preset Flag Pills -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="FLAG PRESETS:" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <Button Content="Smart Auto-Detect (AUTO)" Tag="AUTO" Style="{StaticResource SmallPillButton}" Margin="0,0,8,0" Click="OnDeployPresetFlagClick"/>
                                <Button Content="NSIS / Standard (/S)" Tag="/S" Style="{StaticResource SmallPillButton}" Margin="0,0,8,0" Click="OnDeployPresetFlagClick"/>
                                <Button Content="Inno Setup (/VERYSILENT /NORESTART)" Tag="/VERYSILENT /SUPPRESSMSGBOXES /NORESTART /SP-" Style="{StaticResource SmallPillButton}" Margin="0,0,8,0" Click="OnDeployPresetFlagClick"/>
                                <Button Content="MSI Quiet (/qn /norestart)" Tag="/qn /norestart" Style="{StaticResource SmallPillButton}" Margin="0,0,8,0" Click="OnDeployPresetFlagClick"/>
                                <Button Content="Burn / WiX (/quiet /norestart)" Tag="/quiet /norestart" Style="{StaticResource SmallPillButton}" Click="OnDeployPresetFlagClick"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Quick One-Click Winget Silent Installer Card -->
                    <Border DockPanel.Dock="Top" Style="{StaticResource CardStyle}" Padding="14,10" Margin="0,0,0,14">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Clear Log" Style="{StaticResource SmallPillButton}"
                                    Click="OnClearDeployLogClick"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="ONE-CLICK WINGET SILENT INSTALL:" Style="{StaticResource Caption}"
                                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <Button Content="7-Zip" Tag="7zip.7zip" Style="{StaticResource SmallPillButton}" Margin="0,0,8,0" Click="OnWingetQuickInstallClick"/>
                                <Button Content="Google Chrome" Tag="Google.Chrome" Style="{StaticResource SmallPillButton}" Margin="0,0,8,0" Click="OnWingetQuickInstallClick"/>
                                <Button Content="Mozilla Firefox" Tag="Mozilla.Firefox" Style="{StaticResource SmallPillButton}" Margin="0,0,8,0" Click="OnWingetQuickInstallClick"/>
                                <Button Content="VLC Media Player" Tag="VideoLAN.VLC" Style="{StaticResource SmallPillButton}" Margin="0,0,8,0" Click="OnWingetQuickInstallClick"/>
                                <Button Content="Notepad++" Tag="Notepad++.Notepad++" Style="{StaticResource SmallPillButton}" Margin="0,0,8,0" Click="OnWingetQuickInstallClick"/>
                                <Button Content="VS Code" Tag="Microsoft.VisualStudioCode" Style="{StaticResource SmallPillButton}" Click="OnWingetQuickInstallClick"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Deployment Progress & Output Console -->
                    <Border Background="#090C12" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                            CornerRadius="12" Padding="4">
                        <TextBox x:Name="DeployOutputBox" IsReadOnly="True" Background="Transparent"
                                 Foreground="#E2E8F0" BorderThickness="0" Padding="14,12"
                                 FontFamily="Cascadia Mono, Consolas" FontSize="12.5"
                                 VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" AcceptsReturn="True"/>
                    </Border>
                </DockPanel>

                <!-- ==================== 5. SYSTEM CONTROL VIEW ==================== -->
                <DockPanel x:Name="SystemPanel" Visibility="Collapsed">

                    <Border DockPanel.Dock="Top" Style="{StaticResource CardStyle}" Padding="16,12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="SYSTEM CONTROL — WINDOWS UPDATE, SERVICES, POWER, REGISTRY &amp; SETTINGS" Style="{StaticResource Caption}" Margin="0,0,0,8"/>
                            <WrapPanel x:Name="SystemAreaPanel" Margin="0,0,0,10"/>
                            <WrapPanel x:Name="SystemActionPanel" Margin="0,0,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.4*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock x:Name="SystemTargetLabel" Text="Target" FontSize="11.5" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="SystemTargetBox"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock x:Name="SystemExtraLabel" Text="Extra argument" FontSize="11.5" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="SystemExtraBox"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <TextBlock Text="Filter:" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="SystemFilterBox" Width="220" TextChanged="OnSystemFilterChanged"/>
                        </StackPanel>
                        <TextBlock x:Name="SystemMessageText" Text="Pick an area and an action. Changes need the agent to run as Administrator (HomeRmsAgent.exe --elevate)."
                                   Foreground="{StaticResource MutedBrush}" FontSize="12.5" VerticalAlignment="Center"
                                   TextWrapping="Wrap" Margin="0,0,12,0"/>
                    </DockPanel>

                    <Border Background="#090C12" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="4">
                        <DockPanel>
                            <TextBlock x:Name="SystemHeaderText" DockPanel.Dock="Top" FontFamily="Cascadia Mono, Consolas" FontSize="12.5"
                                       FontWeight="Bold" Foreground="#93C5FD" Margin="14,10,14,6"/>
                            <ListBox x:Name="SystemRowsList" Background="Transparent" BorderThickness="0"
                                     FontFamily="Cascadia Mono, Consolas" FontSize="12.5" Foreground="#E2E8F0"
                                     SelectionChanged="OnSystemRowSelected"/>
                        </DockPanel>
                    </Border>
                </DockPanel>

            </Grid>
        </DockPanel>
    </Grid>
</Window>
