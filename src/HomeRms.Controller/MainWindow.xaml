                                                </StackPanel>
                                            </DockPanel>
                                            <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Height="30" TextTrimming="CharacterEllipsis" Margin="0,0,0,8"/>
                                            <DockPanel>
                                                <Border DockPanel.Dock="Right" Background="#163B82F6" CornerRadius="3" Padding="6,2">
                                                    <TextBlock Text="{Binding StatusLabel}" FontFamily="{StaticResource MonoFont}" FontSize="9.5" Foreground="{StaticResource TextBrush}"/>
                                                </Border>
                                                <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center">
                                                    <Run Text="{Binding Category, Mode=OneWay}"/>
                                                    <Run Text=" · "/>
                                                    <Run Text="{Binding Version, Mode=OneWay}"/>
                                                </TextBlock>
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>

                <!-- ==================== 6. WINDOWS 11 SETTINGS & UPDATES VIEW ==================== -->
                <Grid x:Name="SystemPanel" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="216"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
