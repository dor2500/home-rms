<Window x:Class="HomeRms.Controller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Home RMS — Central Operations Console" Height="840" Width="1360"
        MinHeight="680" MinWidth="1020"
        Icon="Assets/controller.ico"
        PreviewMouseDown="OnDashboardActivity"
        PreviewKeyDown="OnWindowPreviewKeyDown"
        PreviewKeyUp="OnWindowPreviewKeyUp"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Page header: title + subtitle on the left, actions docked right -->
        <Style x:Key="PageHeader" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="LastChildFill" Value="True"/>
        </Style>
        <!-- Activity / audit row (shared by Overview + Endpoints) -->
        <DataTemplate x:Key="ActivityRowTemplate">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="{Binding Timestamp}" Style="{StaticResource MonoMeta}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Border DockPanel.Dock="Left" Background="{Binding BadgeBackground}" CornerRadius="{StaticResource RadiusPill}" Padding="7,1" Margin="0,0,10,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Category}" FontSize="10.5" FontWeight="SemiBold" Foreground="{Binding BadgeForeground}"/>
                </Border>
                <TextBlock Text="{Binding Message}" FontSize="{StaticResource FontSizeSmall}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Message}"/>
            </DockPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{StaticResource CanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ==================== HEADER ==================== -->
        <Border x:Name="TopBarBorder" Grid.Row="0" Background="{StaticResource SurfaceLayerBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="10,0,16,0" Height="52">
            <DockPanel LastChildFill="True" VerticalAlignment="Center">
                <!-- Right: status pills + global actions -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Button x:Name="MobileHubBtn" Style="{StaticResource HeaderPillButton}" Margin="0,0,6,0"
                            ToolTip="Open the Central Relay mobile web app in your browser" Click="OnOpenMobileHubClick">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="HubRelayDot" Style="{StaticResource StatusDot}" Fill="{StaticResource OkBrush}" Margin="0,0,8,0"/>
                            <TextBlock x:Name="HubRelayStatusText" Text="Hub relay :7480" FontSize="{StaticResource FontSizeSmall}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Border Background="Transparent" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                            CornerRadius="{StaticResource RadiusControl}" Height="28" Padding="10,0" Margin="0,0,6,0" VerticalAlignment="Center"
                            ToolTip="Every endpoint session uses mutual TLS (X.509 PKI)">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Style="{StaticResource VectorIcon}" Data="{StaticResource GeoShield}" Stroke="{StaticResource AccentBrush}" Width="13" Height="13" Margin="0,0,7,0"/>
                            <TextBlock Text="mTLS PKI" FontSize="{StaticResource FontSizeSmall}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Button x:Name="AlertBellBtn" Style="{StaticResource HeaderPillButton}" Margin="0,0,6,0"
                            ToolTip="Open the health &amp; alert center" Click="OnOpenAlertCenterClick">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource VectorIcon}" Data="{StaticResource GeoBell}" Width="13" Height="13" Margin="0,0,7,0"/>
                            <TextBlock Text="Alerts" FontSize="{StaticResource FontSizeSmall}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <Border x:Name="AlertBadgeBorder" Style="{StaticResource NavBadge}" Height="17" MinWidth="18">
                                <TextBlock x:Name="AlertBadgeText" Text="0" Style="{StaticResource NavBadgeText}"/>
                            </Border>
                        </StackPanel>
                    </Button>

                    <Border Style="{StaticResource VDivider}"/>

                    <Button x:Name="ProbeBtn" Style="{StaticResource HeaderPillButton}" Margin="0,0,6,0"
                            ToolTip="Probe every saved endpoint and discover agents on the LAN" Click="OnProbeMachinesClick">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource VectorIcon}" Data="{StaticResource GeoRadar}" Width="13" Height="13" Margin="0,0,7,0"/>
                            <TextBlock Text="Scan LAN" FontSize="{StaticResource FontSizeSmall}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="ConsoleToggleBtn" Style="{StaticResource HeaderPillButton}" Margin="0,0,6,0"
                            ToolTip="Show or hide the live console (Ctrl+`)" Click="OnToggleConsoleClick">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource VectorIcon}" Data="{StaticResource GeoConsole}" Width="13" Height="13" Margin="0,0,7,0"/>
                                <TextBlock Text="Console" FontSize="{StaticResource FontSizeSmall}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Ellipse x:Name="ConsoleUnreadDot" Width="6" Height="6" Fill="{StaticResource AccentBrush}" HorizontalAlignment="Left"
                                     VerticalAlignment="Top" Margin="9,-2,0,0" Visibility="Collapsed"/>
                        </Grid>
                    </Button>
                    <Button x:Name="UpdateBtn" Content="Updates" Style="{StaticResource HeaderPillButton}"
                            Margin="0,0,6,0" ToolTip="Check GitHub Releases (dor2500/home-rms) for updates"
                            Click="OnCheckOrApplyUpdateClick"/>
                    <Button Style="{StaticResource HeaderPillButton}" Margin="0,0,10,0" Padding="8,0"
                            ToolTip="Lock the console now (auto-locks after 15 minutes of inactivity)" Click="OnLockDashboardClick">
                        <Path Style="{StaticResource VectorIcon}" Data="{StaticResource GeoLock}" Width="13" Height="13"/>
                    </Button>
                    <Button x:Name="AddEndpointTopBtn" Style="{StaticResource PrimaryButton}" Height="30" Padding="12,0" Click="OnOpenAddEndpointDrawerClick">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource VectorIcon}" Data="{StaticResource GeoPlus}" Width="12" Height="12" Margin="0,0,6,0"/>
                            <TextBlock Text="Add endpoint" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Left: sidebar toggle, brand, connection state -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="SidebarToggleBtn" Style="{StaticResource SubtleButton}"
                            Width="32" Height="32" Padding="0" Margin="0,0,8,0"
                            ToolTip="Collapse or expand the sidebar" Click="OnToggleSidebarClick">
                        <Path Style="{StaticResource VectorIcon}" Data="{StaticResource GeoSidebar}" Width="15" Height="15"/>
                    </Button>
                    <Border Width="24" Height="24" CornerRadius="6" Background="{StaticResource AccentStrongBrush}" Margin="0,0,10,0">
                        <Path Data="{StaticResource GeoHub}" Stroke="{StaticResource TextOnAccentBrush}" StrokeThickness="1.8" StrokeLineJoin="Round"
                              Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Home RMS" FontFamily="{StaticResource DisplayFont}" FontSize="{StaticResource FontSizeSubtitle}" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Border x:Name="ConnBadgeBorder" Style="{StaticResource Pill}" Background="{StaticResource AccentSoftBrush}"
                            BorderBrush="{StaticResource AccentLineBrush}" BorderThickness="1" Margin="0,0,14,0">
                        <TextBlock x:Name="ConnBadgeText" Text="Standby" Style="{StaticResource PillText}" Foreground="{StaticResource AccentBrush}"/>
                    </Border>
                    <Border Style="{StaticResource VDivider}" Margin="0,0,14,0"/>
                </StackPanel>

                <!-- Centre: current target + status line -->
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TargetTitleText" Text="Central Operations Hub" FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="StatusText" Text="Central Relay ready. Scan LAN or select an endpoint in Fleet to open a tunnel."
                               FontSize="{StaticResource FontSizeCaption}" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ==================== BODY: SIDEBAR + WORKSPACE + LIVE CONSOLE ==================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="RailColumn" Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar (width animates 192 <-> 52) -->
            <Border x:Name="RailBorder" Grid.Column="0" Width="192" Background="{StaticResource SurfaceLayerBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,1,0" ClipToBounds="True">
                <DockPanel>
                    <!-- Admin + relay footer -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,10">
                        <Grid Height="30">
                            <TextBlock x:Name="NavGroupAdmin" Text="Admin" Style="{StaticResource NavGroupHeader}" Margin="18,10,0,4"/>
                            <Border x:Name="NavSepAdmin" Height="1" Margin="14,0" Background="{StaticResource BorderSubtleBrush}" VerticalAlignment="Center" Visibility="Collapsed"/>
                        </Grid>
                        <Button Style="{StaticResource RailButton}" ToolTip="Server identity, PKI &amp; console 2FA" Click="OnOpenAboutClick">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Style="{StaticResource VectorIcon}" Data="{StaticResource GeoInfo}"/>
                                <TextBlock x:Name="NavLabelAbout" Text="Server &amp; PKI" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Border x:Name="SidebarFooterBorder" Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1" CornerRadius="{StaticResource RadiusControl}" Padding="10,7" Margin="8,8,8,0"
                                ToolTip="Central hub relay status">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Style="{StaticResource StatusDot}" Fill="{StaticResource OkBrush}" Margin="1,0,9,0"/>
                                <TextBlock x:Name="SidebarFooterText" Text="Hub relay online" FontSize="{StaticResource FontSizeCaption}" Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,4,0,8">
                            <!-- Monitor -->
                            <Grid Height="30">
                                <TextBlock x:Name="SidebarSectionLabel" Text="Monitor" Style="{StaticResource NavGroupHeader}" Margin="18,10,0,4"/>
                                <Border x:Name="NavSepMonitor" Height="1" Margin="14,0" Background="{StaticResource BorderSubtleBrush}" VerticalAlignment="Center" Visibility="Collapsed"/>
                            </Grid>
                            <RadioButton x:Name="NavOverview" Style="{StaticResource RailTab}" IsChecked="True" Checked="OnNavTabChanged" ToolTip="Overview">
                                <DockPanel>
                                    <Border x:Name="NavBadgeOverview" DockPanel.Dock="Right" Style="{StaticResource NavBadge}" Visibility="Collapsed"
                                            ToolTip="Unacknowledged alerts">
                                        <TextBlock x:Name="NavBadgeOverviewText" Text="0" Style="{StaticResource NavBadgeText}"/>
                                    </Border>
                                    <Path Style="{StaticResource VectorIcon}" Data="{StaticResource GeoOverview}"/>
                                    <TextBlock x:Name="NavLabelOverview" Text="Overview" Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavFleet" Style="{StaticResource RailTab}" Checked="OnNavTabChanged" ToolTip="Endpoints">
                                <DockPanel>
                                    <Border x:Name="NavBadgeFleet" DockPanel.Dock="Right" Style="{StaticResource NavBadge}" Visibility="Collapsed"
                                            ToolTip="Endpoints online / saved">
                                        <TextBlock x:Name="NavBadgeFleetText" Text="0" Style="{StaticResource NavBadgeText}"/>
                                    </Border>
                                    <Path Style="{StaticResource VectorIcon}" Data="{StaticResource GeoFleet}"/>
                                    <TextBlock x:Name="NavLabelFleet" Text="Endpoints" Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavInventory" Style="{StaticResource RailTab}" Checked="OnNavTabChanged" ToolTip="Inventory &amp; processes">
                                <DockPanel>
                                    <Path Style="{StaticResource VectorIcon}" Data="{StaticResource GeoMonitor}"/>
                                    <TextBlock x:Name="NavLabelMonitor" Text="Inventory &amp; procs" Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </RadioButton>

                            <!-- Manage -->
                            <Grid Height="30">
                                <TextBlock x:Name="NavGroupManage" Text="Manage" Style="{StaticResource NavGroupHeader}" Margin="18,10,0,4"/>
                                <Border x:Name="NavSepManage" Height="1" Margin="14,0" Background="{StaticResource BorderSubtleBrush}" VerticalAlignment="Center" Visibility="Collapsed"/>
                            </Grid>
                            <RadioButton x:Name="NavDesktop" Style="{StaticResource RailTab}" Checked="OnNavTabChanged" ToolTip="Remote desktop">
                                <DockPanel>
                                    <Path Style="{StaticResource VectorIcon}" Data="{StaticResource GeoDesktop}"/>
                                    <TextBlock x:Name="NavLabelDesktop" Text="Remote desktop" Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavShell" Style="{StaticResource RailTab}" Checked="OnNavTabChanged" ToolTip="Remote PowerShell">
                                <DockPanel>
                                    <Path Style="{StaticResource VectorIcon}" Data="{StaticResource GeoShell}"/>
                                    <TextBlock x:Name="NavLabelShell" Text="PowerShell" Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavFiles" Style="{StaticResource RailTab}" Checked="OnNavTabChanged" ToolTip="Remote file manager">
                                <DockPanel>
                                    <Path Style="{StaticResource VectorIcon}" Data="{StaticResource GeoFolder}"/>
                                    <TextBlock x:Name="NavLabelFiles" Text="Files" Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavServices" Style="{StaticResource RailTab}" Checked="OnNavTabChanged" ToolTip="Services &amp; scheduled tasks">
                                <DockPanel>
                                    <Path Style="{StaticResource VectorIcon}" Data="{StaticResource GeoServices}"/>
                                    <TextBlock x:Name="NavLabelServices" Text="Services &amp; tasks" Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavSystem" Style="{StaticResource RailTab}" Checked="OnNavTabChanged" ToolTip="System &amp; settings">
                                <DockPanel>
                                    <Path Style="{StaticResource VectorIcon}" Data="{StaticResource GeoSettings}"/>
                                    <TextBlock x:Name="NavLabelSettings" Text="System &amp; settings" Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavWebUi" Style="{StaticResource RailTab}" Checked="OnNavTabChanged" Visibility="Collapsed" ToolTip="Appliance web UI (reverse proxy)">
                                <DockPanel>
                                    <Path Style="{StaticResource VectorIcon}" Data="{StaticResource GeoGlobe}"/>
                                    <TextBlock x:Name="NavLabelWebUi" Text="Web UI (proxy)" Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </RadioButton>

                            <!-- Automate -->
                            <Grid Height="30">
                                <TextBlock x:Name="NavGroupAutomate" Text="Automate" Style="{StaticResource NavGroupHeader}" Margin="18,10,0,4"/>
                                <Border x:Name="NavSepAutomate" Height="1" Margin="14,0" Background="{StaticResource BorderSubtleBrush}" VerticalAlignment="Center" Visibility="Collapsed"/>
                            </Grid>
                            <RadioButton x:Name="NavDeploy" Style="{StaticResource RailTab}" Checked="OnNavTabChanged" ToolTip="Software &amp; script deploy">
                                <DockPanel>
                                    <Path Style="{StaticResource VectorIcon}" Data="{StaticResource GeoDeploy}"/>
                                    <TextBlock x:Name="NavLabelDeploy" Text="Deploy" Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavUpdates" Style="{StaticResource RailTab}" Checked="OnNavTabChanged" ToolTip="Windows Update">
                                <DockPanel>
                                    <Path Style="{StaticResource VectorIcon}" Data="{StaticResource GeoUpdates}"/>
                                    <TextBlock x:Name="NavLabelUpdates" Text="Windows Update" Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavScripts" Style="{StaticResource RailTab}" Checked="OnNavTabChanged" ToolTip="Script library &amp; multi-endpoint runs">
                                <DockPanel>
                                    <Path Style="{StaticResource VectorIcon}" Data="{StaticResource GeoScript}"/>
                                    <TextBlock x:Name="NavLabelScripts" Text="Script library" Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </RadioButton>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Workspace column: pages on top, live console drawer docked at the bottom -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="260"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition x:Name="ConsoleRow" Height="0"/>
                </Grid.RowDefinitions>

            <Grid x:Name="WorkspaceGrid" Grid.Row="0" Background="{StaticResource CanvasBrush}" Margin="24,16,24,16">

                <!-- ==================== 0. OVERVIEW ==================== -->
                <DockPanel x:Name="OverviewPanel" Visibility="Visible">
                    <DockPanel DockPanel.Dock="Top" Style="{StaticResource PageHeader}">
                        <Button DockPanel.Dock="Right" Content="View all endpoints" Style="{StaticResource GhostButton}" VerticalAlignment="Center"
                                Click="OnGoToFleetClick"/>
                        <StackPanel>
                            <TextBlock Text="Overview" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="Relay metrics, fleet health and the audit trail of the central hub" Style="{StaticResource PageSubtitle}"/>
                        </StackPanel>
                    </DockPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
                        <StackPanel>
                            <!-- KPI strip -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Endpoints online" Style="{StaticResource Caption}"/>
                                        <TextBlock x:Name="KpiOnlineCount" Text="0 / 0" Style="{StaticResource MetricText}"/>
                                        <TextBlock x:Name="KpiOfflineSub" Text="0 offline" Style="{StaticResource MetaText}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Active tunnel" Style="{StaticResource Caption}"/>
                                        <TextBlock x:Name="KpiActiveSession" Text="Standby" Style="{StaticResource MetricText}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="KpiActiveLatency" Text="No active mTLS tunnel" Style="{StaticResource MetaText}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="4" Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Fleet CPU / RAM" Style="{StaticResource Caption}"/>
                                        <TextBlock x:Name="KpiFleetLoad" Text="--% CPU  ·  --% RAM" FontFamily="{StaticResource DisplayFont}" FontSize="{StaticResource FontSizePageTitle}" FontWeight="SemiBold" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                        <ProgressBar x:Name="KpiLoadBar" Style="{StaticResource ThinProgressBar}" Value="0" Margin="0,12,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="6" Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Relay latency (RTT)" Style="{StaticResource Caption}"/>
                                        <DockPanel>
                                            <Canvas Width="96" Height="24" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8,0,0,4">
                                                <Polyline x:Name="OverviewSparkline" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.6" StrokeLineJoin="Round"
                                                          Points="0,18 20,16 40,20 60,12 80,14 100,10"/>
                                            </Canvas>
                                            <TextBlock x:Name="KpiAvgLatency" Text="-- ms" Style="{StaticResource MetricText}" VerticalAlignment="Center"/>
                                        </DockPanel>
                                        <TextBlock Text="Average across online endpoints" Style="{StaticResource MetaText}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Live telemetry tiles (Views\TelemetryOverviewView.xaml) -->
                            <ContentControl x:Name="TelemetryHost" Height="256" Margin="0,0,0,16"/>

                            <!-- Trend + audit events -->
                            <Grid Height="200" Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.15*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                                    <DockPanel>
                                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                            <TextBlock DockPanel.Dock="Right" x:Name="TrafficPeakText" Text="Peak: -- ms" Style="{StaticResource MonoMeta}" VerticalAlignment="Center"/>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                                                <Border Width="10" Height="2" CornerRadius="1" Background="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                <TextBlock Text="RTT (ms)" Style="{StaticResource MetaText}" Margin="0,0,12,0"/>
                                                <Border Width="10" Height="2" CornerRadius="1" Background="{StaticResource IndigoBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                <TextBlock Text="CPU (%)" Style="{StaticResource MetaText}"/>
                                            </StackPanel>
                                            <TextBlock Text="Relay latency &amp; utilization" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                                        </DockPanel>
                                        <Border Style="{StaticResource WellStyle}" Padding="10,8">
                                            <Viewbox Stretch="Fill">
                                                <Canvas Width="400" Height="110">
                                                    <Line X1="0" Y1="27" X2="400" Y2="27" Stroke="{StaticResource ChartGridBrush}" StrokeThickness="1" StrokeDashArray="2 4"/>
                                                    <Line X1="0" Y1="55" X2="400" Y2="55" Stroke="{StaticResource ChartGridBrush}" StrokeThickness="1" StrokeDashArray="2 4"/>
                                                    <Line X1="0" Y1="82" X2="400" Y2="82" Stroke="{StaticResource ChartGridBrush}" StrokeThickness="1" StrokeDashArray="2 4"/>
                                                    <Polyline x:Name="TrafficSparkline" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.8" StrokeLineJoin="Round"
                                                              Points="0,85 45,78 90,82 135,62 180,68 225,52 270,58 315,44 360,48 400,38"/>
                                                    <Polyline x:Name="CpuSparkline" Stroke="{StaticResource IndigoBrush}" StrokeThickness="1.5" StrokeLineJoin="Round"
                                                              Points="0,92 45,88 90,84 135,79 180,82 225,74 270,76 315,70 360,72 400,66"/>
                                                </Canvas>
                                            </Viewbox>
                                        </Border>
                                    </DockPanel>
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="16,14,10,10">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Text="Audit &amp; relay events" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                                        <ListBox x:Name="OverviewEventsList" ItemContainerStyle="{StaticResource FeedItem}"
                                                 ItemTemplate="{StaticResource ActivityRowTemplate}"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                                    </DockPanel>
                                </Border>
                            </Grid>

                            <!-- Endpoint snapshot -->
                            <Border Style="{StaticResource CardStyle}" Padding="16,14,16,8">
                                <DockPanel>
                                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                        <TextBlock DockPanel.Dock="Right" Text="All endpoint connections route through the central hub" Style="{StaticResource MetaText}" VerticalAlignment="Center"/>
                                        <TextBlock Text="Managed endpoints" Style="{StaticResource SectionTitle}"/>
                                    </DockPanel>
                                    <ListBox x:Name="OverviewFleetList" MinHeight="120" ItemContainerStyle="{StaticResource FeedItem}"
                                             HorizontalContentAlignment="Stretch"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{StaticResource RowDividerBrush}" BorderThickness="0,0,0,1" Padding="2,6">
                                                    <DockPanel>
                                                        <Button DockPanel.Dock="Right" Content="{Binding ConnectActionText}" Style="{StaticResource SmallPillButton}"
                                                                Tag="{Binding}" Click="OnCardConnectClick"/>
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding LatencyLabel}" Style="{StaticResource MonoMeta}"
                                                                   VerticalAlignment="Center" Margin="16,0" Width="64" TextAlignment="Right"/>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Ellipse Style="{StaticResource StatusDot}" Fill="{Binding DotBrush}" Margin="0,0,10,0"/>
                                                            <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" Width="220" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding Address}" FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FontSizeSmall}" Foreground="{StaticResource TextSecondaryBrush}" Width="170" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding OsTag}" FontSize="{StaticResource FontSizeSmall}" Foreground="{StaticResource TextMutedBrush}" Width="120" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>

                <!-- ==================== 1. ENDPOINTS ==================== -->
                <DockPanel x:Name="FleetPanel" Visibility="Collapsed">
                    <DockPanel DockPanel.Dock="Top" Style="{StaticResource PageHeader}">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBox x:Name="FleetFilterBox" Style="{StaticResource SearchBox}" Tag="Filter by name, IP or OS" Width="240" Margin="0,0,8,0"
                                     ToolTip="Filter endpoints by name, IP, or OS" TextChanged="OnFleetFilterChanged"/>
                            <Button Style="{StaticResource PrimaryButton}" Click="OnOpenAddEndpointDrawerClick">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource VectorIcon}" Data="{StaticResource GeoPlus}" Width="12" Height="12" Margin="0,0,6,0"/>
                                    <TextBlock Text="Add endpoint" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Endpoints" Style="{StaticResource PageTitle}"/>
                            <TextBlock x:Name="FleetSummaryText" Text="Select any endpoint card for Connect, Terminal, Wake-on-LAN, or Restart actions." Style="{StaticResource PageSubtitle}"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Broadcast command -->
                    <Border DockPanel.Dock="Top" Style="{StaticResource CardStyle}" Padding="{StaticResource CardPaddingCompact}" Margin="0,0,0,8">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Run on all online" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="OnMassRunClick"
                                    ToolTip="Run this PowerShell command on every online Windows endpoint"/>
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,12,0">
                                <Path Style="{StaticResource VectorIcon}" Data="{StaticResource GeoShell}" Stroke="{StaticResource AccentBrush}" Width="13" Height="13" Margin="0,0,8,0"/>
                                <TextBlock Text="Broadcast PowerShell" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSmall}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBox x:Name="MassCommandBox" FontFamily="{StaticResource MonoFont}" Text="hostname; (Get-CimInstance Win32_OperatingSystem).LastBootUpTime"/>
                        </DockPanel>
                    </Border>

                    <!-- Power & Wake-on-LAN for the selected endpoint(s) (Views\EndpointActionBar.xaml) -->
                    <Border DockPanel.Dock="Top" Style="{StaticResource CardStyle}" Padding="{StaticResource CardPaddingCompact}" Margin="0,0,0,16"
                            ToolTip="Acts on every selected endpoint card (Ctrl/Shift+click to select several)">
                        <ContentControl x:Name="FleetPowerHost"/>
                    </Border>

                    <!-- Audit log -->
                    <Border DockPanel.Dock="Bottom" Style="{StaticResource CardStyle}" Padding="14,10,10,8" Height="156" Margin="0,8,0,0">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                <Button DockPanel.Dock="Right" Content="Clear" Style="{StaticResource SmallPillButton}" Click="OnClearActivityLogClick"/>
                                <TextBlock Text="Central hub audit log" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <ListBox x:Name="FleetActivityList" ItemContainerStyle="{StaticResource FeedItem}"
                                     ItemTemplate="{StaticResource ActivityRowTemplate}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                        </DockPanel>
                    </Border>

                    <!-- Endpoint cards -->
                    <ListBox x:Name="MachinesList" SelectionMode="Extended"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="OnMachineSelectionChanged"
                             MouseDoubleClick="OnMachineDoubleClick">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel IsItemsHost="True"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,12,12"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="CardBd" Width="324" Background="{StaticResource ElevatedBrush}"
                                                    BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                                                    CornerRadius="{StaticResource RadiusCard}" Padding="16,14">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="CardBd" Property="Background" Value="{StaticResource ElevatedHoverBrush}"/>
                                                    <Setter TargetName="CardBd" Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="CardBd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                    <Setter TargetName="CardBd" Property="Background" Value="{StaticResource ElevatedHoverBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <!-- Status dot + name + status pill -->
                                    <DockPanel Margin="0,0,0,4">
                                        <Border DockPanel.Dock="Right" Background="{Binding BadgeBackground}" CornerRadius="{StaticResource RadiusPill}" Padding="8,1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StatusLabel}" FontSize="10.5" FontWeight="SemiBold" Foreground="{Binding DotBrush}"/>
                                        </Border>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Style="{StaticResource StatusDot}" Fill="{Binding DotBrush}" Margin="0,0,9,0"/>
                                            <TextBlock Text="{Binding DisplayTitle}" FontSize="{StaticResource FontSizeSubtitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="186"/>
                                        </StackPanel>
                                    </DockPanel>

                                    <!-- Address + OS -->
                                    <DockPanel Margin="16,0,0,4">
                                        <Border DockPanel.Dock="Right" Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                                                CornerRadius="{StaticResource RadiusControl}" Padding="6,1">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding OsGlyph}" FontFamily="{StaticResource MonoFont}" FontSize="10" FontWeight="Bold" Margin="0,0,5,0" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding OsTag}" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="{Binding Address}" FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FontSizeSmall}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                    </DockPanel>

                                    <!-- Uptime / last seen -->
                                    <TextBlock Text="{Binding HealthLine}" Style="{StaticResource MetaText}" Margin="16,0,0,12" TextTrimming="CharacterEllipsis"/>

                                    <!-- CPU / RAM -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <DockPanel Margin="0,0,0,4">
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding CpuLabel}" FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FontSizeCaption}" FontWeight="SemiBold"/>
                                                <TextBlock Text="CPU" Style="{StaticResource MetaText}"/>
                                            </DockPanel>
                                            <ProgressBar Style="{StaticResource ThinProgressBar}" Value="{Binding CpuPercent, Mode=OneWay}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <DockPanel Margin="0,0,0,4">
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding RamLabel}" FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FontSizeCaption}" FontWeight="SemiBold"/>
                                                <TextBlock Text="RAM" Style="{StaticResource MetaText}"/>
                                            </DockPanel>
                                            <ProgressBar Style="{StaticResource ThinProgressBar}" Foreground="{StaticResource IndigoBrush}" Value="{Binding RamPercent, Mode=OneWay}"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Actions -->
                                    <Border x:Name="QuickActionsBar" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="{Binding ConnectActionText}" Style="{StaticResource PrimaryButton}" MinHeight="26" Padding="10,2" Margin="0,0,6,0" Tag="{Binding}" Click="OnCardConnectClick"/>
                                            <Button Content="Shell" Style="{StaticResource SmallPillButton}" Padding="8,2" Margin="0,0,4,0" Tag="{Binding}" Click="OnCardTerminalClick"/>
                                            <Button Content="Wake" Style="{StaticResource SmallPillButton}" Padding="8,2" Margin="0,0,4,0" Tag="{Binding}" Click="OnCardWakeClick"/>
                                            <Button Content="Restart" Style="{StaticResource SmallPillButton}" Padding="8,2" Margin="0,0,4,0" Tag="{Binding}" Click="OnCardRestartClick"/>
                                            <Button Content="Edit" Style="{StaticResource SmallPillButton}" Padding="8,2" Tag="{Binding}" Click="OnCardEditClick"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <!-- ==================== 2. REMOTE DESKTOP ==================== -->
                <DockPanel x:Name="DesktopPanel" Visibility="Collapsed">
                    <Border x:Name="DesktopToolbarBorder" DockPanel.Dock="Top" Style="{StaticResource CardStyle}" Padding="{StaticResource CardPaddingCompact}" Margin="0,0,0,12">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                <Button Content="Send clipboard" Style="{StaticResource SmallPillButton}" Margin="0,0,4,0" Click="OnSendClipboardClick"/>
                                <Button Content="Pull clipboard" Style="{StaticResource SmallPillButton}" Margin="0,0,8,0" Click="OnGetClipboardClick"/>
                                <Border Style="{StaticResource Pill}" Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" Margin="0,0,8,0">
                                    <TextBlock x:Name="StreamStatus" Text="Idle" FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FontSizeCaption}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </Border>
                                <Button x:Name="FullScreenBtn" Content="Full screen (F11)" Style="{StaticResource GhostButton}" Click="OnToggleFullScreenClick"/>
                            </StackPanel>

                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="StreamBtn" Content="Start Stream" Width="116" Style="{StaticResource PrimaryButton}" Click="OnToggleStream"/>
                                <CheckBox x:Name="ControlCheck" Content="Input control" Margin="14,0,0,0" Checked="OnControlCheckChanged" Unchecked="OnControlCheckChanged"/>
                                <CheckBox x:Name="PrivacyCheck" Content="Curtain mode" Margin="14,0,0,0" ToolTip="Blank the remote screen &amp; lock physical input" Checked="OnPrivacyModeChanged" Unchecked="OnPrivacyModeChanged"/>
                                <Border Style="{StaticResource VDivider}" Margin="12,0"/>
                                <ComboBox x:Name="MonitorCombo" Width="108" SelectedIndex="0" Margin="0,0,6,0" SelectionChanged="OnMonitorSelectionChanged">
                                    <ComboBoxItem Content="Screen 1" Tag="0"/>
                                </ComboBox>
                                <Button x:Name="Screen1Btn" Content="1" Style="{StaticResource SmallPillButton}" Padding="8,2" Margin="0,0,3,0" ToolTip="Switch to display 1" Tag="0" Click="OnQuickMonitorSwitchClick"/>
                                <Button x:Name="Screen2Btn" Content="2" Style="{StaticResource SmallPillButton}" Padding="8,2" Margin="0,0,3,0" ToolTip="Switch to display 2" Tag="1" Click="OnQuickMonitorSwitchClick"/>
                                <Button x:Name="ScreenAllBtn" Content="All" Style="{StaticResource SmallPillButton}" Padding="8,2" Margin="0,0,6,0" ToolTip="All displays side by side" Tag="-1" Click="OnQuickMonitorSwitchClick"/>
                                <Button x:Name="DetachScreenBtn" Content="Detach 2nd" Style="{StaticResource SmallPillButton}" Margin="0,0,8,0" ToolTip="Detach screen 2 into a separate window on your second local display" Click="OnDetachSecondMonitorClick"/>
                                <Button x:Name="LaunchRdpBtn" Content="Launch RDP" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Visibility="Collapsed" Click="OnLaunchAgentlessRdpClick"/>
                                <Border Style="{StaticResource VDivider}" Margin="4,0,12,0"/>
                                <TextBlock Text="FPS" Style="{StaticResource MetaText}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox x:Name="FpsBox" FontFamily="{StaticResource MonoFont}" Text="30" Width="46" Margin="0,0,10,0"/>
                                <TextBlock Text="JPEG" Style="{StaticResource MetaText}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox x:Name="QualityBox" FontFamily="{StaticResource MonoFont}" Text="88" Width="46" Margin="0,0,10,0"/>
                                <ComboBox x:Name="ScaleBox" Width="100" SelectedIndex="0" Margin="0,0,6,0" ToolTip="Stream resolution">
                                    <ComboBoxItem Content="Native" Tag="0"/>
                                    <ComboBoxItem Content="1080p" Tag="1920"/>
                                    <ComboBoxItem Content="720p" Tag="1280"/>
                                </ComboBox>
                                <ComboBox x:Name="UpscaleBox" Width="92" SelectedIndex="0" SelectionChanged="OnUpscaleModeChanged" ToolTip="Local upscaling filter">
                                    <ComboBoxItem Content="CAS+" Tag="cas"/>
                                    <ComboBoxItem Content="Bicubic" Tag="bicubic"/>
                                    <ComboBoxItem Content="Raw" Tag="none"/>
                                </ComboBox>
                            </WrapPanel>
                        </DockPanel>
                    </Border>

                    <Border x:Name="ScreenCanvasBorder" Background="{StaticResource StreamCanvasBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusCard}" ClipToBounds="True">
                        <Grid>
                            <Grid x:Name="SharpenHost">
                                <Image x:Name="ScreenImage" Stretch="Uniform" Focusable="True"
                                       Stylus.IsPressAndHoldEnabled="False" IsManipulationEnabled="False"
                                       SizeChanged="OnScreenImageSizeChanged"
                                       MouseMove="OnScreenMouseMove" MouseDown="OnScreenMouseDown" MouseUp="OnScreenMouseUp"
                                       TouchDown="OnScreenTouchDown" TouchMove="OnScreenTouchMove" TouchUp="OnScreenTouchUp"
                                       MouseWheel="OnScreenMouseWheel" KeyDown="OnScreenKeyDown" KeyUp="OnScreenKeyUp"/>
                            </Grid>
                            <Canvas x:Name="CursorLayer" IsHitTestVisible="False">
                                <Image x:Name="RemoteCursorImage" Stretch="None" Visibility="Collapsed"/>
                            </Canvas>

                            <Border x:Name="FullscreenHud" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="0,12,16,0" Background="{StaticResource HudBrush}" BorderBrush="{StaticResource BorderStrongBrush}"
                                    BorderThickness="1" CornerRadius="{StaticResource RadiusCard}" Padding="10,6" Effect="{StaticResource ShadowPopup}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="FullscreenHudText" Text="FULL SCREEN" FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FontSizeCaption}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <Button x:Name="HudUpscaleBtn" Style="{StaticResource SmallPillButton}" Margin="0,0,4,0" Click="OnHudUpscaleClick">
                                        <TextBlock x:Name="HudUpscaleText" Text="CAS+"/>
                                    </Button>
                                    <Button Content="Paste" Style="{StaticResource SmallPillButton}" Margin="0,0,4,0" Click="OnSendClipboardClick"/>
                                    <Button Content="Copy" Style="{StaticResource SmallPillButton}" Margin="0,0,8,0" Click="OnGetClipboardClick"/>
                                    <Button Content="Exit (Esc)" Style="{StaticResource SmallPillButton}" Margin="0,0,8,0" Click="OnToggleFullScreenClick"/>
                                    <Button Content="Stop" Style="{StaticResource DangerButton}" MinHeight="26" Padding="10,2" Click="OnToggleStream"/>
                                </StackPanel>
                            </Border>

                            <StackPanel x:Name="DesktopOverlay" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="48" Height="48" CornerRadius="{StaticResource RadiusOverlay}" Background="{StaticResource ElevatedBrush}"
                                        BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" Margin="0,0,0,16" HorizontalAlignment="Center">
                                    <Path Style="{StaticResource VectorIcon}" Data="{StaticResource GeoDesktop}" Stroke="{StaticResource TextSecondaryBrush}" Width="20" Height="20" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="No stream running" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Start the stream to view this endpoint. F11 toggles full screen; the stream routes through the central hub over mTLS."
                                           Foreground="{StaticResource TextMutedBrush}" FontSize="{StaticResource FontSizeSmall}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DockPanel>

                <!-- ==================== 3. INVENTORY & PROCESSES ==================== -->
                <DockPanel x:Name="InventoryPanel" Visibility="Collapsed">
                    <DockPanel DockPanel.Dock="Top" Style="{StaticResource PageHeader}">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="InventoryTimestampText" Text="" Style="{StaticResource MonoMeta}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}" Tag="Filter apps and processes" Width="260" Margin="0,0,8,0" TextChanged="OnSearchChanged"/>
                            <Button x:Name="RefreshInvBtn" Content="Refresh inventory" Style="{StaticResource PrimaryButton}" Click="OnRefreshInventory"/>
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Inventory &amp; processes" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="Hardware, installed applications and running processes of the connected endpoint" Style="{StaticResource PageSubtitle}"/>
                        </StackPanel>
                    </DockPanel>

                    <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Processor" Style="{StaticResource Caption}"/>
                                <TextBlock x:Name="CpuValueText" Text="—" Style="{StaticResource ValueText}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="CpuSubText" Text="Connect to inspect" Style="{StaticResource MetaText}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Memory" Style="{StaticResource Caption}"/>
                                <TextBlock x:Name="RamValueText" Text="—" Style="{StaticResource ValueText}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="RamSubText" Text="RAM &amp; active processes" Style="{StaticResource MetaText}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="4" Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Graphics" Style="{StaticResource Caption}"/>
                                <TextBlock x:Name="GpuValueText" Text="—" Style="{StaticResource ValueText}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="GpuSubText" Text="Display adapter" Style="{StaticResource MetaText}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="6" Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Storage" Style="{StaticResource Caption}"/>
                                <TextBlock x:Name="DiskValueText" Text="—" Style="{StaticResource ValueText}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="DiskSubText" Text="Fixed drives" Style="{StaticResource MetaText}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.15*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="0.85*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="0">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="16,12,12,10">
                                    <Border DockPanel.Dock="Right" Style="{StaticResource Pill}" Background="{StaticResource AccentSoftBrush}">
                                        <TextBlock x:Name="AppsCountText" Text="0 apps" Style="{StaticResource PillText}" Foreground="{StaticResource AccentBrush}"/>
                                    </Border>
                                    <TextBlock Text="Installed applications" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                                </DockPanel>
                                <DataGrid x:Name="AppsGrid">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Application" Binding="{Binding Name}" Width="2*"/>
                                        <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="110" FontFamily="{StaticResource MonoFont}"/>
                                        <DataGridTextColumn Header="Publisher" Binding="{Binding Publisher}" Width="1.2*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="0">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="16,12,12,10">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Content="Terminate process" Style="{StaticResource SmallPillButton}" Margin="0,0,8,0" Click="OnKillSelectedProcessClick"/>
                                        <Border Style="{StaticResource Pill}" Background="{StaticResource SuccessSoftBrush}">
                                            <TextBlock x:Name="ProcsCountText" Text="0 procs" Style="{StaticResource PillText}" Foreground="{StaticResource OkBrush}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Running processes" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                                </DockPanel>
                                <DataGrid x:Name="ProcGrid">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="72" FontFamily="{StaticResource MonoFont}"/>
                                        <DataGridTextColumn Header="Process" Binding="{Binding Name}" Width="*"/>
                                        <DataGridTextColumn Header="RAM (MB)" Binding="{Binding MemoryMb}" Width="92" FontFamily="{StaticResource MonoFont}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>
                    </Grid>
                </DockPanel>

                <!-- ==================== 4. POWERSHELL ==================== -->
                <DockPanel x:Name="ShellPanel" Visibility="Collapsed">
                    <DockPanel DockPanel.Dock="Top" Style="{StaticResource PageHeader}">
                        <Button DockPanel.Dock="Right" Content="Clear buffer" Style="{StaticResource GhostButton}" VerticalAlignment="Center" Click="OnClearShellClick"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="PowerShell" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="Interactive remote shell over mTLS. Every command is recorded in the agent's activity log." Style="{StaticResource PageSubtitle}"/>
                        </StackPanel>
                    </DockPanel>

                    <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="Presets" Style="{StaticResource MetaText}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Button Content="whoami" Tag="whoami; hostname; $PSVersionTable.PSVersion.ToString()" Style="{StaticResource SmallPillButton}" Margin="0,0,6,0" Click="OnQuickCommandClick"/>
                        <Button Content="IP config" Tag="Get-NetIPAddress -AddressFamily IPv4 | Select-Object InterfaceAlias, IPAddress | Format-Table -AutoSize" Style="{StaticResource SmallPillButton}" Margin="0,0,6,0" Click="OnQuickCommandClick"/>
                        <Button Content="Top CPU" Tag="Get-Process | Sort-Object CPU -Descending | Select-Object -First 10 Id, ProcessName, @{N='CPU(s)';E={[math]::Round($_.CPU,1)}}, @{N='RAM(MB)';E={[math]::Round($_.WorkingSet64/1MB,1)}} | Format-Table -AutoSize" Style="{StaticResource SmallPillButton}" Margin="0,0,6,0" Click="OnQuickCommandClick"/>
                        <Button Content="Disks" Tag="Get-PSDrive -PSProvider FileSystem | Select-Object Name, @{N='Used(GB)';E={[math]::Round($_.Used/1GB,1)}}, @{N='Free(GB)';E={[math]::Round($_.Free/1GB,1)}} | Format-Table -AutoSize" Style="{StaticResource SmallPillButton}" Margin="0,0,6,0" Click="OnQuickCommandClick"/>
                        <Button Content="Uptime" Tag="(Get-Date) - (Get-CimInstance Win32_OperatingSystem).LastBootUpTime | Select-Object Days, Hours, Minutes | Format-List" Style="{StaticResource SmallPillButton}" Click="OnQuickCommandClick"/>
                    </WrapPanel>

                    <Border DockPanel.Dock="Bottom" Style="{StaticResource CardStyle}" Padding="8" Margin="0,12,0,0">
                        <DockPanel>
                            <Button x:Name="ShellSendBtn" DockPanel.Dock="Right" Content="Execute" Width="100" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="OnShellSend"/>
                            <Border DockPanel.Dock="Left" Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusControl}" Padding="10,0" Margin="0,0,8,0">
                                <TextBlock Text="PS &gt;" FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                            </Border>
                            <TextBox x:Name="ShellInputBox" FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FontSizeBody}" KeyDown="OnShellInputKeyDown"/>
                        </DockPanel>
                    </Border>

                    <Border Background="{StaticResource SunkenBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusCard}" Padding="2">
                        <TextBox x:Name="ShellOutput" IsReadOnly="True" Background="Transparent" Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0" Padding="14,12"
                                 FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FontSizeSmall}" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalContentAlignment="Top"/>
                    </Border>
                </DockPanel>

                <!-- ==================== 5. DEPLOY ==================== -->
                <DockPanel x:Name="DeployPanel" Visibility="Collapsed" AllowDrop="True" PreviewDragOver="OnDeployDragOver" Drop="OnDeployFileDrop"
                           IsVisibleChanged="OnDeployPanelVisibleChanged">
                    <DockPanel.Resources>
                        <!-- Status text colour per deploy state (cards, queue rows, file rows) -->
                        <Style x:Key="DeployStatusText" TargetType="TextBlock">
                            <Setter Property="FontSize" Value="10.5"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DeployStatus}" Value="Queued"><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/></DataTrigger>
                                <DataTrigger Binding="{Binding DeployStatus}" Value="Downloading"><Setter Property="Foreground" Value="{StaticResource InfoBrush}"/></DataTrigger>
                                <DataTrigger Binding="{Binding DeployStatus}" Value="Installing"><Setter Property="Foreground" Value="{StaticResource InfoBrush}"/></DataTrigger>
                                <DataTrigger Binding="{Binding DeployStatus}" Value="Success"><Setter Property="Foreground" Value="{StaticResource OkBrush}"/></DataTrigger>
                                <DataTrigger Binding="{Binding DeployStatus}" Value="Skipped"><Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/></DataTrigger>
                                <DataTrigger Binding="{Binding DeployStatus}" Value="Failed"><Setter Property="Foreground" Value="{StaticResource DangerBrush}"/></DataTrigger>
                                <DataTrigger Binding="{Binding DeployStatus}" Value="Cancelled"><Setter Property="Foreground" Value="{StaticResource WarnBrush}"/></DataTrigger>
                            </Style.Triggers>
                        </Style>
                        <!-- Monogram shows only while no icon is loaded -->
                        <Style x:Key="DeployMonogram" TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Icon}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DockPanel.Resources>

                    <DockPanel DockPanel.Dock="Top" Style="{StaticResource PageHeader}">
                        <Border DockPanel.Dock="Right" Style="{StaticResource Pill}" Background="{StaticResource AccentSoftBrush}" BorderBrush="{StaticResource AccentLineBrush}" BorderThickness="1">
                            <TextBlock x:Name="DeployStatusBadge" Text="READY" Style="{StaticResource PillText}" Foreground="{StaticResource AccentBrush}"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Deploy software" Style="{StaticResource PageTitle}"/>
                            <TextBlock x:Name="WingetSourceStatusText" Text="Catalog source: built-in list (the official winget index loads when this view opens)" Style="{StaticResource PageSubtitle}"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Catalog search, packs, import & install options -->
                    <Border DockPanel.Dock="Top" Style="{StaticResource CardStyle}" Padding="14,12,14,8" Margin="0,0,0,12">
                        <StackPanel>
                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBox x:Name="WingetSearchBox" Style="{StaticResource SearchBox}" Tag="Search the winget catalog" Width="250" Margin="0,0,6,6"
                                         ToolTip="Search the full winget catalog by ID, name, moniker, tag or publisher" TextChanged="OnWingetSearchChanged"/>
                                <ComboBox x:Name="WingetCategoryCombo" Width="150" Margin="0,0,6,6" ToolTip="Category (derived from winget tags)" SelectionChanged="OnWingetCategoryChanged"/>
                                <Button Content="Refresh index" Style="{StaticResource GhostButton}" Margin="0,0,0,6" ToolTip="Check cdn.winget.microsoft.com for a newer index" Click="OnRefreshWingetIndexClick"/>
                                <Border Style="{StaticResource VDivider}" Margin="12,0,12,6"/>
                                <ComboBox x:Name="WingetPackCombo" Width="190" Margin="0,0,6,6" SelectionChanged="OnWingetPackSelectionChanged" ToolTip="Saved app packs"/>
                                <Button Content="Load pack" Style="{StaticResource SmallPillButton}" Margin="0,0,4,6" ToolTip="Add the pack's apps to the queue" Click="OnApplyWingetPackClick"/>
                                <Button x:Name="WingetDeletePackBtn" Content="Delete pack" Style="{StaticResource SmallPillButton}" Margin="0,0,12,6" IsEnabled="False" ToolTip="Delete the selected custom pack" Click="OnDeleteWingetPackClick"/>
                                <TextBox x:Name="WingetPackNameBox" Width="150" Margin="0,0,4,6" ToolTip="Name for a new custom pack (saved from the current queue)"/>
                                <Button Content="Save pack" Style="{StaticResource SmallPillButton}" Margin="0,0,12,6" Click="OnSaveWingetPackClick"/>
                                <Button Content="Import pack…" Style="{StaticResource SmallPillButton}" Margin="0,0,0,6" ToolTip="Import a winstall pack URL, a winget script, JSON or an ID list" Click="OnToggleWingetImportClick"/>
                            </WrapPanel>

                            <WrapPanel Orientation="Horizontal" Margin="0,2,0,4">
                                <CheckBox x:Name="WingetSilentCheck" Content="Silent" IsChecked="True" Margin="0,0,16,0" ToolTip="winget --silent"/>
                                <CheckBox x:Name="WingetMachineScopeCheck" Content="Machine scope" IsChecked="True" Margin="0,0,16,0" ToolTip="winget --scope machine (unchecked = winget default scope)"/>
                                <CheckBox x:Name="WingetUpgradeCheck" Content="Upgrade if installed" IsChecked="True" ToolTip="Try 'winget upgrade' first, install when the package is not present"/>
                            </WrapPanel>

                            <!-- Import Pack area -->
                            <Border x:Name="WingetImportPanel" Visibility="Collapsed" Margin="0,10,0,4" Padding="12" Style="{StaticResource WellStyle}">
                                <StackPanel>
                                    <TextBlock Text="Import pack" Style="{StaticResource Caption}"/>
                                    <TextBlock Style="{StaticResource MetaText}" TextWrapping="Wrap" Margin="0,0,0,8"
                                               Text="Paste a winstall.app pack URL, a winstall-generated winget script (batch or PowerShell), a winget export JSON, an {&quot;apps&quot;:[{&quot;id&quot;:...}]} JSON, or one package ID per line. Every ID is validated; valid IDs are added to the queue."/>
                                    <TextBox x:Name="WingetImportBox" Height="96" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                                             FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FontSizeCaption}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button x:Name="WingetImportRunBtn" Content="Import to queue" Style="{StaticResource PrimaryButton}" Margin="0,0,6,0" Click="OnRunWingetImportClick"/>
                                        <Button Content="Paste clipboard" Style="{StaticResource SmallPillButton}" Margin="0,0,6,0" Click="OnPasteWingetImportClick"/>
                                        <Button Content="Close" Style="{StaticResource SmallPillButton}" Click="OnToggleWingetImportClick"/>
                                    </StackPanel>
                                    <TextBlock x:Name="WingetImportResultText" FontSize="{StaticResource FontSizeCaption}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Bottom: file deploy list & live log -->
                    <Border DockPanel.Dock="Bottom" Style="{StaticResource CardStyle}" Padding="12,10" Margin="0,12,0,0" Height="210">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <TextBox x:Name="DeployFilePathBox" Width="190" FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FontSizeCaption}" Margin="0,0,6,0" ToolTip="Local .exe / .msi / .msp / .ps1 / .cmd / .bat path"/>
                                    <TextBox x:Name="DeployArgsBox" Width="90" FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FontSizeCaption}" Text="AUTO" Margin="0,0,6,0" ToolTip="Installer arguments (AUTO = detect silent flags)"/>
                                    <Button Content="Browse" Style="{StaticResource SmallPillButton}" Margin="0,0,4,0" Click="OnBrowseDeployFileClick"/>
                                    <Button x:Name="DeployRunBtn" Content="Run files" Style="{StaticResource SmallPillButton}" Margin="0,0,4,0" ToolTip="Upload and run every pending file on the connected agent" Click="OnStartDeployClick"/>
                                    <Button Content="Run script" Style="{StaticResource SmallPillButton}" Margin="0,0,4,0" Click="OnUploadAndRunScriptClick"/>
                                    <Button Content="Clear files" Style="{StaticResource SmallPillButton}" Margin="0,0,4,0" Click="OnClearDeployFilesClick"/>
                                    <Button Content="Clear log" Style="{StaticResource SmallPillButton}" Click="OnClearDeployLogClick"/>
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="File deploy &amp; live log" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="Drop .exe, .msi, .msp or .ps1 files anywhere on this page" Style="{StaticResource MetaText}"/>
                                </StackPanel>
                            </DockPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="300"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ListBox x:Name="DeployFileList" Grid.Column="0" Background="{StaticResource FieldBrush}" BorderThickness="1" Padding="4"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,2">
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Content="×" Style="{StaticResource SubtleButton}" MinHeight="20" Padding="6,0" Margin="6,0,0,0" ToolTip="Remove" Click="OnRemoveDeployFileClick"/>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding StatusLabel}" Style="{StaticResource DeployStatusText}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                    <TextBlock Text="{Binding FileName}" FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}" VerticalAlignment="Center"/>
                                                </DockPanel>
                                                <ProgressBar Style="{StaticResource ThinProgressBar}" Value="{Binding ProgressValue, Mode=OneWay}" IsIndeterminate="{Binding IsIndeterminate, Mode=OneWay}"
                                                             Visibility="{Binding ProgressVisibility}" Margin="0,4,0,0"/>
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource MetaText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBox x:Name="DeployOutputBox" Grid.Column="2" IsReadOnly="True" Background="{StaticResource SunkenBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" Padding="10,8"
                                         FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FontSizeCaption}" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"/>
                            </Grid>
                        </DockPanel>
                    </Border>

                    <!-- Right: targets & deployment queue -->
                    <Border DockPanel.Dock="Right" Width="330" Style="{StaticResource CardStyle}" Padding="14,12" Margin="12,0,0,0">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                <Button DockPanel.Dock="Right" Content="Refresh" Style="{StaticResource SmallPillButton}" Click="OnRefreshDeployTargetsClick"/>
                                <TextBlock Text="Target endpoints" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <ListBox x:Name="DeployTargetList" DockPanel.Dock="Top" MaxHeight="112"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" ToolTip="{Binding Address}">
                                            <TextBlock FontSize="{StaticResource FontSizeSmall}">
                                                <Run Text="{Binding Name, Mode=OneWay}" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <Run Text="{Binding Detail, Mode=OneWay}" Foreground="{StaticResource TextMutedBrush}"/>
                                            </TextBlock>
                                        </CheckBox>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock x:Name="DeployTargetHintText" DockPanel.Dock="Top" Style="{StaticResource MetaText}" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Text="Nothing checked = the connected endpoint."/>

                            <DockPanel DockPanel.Dock="Top" Margin="0,16,0,8">
                                <Button DockPanel.Dock="Right" Content="Clear" Style="{StaticResource SmallPillButton}" Click="OnClearWingetQueueClick"/>
                                <TextBlock x:Name="WingetQueueCountText" Text="Deployment queue (0)" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                            </DockPanel>

                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                                <Button x:Name="WingetDeploySelectedBtn" Content="Deploy Queue (0)" Style="{StaticResource PrimaryButton}" Margin="0,0,6,0" Click="OnDeploySelectedWingetClick"/>
                                <Button x:Name="WingetCancelDeployBtn" Content="Cancel" Style="{StaticResource DangerButton}" IsEnabled="False" Click="OnCancelWingetDeployClick"/>
                            </StackPanel>

                            <ListBox x:Name="WingetQueueList" HorizontalContentAlignment="Stretch" ItemContainerStyle="{StaticResource FeedItem}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="10,8" Margin="0,0,0,2" Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusControl}">
                                            <StackPanel>
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Content="×" Style="{StaticResource SubtleButton}" MinHeight="20" Padding="6,0" Margin="6,0,0,0" ToolTip="Remove from queue" Click="OnRemoveWingetQueueItemClick"/>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding StatusLabel}" Style="{StaticResource DeployStatusText}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis">
                                                            <Run Text="{Binding Id, Mode=OneWay}"/>
                                                            <Run Text="{Binding Version, Mode=OneWay}"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </DockPanel>
                                                <ProgressBar Style="{StaticResource ThinProgressBar}" Value="{Binding ProgressValue, Mode=OneWay}" IsIndeterminate="{Binding IsIndeterminate, Mode=OneWay}"
                                                             Visibility="{Binding ProgressVisibility}" Margin="0,6,0,0"/>
                                                <TextBlock Text="{Binding StatusDetail}" Visibility="{Binding DetailVisibility}" Style="{StaticResource MetaText}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <!-- Centre: catalog cards -->
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                            <Button x:Name="WingetLoadMoreBtn" DockPanel.Dock="Right" Content="Load more" Style="{StaticResource SmallPillButton}" Visibility="Collapsed" Click="OnWingetLoadMoreClick"/>
                            <TextBlock x:Name="WingetResultCountText" Style="{StaticResource MetaText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                        <ScrollViewer x:Name="WingetCatalogScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="WingetCatalogList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="236" Margin="0,0,12,12" Padding="14,12" Background="{StaticResource ElevatedBrush}"
                                                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusCard}">
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,8">
                                                    <CheckBox DockPanel.Dock="Right" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Top" ToolTip="Add to the deployment queue" Click="OnWingetCardSelectionChanged"/>
                                                    <Border Width="32" Height="32" CornerRadius="{StaticResource RadiusControl}" Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" Margin="0,0,10,0" DockPanel.Dock="Left">
                                                        <Grid>
                                                            <TextBlock Text="{Binding Monogram}" Style="{StaticResource DeployMonogram}" FontFamily="{StaticResource MonoFont}" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            <Image Source="{Binding Icon}" Width="20" Height="20" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                        </Grid>
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Id}"/>
                                                        <TextBlock Text="{Binding Publisher}" Style="{StaticResource MetaText}" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </DockPanel>
                                                <TextBlock Text="{Binding Description}" FontSize="{StaticResource FontSizeCaption}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Height="30" TextTrimming="CharacterEllipsis" Margin="0,0,0,10" ToolTip="{Binding Id}"/>
                                                <DockPanel>
                                                    <Border DockPanel.Dock="Right" Style="{StaticResource Pill}" Background="{StaticResource NeutralSoftBrush}" Padding="7,1">
                                                        <TextBlock Text="{Binding StatusLabel}" Style="{StaticResource DeployStatusText}"/>
                                                    </Border>
                                                    <TextBlock Style="{StaticResource MetaText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                        <Run Text="{Binding Category, Mode=OneWay}"/>
                                                        <Run Text=" · "/>
                                                        <Run Text="{Binding Version, Mode=OneWay}" FontFamily="{StaticResource MonoFont}"/>
                                                    </TextBlock>
                                                </DockPanel>
                                                <ProgressBar Style="{StaticResource ThinProgressBar}" Value="{Binding ProgressValue, Mode=OneWay}" IsIndeterminate="{Binding IsIndeterminate, Mode=OneWay}"
                                                             Visibility="{Binding ProgressVisibility}" Margin="0,8,0,0"/>
                                                <TextBlock Text="{Binding StatusDetail}" Visibility="{Binding DetailVisibility}" Style="{StaticResource MetaText}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </DockPanel>

                <!-- ==================== 6. SYSTEM & SETTINGS / WINDOWS UPDATE ==================== -->
                <Grid x:Name="SystemPanel" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="224"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="10,12">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                <TextBlock Text="Categories" Style="{StaticResource Caption}" Margin="4,0,0,8"/>
                                <TextBox x:Name="SettingsSearchBox" Style="{StaticResource SearchBox}" Tag="Search operations" TextChanged="OnSettingsSearchChanged"/>
                            </StackPanel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="Win11SidebarPanel"/>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <DockPanel Grid.Column="2" LastChildFill="True">
                        <DockPanel DockPanel.Dock="Top" Style="{StaticResource PageHeader}">
                            <Border x:Name="SystemAdminBadge" DockPanel.Dock="Right" Style="{StaticResource Pill}" Background="{StaticResource WarningSoftBrush}">
                                <TextBlock x:Name="SystemAdminText" Text="AGENT: STANDARD USER" Style="{StaticResource PillText}" Foreground="{StaticResource WarnBrush}"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock x:Name="Win11PageTitle" Text="Home" Style="{StaticResource PageTitle}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="Win11PageSubtitle" Text="Device overview and remote settings" Style="{StaticResource PageSubtitle}"/>
                            </StackPanel>
                        </DockPanel>

                        <Border DockPanel.Dock="Top" Style="{StaticResource CardStyle}" Padding="14,10" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.4*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock x:Name="SystemTargetLabel" Text="Target" Style="{StaticResource FieldLabel}" TextTrimming="CharacterEllipsis"/>
                                    <TextBox x:Name="SystemTargetBox" FontFamily="{StaticResource MonoFont}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock x:Name="SystemExtraLabel" Text="Extra" Style="{StaticResource FieldLabel}" TextTrimming="CharacterEllipsis"/>
                                    <TextBox x:Name="SystemExtraBox" FontFamily="{StaticResource MonoFont}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border DockPanel.Dock="Bottom" Background="{StaticResource SunkenBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusCard}" Padding="4" Height="210" Margin="0,12,0,0">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="10,6,6,6">
                                    <TextBox x:Name="SystemFilterBox" DockPanel.Dock="Right" Style="{StaticResource SearchBox}" Tag="Filter rows" Width="190" TextChanged="OnSystemFilterChanged"/>
                                    <TextBlock x:Name="SystemMessageText" Text="Select any operation above to execute on the endpoint." FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextMutedBrush}" FontSize="{StaticResource FontSizeSmall}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                                </DockPanel>
                                <TextBlock x:Name="SystemHeaderText" DockPanel.Dock="Top" FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="10,0,10,4"/>
                                <ListBox x:Name="SystemRowsList" FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FontSizeSmall}" Foreground="{StaticResource TextPrimaryBrush}" SelectionChanged="OnSystemRowSelected"/>
                            </DockPanel>
                        </Border>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                            <StackPanel x:Name="Win11CardsPanel"/>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>

                <!-- ==================== 7. APPLIANCE WEB UI (REVERSE PROXY) ==================== -->
                <DockPanel x:Name="WebUiPanel" Visibility="Collapsed">
                    <DockPanel DockPanel.Dock="Top" Style="{StaticResource PageHeader}">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Open in browser (proxied)" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="OnOpenProxiedWebUiClick"/>
                            <Button Content="Refresh health" Style="{StaticResource GhostButton}" Click="OnRefreshApplianceHealthClick"/>
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="WebUiTitleText" Text="Appliance Web UI (Central Reverse Proxy)" Style="{StaticResource PageTitle}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="WebUiUrlText" Text="http://localhost:7480/proxy/..." FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FontSizeSmall}" Foreground="{StaticResource AccentBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource CardStyle}" Padding="20,18" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Appliance &amp; service telemetry" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                            <TextBlock x:Name="ApplianceMetricsText" Text="Select an appliance or click Refresh health to query ping, HTTP and SSH metrics."
                                       FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FontSizeSmall}" TextWrapping="Wrap" Margin="0,0,0,16"/>
                            <TextBlock Text="All traffic is reverse-proxied through the central Home RMS server, so dashboards (Home Assistant, TrueNAS, Synology, Proxmox) stay reachable from the desktop console and the mobile web app without exposing LAN ports."
                                       Style="{StaticResource MetaText}" FontSize="{StaticResource FontSizeSmall}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </DockPanel>

                <!-- ==================== 8-10. FEATURE VIEWS (Views\*.xaml, wired in MainWindow.Features.cs) ==================== -->
                <ContentControl x:Name="FilesHost" Visibility="Collapsed"/>
                <ContentControl x:Name="ServicesHost" Visibility="Collapsed"/>
                <ContentControl x:Name="ScriptsHost" Visibility="Collapsed"/>

            </Grid>

            <!-- ==================== LIVE CONSOLE DRAWER ==================== -->
            <GridSplitter x:Name="ConsoleSplitter" Grid.Row="1" Style="{StaticResource DrawerSplitter}" ResizeDirection="Rows"
                          ResizeBehavior="PreviousAndNext" Visibility="Collapsed" DragCompleted="OnConsoleSplitterDragCompleted"/>
            <Border x:Name="ConsoleDrawer" Grid.Row="2" Background="{StaticResource SurfaceLayerBrush}" Visibility="Collapsed">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="16,8,12,6">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBox x:Name="ConsoleSearchBox" Style="{StaticResource SearchBox}" Tag="Filter lines" Width="200" Height="28" MinHeight="28" Margin="0,0,8,0"
                                     TextChanged="OnConsoleSearchChanged"/>
                            <Button Style="{StaticResource SubtleButton}" ToolTip="Copy the visible lines" Click="OnConsoleCopyClick">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource VectorIcon}" Data="{StaticResource GeoCopy}" Width="12" Height="12" Margin="0,0,6,0"/>
                                    <TextBlock Text="Copy" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SubtleButton}" ToolTip="Clear the console" Click="OnConsoleClearClick">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource VectorIcon}" Data="{StaticResource GeoTrash}" Width="12" Height="12" Margin="0,0,6,0"/>
                                    <TextBlock Text="Clear" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SubtleButton}" Padding="6,0" Width="28" ToolTip="Hide the console" Click="OnToggleConsoleClick">
                                <Path Style="{StaticResource VectorIcon}" Data="{StaticResource GeoChevronDown}" Width="12" Height="12"/>
                            </Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Style="{StaticResource StatusDot}" Fill="{StaticResource OkBrush}" Margin="0,0,8,0" ToolTip="Live"/>
                            <TextBlock Text="Live console" Style="{StaticResource SectionTitle}" FontSize="{StaticResource FontSizeBody}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ConsoleCountText" Text="0 lines" Style="{StaticResource MetaText}" VerticalAlignment="Center" Margin="10,0,16,0"/>
                            <RadioButton x:Name="ConsoleFilterAll" Content="All" Tag="All" GroupName="ConsoleSource" Style="{StaticResource ChipRadio}" IsChecked="True" Checked="OnConsoleFilterChanged"/>
                            <RadioButton x:Name="ConsoleFilterActivity" Content="Activity" Tag="Activity" GroupName="ConsoleSource" Style="{StaticResource ChipRadio}" Checked="OnConsoleFilterChanged"/>
                            <RadioButton x:Name="ConsoleFilterDeploy" Content="Deploy" Tag="Deploy" GroupName="ConsoleSource" Style="{StaticResource ChipRadio}" Checked="OnConsoleFilterChanged"/>
                            <RadioButton x:Name="ConsoleFilterScripts" Content="Scripts" Tag="Scripts" GroupName="ConsoleSource" Style="{StaticResource ChipRadio}" Checked="OnConsoleFilterChanged"/>
                            <RadioButton x:Name="ConsoleFilterAlerts" Content="Alerts" Tag="Alerts" GroupName="ConsoleSource" Style="{StaticResource ChipRadio}" Checked="OnConsoleFilterChanged"/>
                        </StackPanel>
                    </DockPanel>
                    <ListBox x:Name="ConsoleList" Margin="8,0,8,8" Background="{StaticResource SunkenBrush}" BorderThickness="1" Padding="4"
                             ItemContainerStyle="{StaticResource FeedItem}" FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FontSizeSmall}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding TimeText}" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,12,0"/>
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Source}" Foreground="{Binding ToneBrush}" Width="64" Margin="0,0,8,0"/>
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Category}" Foreground="{StaticResource TextSecondaryBrush}" MaxWidth="160" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                                    <TextBlock Text="{Binding Message}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Message}"/>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            </Grid>
        </Grid>

        <!-- ==================== ADD / EDIT ENDPOINT DRAWER ==================== -->
        <Grid x:Name="EndpointDrawerOverlay" Grid.RowSpan="2" Visibility="Collapsed" Background="{StaticResource ScrimBrush}">
            <Border x:Name="EndpointDrawerPanel" Width="420" Style="{StaticResource DrawerPanel}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,20">
                        <Button DockPanel.Dock="Right" Style="{StaticResource SubtleButton}" Width="30" Padding="0" VerticalAlignment="Top" ToolTip="Close" Click="OnCloseEndpointDrawerClick">
                            <Path Style="{StaticResource VectorIcon}" Data="{StaticResource GeoClose}" Width="12" Height="12"/>
                        </Button>
                        <StackPanel>
                            <TextBlock Text="Endpoint configuration" Style="{StaticResource MetaText}" Margin="0,0,0,2"/>
                            <TextBlock x:Name="DrawerTitleText" Text="Add or Edit Managed Endpoint" Style="{StaticResource PageTitle}" FontSize="{StaticResource FontSizeTitle}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DockPanel>

                    <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
                        <Button Content="Save endpoint" Style="{StaticResource PrimaryButton}" Margin="0,0,0,8" Click="OnSaveMachineClick"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Delete" Style="{StaticResource DangerButton}" Click="OnRemoveMachineClick"/>
                            <Button Grid.Column="2" Content="Cancel" Style="{StaticResource GhostButton}" Click="OnCloseEndpointDrawerClick"/>
                        </Grid>
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,6,0">
                            <TextBlock Text="Endpoint type &amp; connection mode" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="EndpointKindCombo" SelectedIndex="0" Margin="0,0,0,16" SelectionChanged="OnEndpointKindChanged">
                                <ComboBoxItem Content="Windows — Agent (mTLS)" Tag="WindowsAgent"/>
                                <ComboBoxItem Content="Windows — Agentless (WinRM / RDP)" Tag="WindowsAgentless"/>
                                <ComboBoxItem Content="Home Assistant" Tag="HomeAssistant"/>
                                <ComboBoxItem Content="NAS / Storage Appliance" Tag="Nas"/>
                                <ComboBoxItem Content="Linux Server (SSH)" Tag="Linux"/>
                                <ComboBoxItem Content="Local Web Service" Tag="WebService"/>
                            </ComboBox>

                            <TextBlock Text="Display name" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="NameBox" Text="Living Room PC" Margin="0,0,0,16"/>

                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Host / LAN IP" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="HostBox" FontFamily="{StaticResource MonoFont}" Text="localhost"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Port" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="PortBox" FontFamily="{StaticResource MonoFont}" Text="7443"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="MAC address (Wake-on-LAN)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="MacBox" FontFamily="{StaticResource MonoFont}" Text="" Margin="0,0,0,16"/>

                            <!-- Credentials / Agentless / SSH / Web UI fields -->
                            <StackPanel x:Name="CredentialsPanel" Visibility="Collapsed">
                                <TextBlock Text="Username (WinRM / RDP / SSH)" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="UsernameBox" FontFamily="{StaticResource MonoFont}" Margin="0,0,0,16"/>

                                <TextBlock Text="Password (stored DPAPI-encrypted)" Style="{StaticResource FieldLabel}"/>
                                <PasswordBox x:Name="EndpointPasswordBox" Margin="0,0,0,16"/>

                                <Grid x:Name="SshFieldsGrid" Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="SSH port" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="SshPortBox" FontFamily="{StaticResource MonoFont}" Text="22"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="SSH private key path (optional)" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="SshKeyBox" FontFamily="{StaticResource MonoFont}"/>
                                    </StackPanel>
                                </Grid>

                                <StackPanel x:Name="WebUrlPanel" Margin="0,0,0,16">
                                    <TextBlock Text="Web UI URL (reverse proxy)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="WebUrlBox" FontFamily="{StaticResource MonoFont}" ToolTip="e.g. http://192.168.1.50:8123"/>
                                </StackPanel>

                                <CheckBox x:Name="UseMultimonCheck" Content="Enable multi-monitor RDP (/multimon)" IsChecked="True" Margin="0,0,0,16"/>

                                <Grid x:Name="AgentlessActionsGrid" Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="Prep script" Style="{StaticResource SmallPillButton}" Click="OnCopyPrepScriptClick" ToolTip="Copy path/command for Prepare-AgentlessHost.ps1"/>
                                    <Button Grid.Column="2" Content="Install agent" Style="{StaticResource SmallPillButton}" Click="OnInstallAgentRemotelyClick" ToolTip="Install the Home RMS agent remotely via WinRM"/>
                                </Grid>
                            </StackPanel>

                            <Border Style="{StaticResource WellStyle}" Padding="12,10">
                                <DockPanel>
                                    <Path DockPanel.Dock="Left" Style="{StaticResource VectorIcon}" Data="{StaticResource GeoShield}" Stroke="{StaticResource AccentBrush}" Width="14" Height="14" VerticalAlignment="Top" Margin="0,1,10,0"/>
                                    <TextBlock Text="Credentials (DPAPI) and mutual-TLS X.509 certificates are stored and managed only on the central Home RMS server." Style="{StaticResource MetaText}" TextWrapping="Wrap"/>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ==================== HEALTH & ALERT CENTER DRAWER ==================== -->
        <Grid x:Name="AlertDrawerOverlay" Grid.RowSpan="2" Visibility="Collapsed" Background="{StaticResource ScrimBrush}">
            <Border x:Name="AlertDrawerPanel" Width="440" Style="{StaticResource DrawerPanel}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Content="Ack all" Style="{StaticResource SmallPillButton}" Margin="0,0,4,0" Click="OnAckAllAlertsClick"/>
                            <Button Content="Clear" Style="{StaticResource SmallPillButton}" Margin="0,0,6,0" Click="OnClearAlertsClick"/>
                            <Button Style="{StaticResource SubtleButton}" Width="30" Padding="0" ToolTip="Close" Click="OnCloseAlertCenterClick">
                                <Path Style="{StaticResource VectorIcon}" Data="{StaticResource GeoClose}" Width="12" Height="12"/>
                            </Button>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Health monitoring" Style="{StaticResource MetaText}" Margin="0,0,0,2"/>
                            <TextBlock Text="Alert center" Style="{StaticResource PageTitle}" FontSize="{StaticResource FontSizeTitle}"/>
                        </StackPanel>
                    </DockPanel>

                    <Border DockPanel.Dock="Bottom" Style="{StaticResource WellStyle}" Padding="12" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Alert thresholds" Style="{StaticResource Caption}" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="CPU %" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="CpuThresholdBox" FontFamily="{StaticResource MonoFont}" Text="90"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="RAM %" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="RamThresholdBox" FontFamily="{StaticResource MonoFont}" Text="90"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Disk min %" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="DiskThresholdBox" FontFamily="{StaticResource MonoFont}" Text="10"/>
                                </StackPanel>
                                <StackPanel Grid.Column="6">
                                    <TextBlock Text="Temp °C" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="TempThresholdBox" FontFamily="{StaticResource MonoFont}" Text="85"/>
                                </StackPanel>
                            </Grid>
                            <Button Content="Save thresholds" Style="{StaticResource SmallPillButton}" HorizontalAlignment="Right" Margin="0,10,0,0" Click="OnSaveAlertThresholdsClick"/>
                        </StackPanel>
                    </Border>

                    <ListBox x:Name="AlertsListBox" ItemContainerStyle="{StaticResource FeedItem}" HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource ElevatedBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                                        CornerRadius="{StaticResource RadiusCard}" Padding="12,10" Margin="0,0,0,4">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Left" Width="3" CornerRadius="1.5" Background="{Binding SeverityBrush}" Margin="0,0,12,0"/>
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,4">
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding TimeText}" Style="{StaticResource MonoMeta}"/>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding SeverityText}" FontSize="10.5" FontWeight="Bold" Foreground="{Binding SeverityBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Title}" FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </DockPanel>
                                            <TextBlock Text="{Binding EndpointName}" FontSize="{StaticResource FontSizeCaption}" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,2"/>
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource MetaText}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ==================== SERVER & PKI MODAL ==================== -->
        <Grid x:Name="AboutOverlay" Grid.RowSpan="2" Visibility="Collapsed" Background="{StaticResource ScrimBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Border x:Name="AboutCard" Style="{StaticResource OverlayCard}" Width="480" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,24">
                <StackPanel>
                    <DockPanel Margin="0,0,0,16">
                        <Button DockPanel.Dock="Right" Style="{StaticResource SubtleButton}" Width="30" Padding="0" VerticalAlignment="Top" ToolTip="Close" Click="OnCloseAboutClick">
                            <Path Style="{StaticResource VectorIcon}" Data="{StaticResource GeoClose}" Width="12" Height="12"/>
                        </Button>
                        <Border DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="{StaticResource RadiusCard}" Background="{StaticResource AccentSoftBrush}" Margin="0,0,12,0">
                            <Path Style="{StaticResource VectorIcon}" Data="{StaticResource GeoShield}" Stroke="{StaticResource AccentBrush}" Width="18" Height="18" HorizontalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Server &amp; PKI" Style="{StaticResource PageTitle}" FontSize="{StaticResource FontSizeTitle}"/>
                            <TextBlock Text="Hub &amp; relay architecture (mTLS / HTTP2)" Style="{StaticResource MetaText}"/>
                        </StackPanel>
                    </DockPanel>

                    <Border Style="{StaticResource WellStyle}" Padding="14,12" Margin="0,0,0,16">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock DockPanel.Dock="Right" x:Name="AboutVersionText" Text="v2.0.0" FontFamily="{StaticResource MonoFont}" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                                <TextBlock Text="Server build" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,12">
                                <TextBlock DockPanel.Dock="Right" Text=".NET 11.0 (central hub &amp; console)" FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FontSizeSmall}"/>
                                <TextBlock Text="Runtime" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </DockPanel>
                            <TextBlock Text="Server X.509 SHA-256 fingerprint" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="AboutFingerprintBox" IsReadOnly="True" FontFamily="{StaticResource MonoFont}" FontSize="10.5" Margin="0,0,0,12"/>

                            <!-- Central Hub relay (mobile web app) sign-in -->
                            <TextBlock x:Name="AboutHubKeyLabel" Text="Hub relay access key (mobile web app sign-in)" Style="{StaticResource FieldLabel}"/>
                            <DockPanel Margin="0,0,0,6">
                                <Button DockPanel.Dock="Right" Content="New key" Style="{StaticResource SmallPillButton}" Margin="6,0,0,0" Click="OnRegenerateHubKeyClick"
                                        ToolTip="Generate a new access key and sign out every phone / browser"/>
                                <Button DockPanel.Dock="Right" Content="Copy" Style="{StaticResource SmallPillButton}" Margin="6,0,0,0" Click="OnCopyHubKeyClick"/>
                                <TextBox x:Name="AboutHubKeyBox" IsReadOnly="True" FontFamily="{StaticResource MonoFont}" FontSize="10.5"/>
                            </DockPanel>
                            <CheckBox x:Name="HubRequireAuthCheck" Content="Require sign-in for the hub relay (recommended)" Margin="0,0,0,12"
                                      Checked="OnToggleHubAuth" Unchecked="OnToggleHubAuth"/>

                            <!-- Security: unreadable 2FA config warning -->
                            <Border x:Name="SecurityWarningBorder" Visibility="Collapsed" Background="{StaticResource WarningSoftBrush}" BorderBrush="{StaticResource WarningLineBrush}" BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusControl}" Padding="10,8" Margin="0,0,0,10">
                                <TextBlock x:Name="SecurityWarningText" FontSize="{StaticResource FontSizeCaption}" Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap"/>
                            </Border>
                            <CheckBox x:Name="Require2FaStartupCheck" Content="Lock console on startup (Windows Hello / TOTP / master password)" Margin="0,0,0,8" Checked="OnToggleStartup2Fa" Unchecked="OnToggleStartup2Fa"/>
                            <CheckBox x:Name="AllowPasskeyCheck" Content="Allow Windows Hello (fingerprint / face / PIN) to unlock" Margin="0,0,0,12" Checked="OnToggleAllowPasskey" Unchecked="OnToggleAllowPasskey"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="TOTP authenticator secret" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="AboutTotpSecretBox" IsReadOnly="True" FontFamily="{StaticResource MonoFont}" FontSize="10.5" Margin="0,0,0,8"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Button Content="Copy URI" Style="{StaticResource SmallPillButton}" Margin="0,0,6,0" Click="OnCopyController2FaUriClick"/>
                                        <Button Content="Regenerate backup codes" Style="{StaticResource SmallPillButton}" Click="OnRegenerateBackupCodesClick"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Remember device (days)" Style="{StaticResource MetaText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBox x:Name="RememberDaysBox" FontFamily="{StaticResource MonoFont}" Text="30" Width="48" LostFocus="OnRememberDaysLostFocus"/>
                                    </StackPanel>
                                </StackPanel>
                                <Border Grid.Column="2" Background="{StaticResource QrBackgroundBrush}" CornerRadius="{StaticResource RadiusControl}" Padding="6" VerticalAlignment="Center">
                                    <Image x:Name="AboutQrImage" Width="108" Height="108" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                </Border>
                            </Grid>
                            <TextBlock Text="One-time backup codes" Style="{StaticResource FieldLabel}" Margin="0,12,0,4"/>
                            <TextBox x:Name="AboutBackupCodesBox" IsReadOnly="True" FontFamily="{StaticResource MonoFont}" FontSize="10.5"/>

                            <!-- Security diagnostics -->
                            <TextBlock Text="Unlock factors" Style="{StaticResource Caption}" Margin="0,16,0,4"/>
                            <TextBlock x:Name="SecurityDiagText" FontFamily="{StaticResource MonoFont}" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Button x:Name="TestHelloButton" Content="Test Windows Hello" Style="{StaticResource SmallPillButton}" Margin="0,0,6,0" Click="OnTestWindowsHelloClick"/>
                                <Button x:Name="ForgetDeviceButton" Content="Forget this device" Style="{StaticResource SmallPillButton}" Click="OnForgetDeviceClick"/>
                            </StackPanel>
                            <TextBlock x:Name="TestHelloResultText" Style="{StaticResource MetaText}" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,4,0,4"/>

                            <!-- Master password (optional fallback) -->
                            <TextBlock Text="Master password (optional fallback)" Style="{StaticResource Caption}" Margin="0,16,0,4"/>
                            <TextBlock Text="Current password, TOTP or backup code (leave empty to verify with Windows Hello):" Style="{StaticResource MetaText}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                            <PasswordBox x:Name="CurrentFactorBox" Margin="0,0,0,8"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="New password" Style="{StaticResource FieldLabel}"/>
                                    <PasswordBox x:Name="NewMasterPasswordBox"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Confirm" Style="{StaticResource FieldLabel}"/>
                                    <PasswordBox x:Name="ConfirmMasterPasswordBox"/>
                                </StackPanel>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Button x:Name="SetMasterPasswordButton" Content="Set / change password" Style="{StaticResource SmallPillButton}" Margin="0,0,6,0" Click="OnSetMasterPasswordClick"/>
                                <Button x:Name="ClearMasterPasswordButton" Content="Remove password" Style="{StaticResource SmallPillButton}" Click="OnClearMasterPasswordClick"/>
                            </StackPanel>
                            <TextBlock x:Name="MasterPasswordStatusText" Style="{StaticResource MetaText}" TextWrapping="Wrap" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>

                    <DockPanel Margin="0,0,0,16">
                        <TextBlock Text="Repository" Style="{StaticResource MetaText}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FontSizeSmall}" VerticalAlignment="Center">
                            <Hyperlink NavigateUri="https://github.com/dor2500/home-rms" RequestNavigate="OnOpenProjectLinkClick">https://github.com/dor2500/home-rms</Hyperlink>
                        </TextBlock>
                    </DockPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Copy agent --pin command" Style="{StaticResource GhostButton}" Click="OnCopyPinCommandClick"/>
                        <Button Grid.Column="2" Content="Done" Width="96" Style="{StaticResource PrimaryButton}" Click="OnCloseAboutClick"/>
                    </Grid>
                </StackPanel>
            </Border>
            </ScrollViewer>
        </Grid>

        <!-- ==================== AUTO-LOCK OVERLAY: Windows Hello -> TOTP / backup code -> master password ==================== -->
        <Grid x:Name="LockOverlay" Grid.RowSpan="2" Visibility="Collapsed" Background="{StaticResource LockScrimBrush}" Panel.ZIndex="100"
              KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Cycle">
            <Border Style="{StaticResource OverlayCard}" Width="392" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="28,24">
                <StackPanel>
                    <Border Width="44" Height="44" CornerRadius="{StaticResource RadiusOverlay}" Background="{StaticResource AccentSoftBrush}" HorizontalAlignment="Left" Margin="0,0,0,16">
                        <Path Style="{StaticResource VectorIcon}" Data="{StaticResource GeoLock}" Stroke="{StaticResource AccentBrush}" Width="20" Height="20" HorizontalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Console locked" Style="{StaticResource PageTitle}" Margin="0,0,0,6"/>
                    <TextBlock Text="Verify with Windows Hello, an authenticator or backup code, or your master password." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,20"/>

                    <Button x:Name="HelloUnlockButton" Content="Use Windows Hello" Style="{StaticResource PrimaryButton}" Height="36" Margin="0,0,0,6" Click="OnUnlockWithPasskeyClick"/>
                    <TextBlock x:Name="HelloStatusText" Text="Checking Windows Hello..." Style="{StaticResource MetaText}" TextWrapping="Wrap" Margin="0,0,0,20"/>

                    <TextBlock Text="Authenticator or backup code" Style="{StaticResource FieldLabel}"/>
                    <PasswordBox x:Name="UnlockPinBox" Height="34" Margin="0,0,0,8" KeyDown="OnUnlockPinBoxKeyDown"/>
                    <Button x:Name="UnlockCodeButton" Content="Unlock with code" Style="{StaticResource GhostButton}" Margin="0,0,0,16" Click="OnUnlockDashboardClick"/>

                    <StackPanel x:Name="MasterPasswordUnlockPanel" Visibility="Collapsed">
                        <TextBlock Text="Master password" Style="{StaticResource FieldLabel}"/>
                        <PasswordBox x:Name="UnlockPasswordBox" Height="34" Margin="0,0,0,8" KeyDown="OnUnlockPasswordBoxKeyDown"/>
                        <Button x:Name="UnlockPasswordButton" Content="Unlock with password" Style="{StaticResource GhostButton}" Margin="0,0,0,16" Click="OnUnlockWithPasswordClick"/>
                    </StackPanel>

                    <CheckBox x:Name="RememberDeviceCheck" Content="Remember this device (skip startup lock)" IsChecked="False" Margin="0,0,0,8"/>
                    <TextBlock x:Name="LockStatusText" Text="" FontSize="{StaticResource FontSizeCaption}" Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap" Visibility="Collapsed"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ==================== AGENT 2FA PAIRING MODAL ==================== -->
        <Grid x:Name="AgentPair2FaOverlay" Grid.RowSpan="2" Visibility="Collapsed" Background="{StaticResource ScrimBrush}">
            <Border Style="{StaticResource OverlayCard}" Width="400" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Endpoint 2FA pairing" Style="{StaticResource PageTitle}" FontSize="{StaticResource FontSizeTitle}" Margin="0,0,0,6"/>
                    <TextBlock x:Name="AgentPairPromptText" Text="Enter the 6-digit TOTP code displayed on the remote endpoint to pair with the Central Server." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,16"/>
                    <TextBox x:Name="Agent2FaCodeBox" FontFamily="{StaticResource MonoFont}" FontSize="20" TextAlignment="Center" Height="44" Margin="0,0,0,16"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Verify &amp; pair" Style="{StaticResource PrimaryButton}" Click="OnSubmitAgent2FaClick"/>
                        <Button Grid.Column="2" Content="Cancel" Style="{StaticResource GhostButton}" Click="OnCancelAgent2FaClick"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
