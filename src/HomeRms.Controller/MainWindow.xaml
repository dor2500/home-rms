                    <Border DockPanel.Dock="Bottom" Style="{StaticResource CardStyle}" Padding="10" Margin="0,10,0,0" Height="175">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <TextBox x:Name="DeployFilePathBox" Width="200" FontFamily="{StaticResource MonoFont}" FontSize="11" Margin="0,0,6,0" ToolTip="Custom .exe / .msi / .ps1 path"/>
                                    <TextBox x:Name="DeployArgsBox" Width="90" FontFamily="{StaticResource MonoFont}" FontSize="11" Text="AUTO" Margin="0,0,6,0"/>
                                    <Button Content="Browse" Style="{StaticResource SmallPillButton}" Margin="0,0,4,0" Click="OnBrowseDeployFileClick"/>
                                    <Button x:Name="DeployRunBtn" Content="Run File" Style="{StaticResource SmallPillButton}" Margin="0,0,4,0" Click="OnStartDeployClick"/>
                                    <Button Content="Run Script" Style="{StaticResource SmallPillButton}" Margin="0,0,4,0" Click="OnUploadAndRunScriptClick"/>
                                    <Button Content="Clear" Style="{StaticResource SmallPillButton}" Click="OnClearDeployLogClick"/>
                                </StackPanel>
                                <TextBlock Text="DEPLOYMENT QUEUE &amp; LIVE LOG" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0"/>
                            </DockPanel>
                            <TextBox x:Name="DeployOutputBox" IsReadOnly="True" Background="{StaticResource FieldBrush}" Foreground="#E2E8F0" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="10,8"
