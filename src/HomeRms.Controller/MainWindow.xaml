<Window x:Class="HomeRms.Controller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Home RMS — Fleet Command Center" Height="840" Width="1360"
        MinHeight="680" MinWidth="1020"
        Icon="Assets/controller.ico"
        PreviewKeyDown="OnWindowPreviewKeyDown"
        PreviewKeyUp="OnWindowPreviewKeyUp"
        WindowStartupLocation="CenterScreen">

    <Grid Background="{StaticResource DeepBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ==================== TOP GLOBAL COMMAND BAR ==================== -->
        <Border x:Name="TopBarBorder" Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="18,11">
            <DockPanel>
                <!-- Right Action Cluster -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#131824" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="11,6" Margin="0,0,10,0" VerticalAlignment="Center">
                        <TextBlock Text="🔒 mTLS PKI" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                    </Border>
                    <Button x:Name="ProbeBtn" Content="↻ Scan LAN" Style="{StaticResource GhostButton}"
                            Padding="12,7" Margin="0,0,10,0" Click="OnProbeMachinesClick"/>
                    <Button x:Name="ConnectBtn" Content="Connect" Width="128"
                            Style="{StaticResource PrimaryButton}" Click="OnConnectClick"/>
                </StackPanel>

                <!-- Left Brand + Active Machine Switcher -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="Assets/controller.png" Width="34" Height="34" Margin="0,0,12,0"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,22,0">
                        <TextBlock Text="HOME RMS" FontSize="14.5" FontWeight="Bold"/>
                        <TextBlock Text="Fleet Command" FontSize="10.5" Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>

                    <!-- Machine Selector Pill -->
                    <Border Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1" CornerRadius="9" Padding="10,4" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Target:" FontSize="11.5" Foreground="{StaticResource MutedBrush}"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="MachineSwitcher" Width="230" Background="Transparent"
                                      Foreground="{StaticResource TextBrush}" BorderThickness="0"
                                      DisplayMemberPath="DisplayTitle"
                                      SelectionChanged="OnMachineSwitcherChanged"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="ConnBadgeBorder" Background="#256B7280" CornerRadius="7"
                            Padding="10,4" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock x:Name="ConnBadgeText" Text="Disconnected" FontSize="11"
                                   FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                    </Border>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TargetTitleText" Text="No active session" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock x:Name="StatusText" Text="Select a machine in Fleet or Scan LAN to connect."
                                   FontSize="11" Foreground="{StaticResource MutedBrush}" MaxWidth="360" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ==================== MAIN BODY: SLIM ICON RAIL + WORKSPACE ==================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="RailColumn" Width="76"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Slim Left Icon Rail -->
            <Border x:Name="RailBorder" Grid.Column="0" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0" Padding="0,12">
                <StackPanel>
                    <RadioButton x:Name="NavFleet" Style="{StaticResource RailTab}" IsChecked="True" Checked="OnNavTabChanged">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="🌐" FontSize="19" HorizontalAlignment="Center"/>
                            <TextBlock Text="Fleet" FontSize="10.5" Margin="0,3,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavDesktop" Style="{StaticResource RailTab}" Checked="OnNavTabChanged">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="🖥️" FontSize="19" HorizontalAlignment="Center"/>
                            <TextBlock Text="Desktop" FontSize="10.5" Margin="0,3,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavInventory" Style="{StaticResource RailTab}" Checked="OnNavTabChanged">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="📊" FontSize="19" HorizontalAlignment="Center"/>
                            <TextBlock Text="Monitor" FontSize="10.5" Margin="0,3,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavShell" Style="{StaticResource RailTab}" Checked="OnNavTabChanged">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="⌨️" FontSize="19" HorizontalAlignment="Center"/>
                            <TextBlock Text="Shell" FontSize="10.5" Margin="0,3,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavDeploy" Style="{StaticResource RailTab}" Checked="OnNavTabChanged">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="📦" FontSize="19" HorizontalAlignment="Center"/>
                            <TextBlock Text="Deploy" FontSize="10.5" Margin="0,3,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavUpdates" Style="{StaticResource RailTab}" Checked="OnNavTabChanged">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="🔄" FontSize="19" HorizontalAlignment="Center"/>
                            <TextBlock Text="Updates" FontSize="10.5" Margin="0,3,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavSystem" Style="{StaticResource RailTab}" Checked="OnNavTabChanged">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="⚙️" FontSize="19" HorizontalAlignment="Center"/>
                            <TextBlock Text="Settings" FontSize="10.5" Margin="0,3,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Border>

            <!-- Workspace Area -->
            <Grid x:Name="WorkspaceGrid" Grid.Column="1" Background="{StaticResource BgBrush}" Margin="20,16,20,18">

                <!-- ==================== 1. FLEET OVERVIEW (HOME) ==================== -->
                <DockPanel x:Name="FleetPanel" Visibility="Visible">
                    <!-- Add / Edit Endpoint Bar -->
                    <Border DockPanel.Dock="Top" Style="{StaticResource CardStyle}" Padding="16,14" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="DISPLAY NAME" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                                <TextBox x:Name="NameBox" Text="Living Room PC"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="HOST / LAN IP" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                                <TextBox x:Name="HostBox" Text="localhost"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="PORT" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                                <TextBox x:Name="PortBox" Text="7443"/>
                            </StackPanel>
                            <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Bottom">
                                <Button Content="+ Save Endpoint" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="OnSaveMachineClick"/>
                                <Button Content="Remove" Style="{StaticResource GhostButton}" Click="OnRemoveMachineClick"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Fleet Cards Grid -->
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <TextBlock Text="MANAGED LAN FLEET  (DOUBLE-CLICK ANY CARD TO CONNECT)" Style="{StaticResource Caption}" Margin="0"/>
                    </DockPanel>

                    <ListBox x:Name="MachinesList" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="OnMachineSelectionChanged"
                             MouseDoubleClick="OnMachineDoubleClick">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel IsItemsHost="True"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,14,14"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="CardBd" Width="300" Background="{StaticResource CardBrush}"
                                                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                                    CornerRadius="14" Padding="18">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="CardBd" Property="Background" Value="{StaticResource CardHoverBrush}"/>
                                                    <Setter TargetName="CardBd" Property="BorderBrush" Value="#38425E"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="CardBd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                    <Setter TargetName="CardBd" Property="Background" Value="#142033"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,10">
                                        <Border DockPanel.Dock="Right" Background="{Binding BadgeBackground}" CornerRadius="6" Padding="9,3">
                                            <TextBlock Text="{Binding StatusLabel}" FontSize="10.5" FontWeight="SemiBold"/>
                                        </Border>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="10" Height="10" Fill="{Binding DotBrush}" Margin="0,0,10,0"/>
                                            <TextBlock Text="{Binding DisplayTitle}" FontSize="15" FontWeight="Bold" TextTrimming="CharacterEllipsis" MaxWidth="165"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <TextBlock Text="{Binding Address}" FontSize="12" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding UserAndOs}" FontSize="11.5" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <!-- ==================== 2. REMOTE DESKTOP VIEW ==================== -->
                <DockPanel x:Name="DesktopPanel" Visibility="Collapsed">
                    <Border x:Name="DesktopToolbarBorder" DockPanel.Dock="Top" Style="{StaticResource CardStyle}" Padding="14,10" Margin="0,0,0,12">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="📋 Paste" Style="{StaticResource SmallPillButton}" Margin="0,0,6,0" Click="OnSendClipboardClick"/>
                                <Button Content="📥 Copy" Style="{StaticResource SmallPillButton}" Margin="0,0,10,0" Click="OnGetClipboardClick"/>
                                <Border Background="#0B0D14" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                        CornerRadius="7" Padding="10,5" Margin="0,0,10,0">
                                    <TextBlock x:Name="StreamStatus" Text="Idle" FontSize="11.5" Foreground="{StaticResource MutedBrush}"/>
                                </Border>
                                <Button x:Name="FullScreenBtn" Content="⛶ Full Screen (F11)" Style="{StaticResource GhostButton}" Padding="11,6" Click="OnToggleFullScreenClick"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="StreamBtn" Content="▶ Start Stream" Width="136" Style="{StaticResource PrimaryButton}" Padding="12,7" Click="OnToggleStream"/>
                                <CheckBox x:Name="ControlCheck" Content="Control + Copy/Paste" Margin="14,0,0,0" Checked="OnControlCheckChanged" Unchecked="OnControlCheckChanged"/>
                                <Border Width="1" Height="20" Background="{StaticResource LineBrush}" Margin="14,0"/>
                                <TextBlock Text="FPS:" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBox x:Name="FpsBox" Text="20" Width="40" Margin="0,0,10,0"/>
                                <TextBlock Text="Quality:" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBox x:Name="QualityBox" Text="65" Width="40" Margin="0,0,10,0"/>
                                <ComboBox x:Name="ScaleBox" Width="114" SelectedIndex="0" Margin="0,0,8,0" Background="#0C0F17" Foreground="#F8FAFC" BorderBrush="#23293B">
                                    <ComboBoxItem Content="1080p (Fast)" Tag="1920"/>
                                    <ComboBoxItem Content="720p (Ultra)" Tag="1280"/>
                                    <ComboBoxItem Content="Native (Full)" Tag="0"/>
                                </ComboBox>
                                <ComboBox x:Name="UpscaleBox" Width="92" SelectedIndex="0" SelectionChanged="OnUpscaleModeChanged" Background="#0C0F17" Foreground="#F8FAFC" BorderBrush="#23293B">
                                    <ComboBoxItem Content="Sharp+" Tag="cas"/>
                                    <ComboBoxItem Content="Sharp" Tag="bicubic"/>
                                    <ComboBoxItem Content="Off" Tag="none"/>
                                </ComboBox>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border x:Name="ScreenCanvasBorder" Background="#050609" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="14" ClipToBounds="True">
                        <Grid>
                            <Grid x:Name="SharpenHost">
                                <Image x:Name="ScreenImage" Stretch="Uniform" Focusable="True"
                                       SizeChanged="OnScreenImageSizeChanged"
                                       MouseMove="OnScreenMouseMove" MouseDown="OnScreenMouseDown" MouseUp="OnScreenMouseUp"
                                       MouseWheel="OnScreenMouseWheel" KeyDown="OnScreenKeyDown" KeyUp="OnScreenKeyUp"/>
                            </Grid>
                            <Canvas x:Name="CursorLayer" IsHitTestVisible="False">
                                <Image x:Name="RemoteCursorImage" Stretch="None" Visibility="Collapsed"/>
                            </Canvas>

                            <Border x:Name="FullscreenHud" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="0,14,18,0" Background="#D90E1118" BorderBrush="{StaticResource LineBrush}"
                                    BorderThickness="1" CornerRadius="10" Padding="12,7">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="FullscreenHudText" Text="Full Screen" Foreground="#F8FAFC" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <Button x:Name="HudUpscaleBtn" Style="{StaticResource SmallPillButton}" Margin="0,0,6,0" Click="OnHudUpscaleClick">
                                        <TextBlock x:Name="HudUpscaleText" Text="Sharp+"/>
                                    </Button>
                                    <Button Content="📋 Paste" Style="{StaticResource SmallPillButton}" Margin="0,0,6,0" Click="OnSendClipboardClick"/>
                                    <Button Content="📥 Copy" Style="{StaticResource SmallPillButton}" Margin="0,0,8,0" Click="OnGetClipboardClick"/>
                                    <Button Content="⛶ Exit (Esc)" Style="{StaticResource SmallPillButton}" Margin="0,0,8,0" Click="OnToggleFullScreenClick"/>
                                    <Button Content="⏹ Stop" Style="{StaticResource DangerButton}" Padding="10,4" FontSize="11.5" Click="OnToggleStream"/>
                                </StackPanel>
                            </Border>

                            <StackPanel x:Name="DesktopOverlay" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="🖥️  Remote Desktop Canvas" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock Text="Click 'Start Stream' above or press F11 for Full Screen. Consent prompt appears on the target PC."
                                           Foreground="{StaticResource MutedBrush}" FontSize="12.5" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DockPanel>

                <!-- ==================== 3. MONITOR & INVENTORY VIEW ==================== -->
                <DockPanel x:Name="InventoryPanel" Visibility="Collapsed">
                    <UniformGrid DockPanel.Dock="Top" Columns="4" Margin="0,0,0,14">
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="PROCESSOR" Style="{StaticResource Caption}"/>
                                <TextBlock x:Name="CpuValueText" Text="—" Style="{StaticResource ValueText}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="CpuSubText" Text="Connect to inspect" FontSize="11.5" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}" Margin="4,0,4,0">
                            <StackPanel>
                                <TextBlock Text="MEMORY" Style="{StaticResource Caption}"/>
                                <TextBlock x:Name="RamValueText" Text="—" Style="{StaticResource ValueText}"/>
                                <TextBlock x:Name="RamSubText" Text="RAM &amp; processes" FontSize="11.5" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}" Margin="4,0,4,0">
                            <StackPanel>
                                <TextBlock Text="GRAPHICS" Style="{StaticResource Caption}"/>
                                <TextBlock x:Name="GpuValueText" Text="—" Style="{StaticResource ValueText}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="GpuSubText" Text="Display adapter" FontSize="11.5" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="STORAGE" Style="{StaticResource Caption}"/>
                                <TextBlock x:Name="DiskValueText" Text="—" Style="{StaticResource ValueText}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="DiskSubText" Text="Fixed drives" FontSize="11.5" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <Button x:Name="RefreshInvBtn" DockPanel.Dock="Right" Content="↻ Refresh" Style="{StaticResource PrimaryButton}" Click="OnRefreshInventory" Padding="14,7"/>
                        <TextBlock x:Name="InventoryTimestampText" DockPanel.Dock="Right" Text="" Foreground="{StaticResource MutedBrush}" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Filter:" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox x:Name="SearchBox" Width="300" TextChanged="OnSearchChanged"/>
                        </StackPanel>
                    </DockPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.15*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="0.85*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="0">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" Padding="14,10" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right" Background="#1F38BDF8" CornerRadius="6" Padding="8,2">
                                            <TextBlock x:Name="AppsCountText" Text="0 apps" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                                        </Border>
                                        <TextBlock Text="INSTALLED APPLICATIONS" Style="{StaticResource Caption}" Margin="0"/>
                                    </DockPanel>
                                </Border>
                                <DataGrid x:Name="AppsGrid">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Application" Binding="{Binding Name}" Width="2*"/>
                                        <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="110"/>
                                        <DataGridTextColumn Header="Publisher" Binding="{Binding Publisher}" Width="1.2*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="0">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" Padding="14,10" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Button Content="✕ End Process" Style="{StaticResource SmallPillButton}" Margin="0,0,8,0" Click="OnKillSelectedProcessClick"/>
                                            <Border Background="#1F10B981" CornerRadius="6" Padding="8,2" VerticalAlignment="Center">
                                                <TextBlock x:Name="ProcsCountText" Text="0 procs" FontSize="11" FontWeight="SemiBold" Foreground="#34D399"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="RUNNING PROCESSES" Style="{StaticResource Caption}" Margin="0" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </Border>
                                <DataGrid x:Name="ProcGrid">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="68"/>
                                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                                        <DataGridTextColumn Header="RAM (MB)" Binding="{Binding MemoryMb}" Width="88"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>
                    </Grid>
                </DockPanel>

                <!-- ==================== 4. REMOTE SHELL VIEW ==================== -->
                <DockPanel x:Name="ShellPanel" Visibility="Collapsed">
                    <Border DockPanel.Dock="Top" Style="{StaticResource CardStyle}" Padding="14,10" Margin="0,0,0,12">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Clear" Style="{StaticResource SmallPillButton}" Click="OnClearShellClick"/>
                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="QUICK:" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <Button Content="whoami" Tag="whoami; hostname; $PSVersionTable.PSVersion.ToString()" Style="{StaticResource SmallPillButton}" Margin="0,0,6,0" Click="OnQuickCommandClick"/>
                                <Button Content="IP Config" Tag="Get-NetIPAddress -AddressFamily IPv4 | Select-Object InterfaceAlias, IPAddress | Format-Table -AutoSize" Style="{StaticResource SmallPillButton}" Margin="0,0,6,0" Click="OnQuickCommandClick"/>
                                <Button Content="Top CPU" Tag="Get-Process | Sort-Object CPU -Descending | Select-Object -First 10 Id, ProcessName, @{N='CPU(s)';E={[math]::Round($_.CPU,1)}}, @{N='RAM(MB)';E={[math]::Round($_.WorkingSet64/1MB,1)}} | Format-Table -AutoSize" Style="{StaticResource SmallPillButton}" Margin="0,0,6,0" Click="OnQuickCommandClick"/>
                                <Button Content="Disks" Tag="Get-PSDrive -PSProvider FileSystem | Select-Object Name, @{N='Used(GB)';E={[math]::Round($_.Used/1GB,1)}}, @{N='Free(GB)';E={[math]::Round($_.Free/1GB,1)}} | Format-Table -AutoSize" Style="{StaticResource SmallPillButton}" Margin="0,0,6,0" Click="OnQuickCommandClick"/>
                                <Button Content="Uptime" Tag="(Get-Date) - (Get-CimInstance Win32_OperatingSystem).LastBootUpTime | Select-Object Days, Hours, Minutes | Format-List" Style="{StaticResource SmallPillButton}" Click="OnQuickCommandClick"/>
                            </WrapPanel>
                        </DockPanel>
                    </Border>

                    <Border DockPanel.Dock="Bottom" Style="{StaticResource CardStyle}" Padding="10" Margin="0,12,0,0">
                        <DockPanel>
                            <Button x:Name="ShellSendBtn" DockPanel.Dock="Right" Content="Run" Width="110" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" Click="OnShellSend"/>
                            <Border DockPanel.Dock="Left" Background="#172033" CornerRadius="7" Padding="10,6" Margin="0,0,10,0">
                                <TextBlock Text="PS &gt;" FontFamily="Cascadia Mono, Consolas" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                            </Border>
                            <TextBox x:Name="ShellInputBox" FontFamily="Cascadia Mono, Consolas" FontSize="13" KeyDown="OnShellInputKeyDown"/>
                        </DockPanel>
                    </Border>

                    <Border Background="#07090F" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="14" Padding="4">
                        <TextBox x:Name="ShellOutput" IsReadOnly="True" Background="Transparent" Foreground="#E2E8F0" BorderThickness="0" Padding="14,12"
                                 FontFamily="Cascadia Mono, Consolas" FontSize="12.5" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" AcceptsReturn="True"/>
                    </Border>
                </DockPanel>

                <!-- ==================== 5. SILENT DEPLOY VIEW ==================== -->
                <DockPanel x:Name="DeployPanel" Visibility="Collapsed" AllowDrop="True" PreviewDragOver="OnDeployDragOver" Drop="OnDeployFileDrop">
                    <Border DockPanel.Dock="Top" Style="{StaticResource CardStyle}" Padding="18,16" Margin="0,0,0,14">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <Border DockPanel.Dock="Right" Background="#1F38BDF8" CornerRadius="6" Padding="10,3">
                                    <TextBlock x:Name="DeployStatusBadge" Text="Ready" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="SILENT INSTALLER DEPLOY (.EXE / .MSI / .MSP / .PS1)" Style="{StaticResource Caption}" Margin="0,0,0,3"/>
                                    <TextBlock Text="Drag &amp; drop any installer here or browse to stream it over mTLS and install silently." FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                                </StackPanel>
                            </DockPanel>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Installer File" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="DeployFilePathBox"/>
                                </StackPanel>
                                <Button Grid.Column="2" Content="📂 Browse…" Style="{StaticResource GhostButton}" VerticalAlignment="Bottom" Click="OnBrowseDeployFileClick"/>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Silent Flags (AUTO)" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="DeployArgsBox" Text="AUTO"/>
                                </StackPanel>
                                <Button x:Name="DeployRunBtn" Grid.Column="6" Content="🚀 Install Silently" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom" Click="OnStartDeployClick"/>
                            </Grid>

                            <WrapPanel>
                                <Button Content="AUTO" Tag="AUTO" Style="{StaticResource SmallPillButton}" Margin="0,0,6,0" Click="OnDeployPresetFlagClick"/>
                                <Button Content="NSIS (/S)" Tag="/S" Style="{StaticResource SmallPillButton}" Margin="0,0,6,0" Click="OnDeployPresetFlagClick"/>
                                <Button Content="Inno (/VERYSILENT)" Tag="/VERYSILENT /SUPPRESSMSGBOXES /NORESTART /SP-" Style="{StaticResource SmallPillButton}" Margin="0,0,6,0" Click="OnDeployPresetFlagClick"/>
                                <Button Content="MSI (/qn /norestart)" Tag="/qn /norestart" Style="{StaticResource SmallPillButton}" Margin="0,0,6,0" Click="OnDeployPresetFlagClick"/>
                                <Button Content="WiX (/quiet /norestart)" Tag="/quiet /norestart" Style="{StaticResource SmallPillButton}" Click="OnDeployPresetFlagClick"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border DockPanel.Dock="Top" Style="{StaticResource CardStyle}" Padding="14,10" Margin="0,0,0,14">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Clear" Style="{StaticResource SmallPillButton}" Click="OnClearDeployLogClick"/>
                            <WrapPanel VerticalAlignment="Center">
                                <TextBlock Text="WINGET 1-CLICK:" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <Button Content="7-Zip" Tag="7zip.7zip" Style="{StaticResource SmallPillButton}" Margin="0,0,6,0" Click="OnWingetQuickInstallClick"/>
                                <Button Content="Chrome" Tag="Google.Chrome" Style="{StaticResource SmallPillButton}" Margin="0,0,6,0" Click="OnWingetQuickInstallClick"/>
                                <Button Content="Firefox" Tag="Mozilla.Firefox" Style="{StaticResource SmallPillButton}" Margin="0,0,6,0" Click="OnWingetQuickInstallClick"/>
                                <Button Content="VLC" Tag="VideoLAN.VLC" Style="{StaticResource SmallPillButton}" Margin="0,0,6,0" Click="OnWingetQuickInstallClick"/>
                                <Button Content="Notepad++" Tag="Notepad++.Notepad++" Style="{StaticResource SmallPillButton}" Margin="0,0,6,0" Click="OnWingetQuickInstallClick"/>
                                <Button Content="VS Code" Tag="Microsoft.VisualStudioCode" Style="{StaticResource SmallPillButton}" Click="OnWingetQuickInstallClick"/>
                            </WrapPanel>
                        </DockPanel>
                    </Border>

                    <Border Background="#07090F" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="14" Padding="4">
                        <TextBox x:Name="DeployOutputBox" IsReadOnly="True" Background="Transparent" Foreground="#E2E8F0" BorderThickness="0" Padding="14,12"
                                 FontFamily="Cascadia Mono, Consolas" FontSize="12.5" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" AcceptsReturn="True"/>
                    </Border>
                </DockPanel>

                <!-- ==================== 6. WINDOWS 11 SETTINGS & UPDATES VIEW ==================== -->
                <Grid x:Name="SystemPanel" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="228"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="12">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                <TextBlock Text="WINDOWS SETTINGS" Style="{StaticResource Caption}" Margin="2,0,0,6"/>
                                <TextBox x:Name="SettingsSearchBox" TextChanged="OnSettingsSearchChanged"/>
                            </StackPanel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="Win11SidebarPanel"/>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <DockPanel Grid.Column="2" LastChildFill="True">
                        <Border DockPanel.Dock="Top" Style="{StaticResource CardStyle}" Padding="16,12" Margin="0,0,0,12">
                            <DockPanel>
                                <Border x:Name="SystemAdminBadge" DockPanel.Dock="Right" Background="#24F59E0B" CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                                    <TextBlock x:Name="SystemAdminText" Text="⚠ Agent: Standard User" FontSize="11.5" FontWeight="SemiBold" Foreground="#FBBF24"/>
                                </Border>
                                <StackPanel>
                                    <TextBlock x:Name="Win11PageTitle" Text="Home" FontSize="18" FontWeight="Bold"/>
                                    <TextBlock x:Name="Win11PageSubtitle" Text="Device overview and remote settings" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Border DockPanel.Dock="Top" Style="{StaticResource CardStyle}" Padding="14,10" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.4*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock x:Name="SystemTargetLabel" Text="Target" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="SystemTargetBox"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock x:Name="SystemExtraLabel" Text="Extra" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="SystemExtraBox"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border DockPanel.Dock="Bottom" Background="#07090F" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="14" Padding="4" Height="210" Margin="0,12,0,0">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="12,8,12,6">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <TextBlock Text="Filter:" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBox x:Name="SystemFilterBox" Width="170" TextChanged="OnSystemFilterChanged"/>
                                    </StackPanel>
                                    <TextBlock x:Name="SystemMessageText" Text="Click any setting action above to execute on the remote PC." Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                                <TextBlock x:Name="SystemHeaderText" DockPanel.Dock="Top" FontFamily="Cascadia Mono, Consolas" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="12,0,12,4"/>
                                <ListBox x:Name="SystemRowsList" Background="Transparent" BorderThickness="0" FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="#E2E8F0" SelectionChanged="OnSystemRowSelected"/>
                            </DockPanel>
                        </Border>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="Win11CardsPanel"/>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>

            </Grid>
        </Grid>
    </Grid>
</Window>
