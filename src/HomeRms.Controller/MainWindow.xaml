<Window x:Class="HomeRms.Controller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Home RMS — Central Operations Console" Height="840" Width="1360"
        MinHeight="680" MinWidth="1020"
        Icon="Assets/controller.ico"
        PreviewMouseDown="OnDashboardActivity"
        PreviewKeyDown="OnWindowPreviewKeyDown"
        PreviewKeyUp="OnWindowPreviewKeyUp"
        WindowStartupLocation="CenterScreen">

    <Grid Background="{StaticResource DeepBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ==================== TOP GLOBAL COMMAND BAR ==================== -->
        <Border x:Name="TopBarBorder" Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="14,8">
            <DockPanel LastChildFill="True">
                <!-- Right Global Action Cluster -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <!-- Central Hub & Relay Status Pill -->
                    <Button x:Name="MobileHubBtn" Style="{StaticResource SmallPillButton}" Margin="0,0,6,0"
                            ToolTip="Open Central Relay Mobile Web App in browser" Click="OnOpenMobileHubClick">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="{StaticResource OkBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="HubRelayStatusText" Text="HUB RELAY :7480" FontFamily="{StaticResource MonoFont}"
                                       FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                        </StackPanel>
                    </Button>

                    <!-- Alert Center Bell -->
                    <Button x:Name="AlertBellBtn" Style="{StaticResource SmallPillButton}" Margin="0,0,6,0"
                            ToolTip="Open Client Health &amp; Alert Center" Click="OnOpenAlertCenterClick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="ALERTS" FontFamily="{StaticResource MonoFont}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="0,0,5,0"/>
                            <Border x:Name="AlertBadgeBorder" Background="#223B82F6" CornerRadius="3" Padding="5,1">
                                <TextBlock x:Name="AlertBadgeText" Text="0" FontFamily="{StaticResource MonoFont}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                            </Border>
                        </StackPanel>
                    </Button>

                    <!-- mTLS Status Pill -->
                    <Border Background="#111317" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                            CornerRadius="5" Padding="9,5" Margin="0,0,8,0" VerticalAlignment="Center"
                            ToolTip="All endpoint sessions use Mutual-TLS (X.509 PKI)">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="{StaticResource AccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="mTLS PKI" FontFamily="{StaticResource MonoFont}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                    </Border>

                    <Button x:Name="ProbeBtn" Content="Scan LAN" Style="{StaticResource GhostButton}"
                            Padding="10,5" Margin="0,0,6,0" Click="OnProbeMachinesClick"/>
                    <Button x:Name="UpdateBtn" Content="Updates" Style="{StaticResource SmallPillButton}"
                            Margin="0,0,6,0" ToolTip="Check GitHub Releases (dor2500/home-rms) for updates"
                            Click="OnCheckOrApplyUpdateClick"/>
                    <Button Content="Lock" Style="{StaticResource SmallPillButton}"
                            Margin="0,0,8,0" ToolTip="Lock Console (15m inactivity lock active)"
                            Click="OnLockDashboardClick"/>
                    <Button x:Name="AddEndpointTopBtn" Content="+ Add Endpoint" Style="{StaticResource PrimaryButton}"
                            Padding="12,5" Click="OnOpenAddEndpointDrawerClick"/>
                </StackPanel>

                <!-- Left Brand + Sidebar Toggle + Global Fleet Status -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="SidebarToggleBtn" Style="{StaticResource GhostButton}"
                            Width="30" Height="28" Padding="0" Margin="0,0,10,0"
                            ToolTip="Collapse / Expand Navigation Sidebar" Click="OnToggleSidebarClick">
                        <Path Style="{StaticResource VectorIcon}" Data="{StaticResource GeoSidebar}" Width="14" Height="14"/>
                    </Button>
                    <Border Width="24" Height="24" CornerRadius="4" Background="#1E232E"
                            BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Margin="0,0,9,0">
                        <TextBlock Text="HR" FontFamily="{StaticResource MonoFont}" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                        <TextBlock Text="HOME RMS" FontSize="12.5" FontWeight="Bold"/>
                        <TextBlock Text="CENTRAL SERVER &amp; CONSOLE" FontFamily="{StaticResource MonoFont}" FontSize="9.5" Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>

                    <Border x:Name="ConnBadgeBorder" Background="#183B82F6" BorderBrush="#333B82F6" BorderThickness="1"
                            CornerRadius="4" Padding="8,3" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock x:Name="ConnBadgeText" Text="STANDBY" FontFamily="{StaticResource MonoFont}" FontSize="10.5"
                                   FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                    </Border>
                </StackPanel>

                <!-- Center Global Status Readout -->
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TargetTitleText" Text="Central Operations Hub" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="StatusText" Text="Central Relay ready. Scan LAN or select an endpoint in Fleet to open a tunnel."
                               FontFamily="{StaticResource MonoFont}" FontSize="10.5" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ==================== MAIN BODY: COLLAPSIBLE SIDEBAR + WORKSPACE ==================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="RailColumn" Width="192"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Linear-Style Collapsible Navigation Rail -->
            <Border x:Name="RailBorder" Grid.Column="0" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0" Padding="0,10">
                <DockPanel>
                    <TextBlock x:Name="SidebarSectionLabel" DockPanel.Dock="Top" Text="WORKSPACE"
                               Style="{StaticResource Caption}" Margin="16,0,0,6"/>

                    <StackPanel DockPanel.Dock="Bottom" Margin="8,8,8,0">
                        <Button Style="{StaticResource GhostButton}" Padding="10,7" Margin="0,0,0,6"
                                HorizontalContentAlignment="Left" ToolTip="Server Identity &amp; 2FA Settings" Click="OnOpenAboutClick">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Style="{StaticResource VectorIcon}" Data="{StaticResource GeoInfo}" Stroke="{StaticResource MutedBrush}"/>
                                <TextBlock x:Name="NavLabelAbout" Text="Server &amp; PKI" FontSize="12" FontWeight="Medium" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Border Background="#111317" BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1" CornerRadius="5" Padding="10,7">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="6" Height="6" Fill="{StaticResource OkBrush}" Margin="0,0,8,0"/>
                                <TextBlock x:Name="SidebarFooterText" Text="HUB RELAY ONLINE" FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel>
                        <RadioButton x:Name="NavOverview" Style="{StaticResource RailTab}" IsChecked="True" Checked="OnNavTabChanged" ToolTip="Overview Dashboard">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Style="{StaticResource VectorIcon}" Data="{StaticResource GeoOverview}"/>
                                <TextBlock x:Name="NavLabelOverview" Text="Overview" FontSize="12" FontWeight="Medium" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavFleet" Style="{StaticResource RailTab}" Checked="OnNavTabChanged" ToolTip="Managed LAN Fleet">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Style="{StaticResource VectorIcon}" Data="{StaticResource GeoFleet}"/>
                                <TextBlock x:Name="NavLabelFleet" Text="Endpoints" FontSize="12" FontWeight="Medium" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavDesktop" Style="{StaticResource RailTab}" Checked="OnNavTabChanged" ToolTip="Remote Desktop Stream">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Style="{StaticResource VectorIcon}" Data="{StaticResource GeoDesktop}"/>
                                <TextBlock x:Name="NavLabelDesktop" Text="Remote Desktop" FontSize="12" FontWeight="Medium" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavInventory" Style="{StaticResource RailTab}" Checked="OnNavTabChanged" ToolTip="System Monitor &amp; Processes">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Style="{StaticResource VectorIcon}" Data="{StaticResource GeoMonitor}"/>
                                <TextBlock x:Name="NavLabelMonitor" Text="Inventory &amp; Procs" FontSize="12" FontWeight="Medium" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavShell" Style="{StaticResource RailTab}" Checked="OnNavTabChanged" ToolTip="Remote PowerShell Terminal">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Style="{StaticResource VectorIcon}" Data="{StaticResource GeoShell}"/>
                                <TextBlock x:Name="NavLabelShell" Text="PowerShell" FontSize="12" FontWeight="Medium" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavDeploy" Style="{StaticResource RailTab}" Checked="OnNavTabChanged" ToolTip="Silent Software &amp; Script Deploy">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Style="{StaticResource VectorIcon}" Data="{StaticResource GeoDeploy}"/>
                                <TextBlock x:Name="NavLabelDeploy" Text="Deploy" FontSize="12" FontWeight="Medium" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavUpdates" Style="{StaticResource RailTab}" Checked="OnNavTabChanged" ToolTip="Remote Windows Updates">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Style="{StaticResource VectorIcon}" Data="{StaticResource GeoUpdates}"/>
                                <TextBlock x:Name="NavLabelUpdates" Text="Windows Update" FontSize="12" FontWeight="Medium" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavSystem" Style="{StaticResource RailTab}" Checked="OnNavTabChanged" ToolTip="Remote System &amp; Settings">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Style="{StaticResource VectorIcon}" Data="{StaticResource GeoSettings}"/>
                                <TextBlock x:Name="NavLabelSettings" Text="System &amp; Settings" FontSize="12" FontWeight="Medium" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavFiles" Style="{StaticResource RailTab}" Checked="OnNavTabChanged" ToolTip="Remote File Manager">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Style="{StaticResource VectorIcon}" Data="{StaticResource GeoDeploy}"/>
                                <TextBlock x:Name="NavLabelFiles" Text="Files" FontSize="12" FontWeight="Medium" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavServices" Style="{StaticResource RailTab}" Checked="OnNavTabChanged" ToolTip="Services &amp; Scheduled Tasks">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Style="{StaticResource VectorIcon}" Data="{StaticResource GeoSettings}"/>
                                <TextBlock x:Name="NavLabelServices" Text="Services &amp; Tasks" FontSize="12" FontWeight="Medium" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavScripts" Style="{StaticResource RailTab}" Checked="OnNavTabChanged" ToolTip="Script Library &amp; Multi-Endpoint Runs">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Style="{StaticResource VectorIcon}" Data="{StaticResource GeoShell}"/>
                                <TextBlock x:Name="NavLabelScripts" Text="Script Library" FontSize="12" FontWeight="Medium" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavWebUi" Style="{StaticResource RailTab}" Checked="OnNavTabChanged" Visibility="Collapsed" ToolTip="Embedded Reverse-Proxied Web UI">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Style="{StaticResource VectorIcon}" Data="{StaticResource GeoDesktop}"/>
                                <TextBlock x:Name="NavLabelWebUi" Text="Web UI (Proxy)" FontSize="12" FontWeight="Medium" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Workspace Area -->
            <Grid x:Name="WorkspaceGrid" Grid.Column="1" Background="{StaticResource BgBrush}" Margin="18,14,18,14">

                <!-- ==================== 0. OVERVIEW DASHBOARD (LANDING) ==================== -->
                <DockPanel x:Name="OverviewPanel" Visibility="Visible">
                    <!-- Top Header -->
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Content="View All Endpoints" Style="{StaticResource GhostButton}"
                                Padding="11,5" Click="OnGoToFleetClick"/>
                        <StackPanel>
                            <TextBlock Text="CENTRAL HUB // OPERATIONS OVERVIEW" Style="{StaticResource Caption}" Margin="0,0,0,2"/>
                            <TextBlock Text="Central Server relay metrics, fleet health telemetry, and audit trail" FontSize="11.5" Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Macro KPI Strip -->
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="ENDPOINTS ONLINE" Style="{StaticResource Caption}"/>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                    <TextBlock x:Name="KpiOnlineCount" Text="0 / 0" FontFamily="{StaticResource MonoFont}" FontSize="20" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="KpiOfflineSub" Text="0 offline" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="10,0,0,2"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="ACTIVE TUNNEL" Style="{StaticResource Caption}"/>
                                <TextBlock x:Name="KpiActiveSession" Text="Standby" FontFamily="{StaticResource MonoFont}" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="KpiActiveLatency" Text="No active mTLS tunnel" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="4" Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="FLEET CPU / RAM" Style="{StaticResource Caption}"/>
                                <TextBlock x:Name="KpiFleetLoad" Text="--% CPU  ·  --% RAM" FontFamily="{StaticResource MonoFont}" FontSize="15.5" FontWeight="SemiBold"/>
                                <ProgressBar x:Name="KpiLoadBar" Style="{StaticResource ThinProgressBar}" Value="0" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="6" Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="NETWORK LATENCY (RTT)" Style="{StaticResource Caption}"/>
                                <DockPanel>
                                    <TextBlock x:Name="KpiAvgLatency" Text="-- ms" FontFamily="{StaticResource MonoFont}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Canvas Width="100" Height="24" DockPanel.Dock="Right" HorizontalAlignment="Right">
                                        <Polyline x:Name="OverviewSparkline" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" Points="0,18 20,16 40,20 60,12 80,14 100,10"/>
                                    </Canvas>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Live telemetry tiles (Views\TelemetryOverviewView.xaml) -->
                    <ContentControl x:Name="TelemetryHost" DockPanel.Dock="Top" Height="250" Margin="0,0,0,12"/>

                    <!-- Middle Row: Network Traffic Sparkline & Recent Alerts -->
                    <Grid DockPanel.Dock="Top" Height="186" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.15*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                    <TextBlock DockPanel.Dock="Right" x:Name="TrafficPeakText" Text="PEAK: -- ms" FontFamily="{StaticResource MonoFont}" FontSize="10.5" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBlock Text="RELAY LATENCY &amp; UTILIZATION TREND" Style="{StaticResource Caption}" Margin="0"/>
                                </DockPanel>
                                <Border Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="4" Padding="10,8">
                                    <Grid>
                                        <Viewbox Stretch="Fill">
                                            <Canvas Width="400" Height="110">
                                                <Line X1="0" Y1="27" X2="400" Y2="27" Stroke="#12FFFFFF" StrokeThickness="1"/>
                                                <Line X1="0" Y1="55" X2="400" Y2="55" Stroke="#12FFFFFF" StrokeThickness="1"/>
                                                <Line X1="0" Y1="82" X2="400" Y2="82" Stroke="#12FFFFFF" StrokeThickness="1"/>
                                                <Polyline x:Name="TrafficSparkline" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.8"
                                                          Points="0,85 45,78 90,82 135,62 180,68 225,52 270,58 315,44 360,48 400,38"/>
                                                <Polyline x:Name="CpuSparkline" Stroke="{StaticResource IndigoBrush}" StrokeThickness="1.5"
                                                          Points="0,92 45,88 90,84 135,79 180,82 225,74 270,76 315,70 360,72 400,66"/>
                                            </Canvas>
                                        </Viewbox>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Left">
                                            <Border Background="#183B82F6" BorderBrush="#263B82F6" BorderThickness="1" CornerRadius="3" Padding="6,2" Margin="0,0,6,0">
                                                <TextBlock Text="RTT (ms)" FontFamily="{StaticResource MonoFont}" FontSize="9.5" Foreground="{StaticResource AccentBrush}"/>
                                            </Border>
                                            <Border Background="#1864748B" BorderBrush="#2664748B" BorderThickness="1" CornerRadius="3" Padding="6,2">
                                                <TextBlock Text="CPU (%)" FontFamily="{StaticResource MonoFont}" FontSize="9.5" Foreground="{StaticResource MutedBrush}"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DockPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="SYSTEM AUDIT &amp; RELAY EVENTS" Style="{StaticResource Caption}" Margin="0,0,0,8"/>
                                <ListBox x:Name="OverviewEventsList" Background="Transparent" BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,2">
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding Timestamp}" FontFamily="{StaticResource MonoFont}" FontSize="10.5" Foreground="{StaticResource MutedBrush}" Margin="0,0,8,0"/>
                                                <Border DockPanel.Dock="Left" Background="{Binding BadgeBackground}" CornerRadius="3" Padding="5,1" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding Category}" FontFamily="{StaticResource MonoFont}" FontSize="9.5" FontWeight="SemiBold" Foreground="{Binding BadgeForeground}"/>
                                                </Border>
                                                <TextBlock Text="{Binding Message}" FontSize="11.5" TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <!-- Bottom Row: Quick Fleet Snapshot Table -->
                    <Border Style="{StaticResource CardStyle}">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <TextBlock DockPanel.Dock="Right" Text="All endpoint connections route through the Central Hub" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock Text="MANAGED ENDPOINTS SNAPSHOT" Style="{StaticResource Caption}" Margin="0"/>
                            </DockPanel>
                            <ListBox x:Name="OverviewFleetList" Background="Transparent" BorderThickness="0"
                                     HorizontalContentAlignment="Stretch"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="4,6">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Content="{Binding ConnectActionText}" Style="{StaticResource SmallPillButton}"
                                                        Tag="{Binding}" Click="OnCardConnectClick"/>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding LatencyLabel}" FontFamily="{StaticResource MonoFont}"
                                                           FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="14,0,14,0" Width="64" TextAlignment="Right"/>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Ellipse Width="7" Height="7" Fill="{Binding DotBrush}" Margin="0,0,10,0"/>
                                                    <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" Width="210" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Address}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" Foreground="{StaticResource MutedBrush}" Width="165"/>
                                                    <TextBlock Text="{Binding OsTag}" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource MutedBrush}" Width="110"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                </DockPanel>

                <!-- ==================== 1. FLEET COMMAND GRID ==================== -->
                <DockPanel x:Name="FleetPanel" Visibility="Collapsed">
                    <!-- Slim Fleet Toolbar -->
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <TextBox x:Name="FleetFilterBox" Width="210" Margin="0,0,8,0" ToolTip="Filter endpoints by name, IP, or OS" TextChanged="OnFleetFilterChanged"/>
                            <Button Content="+ Add Endpoint" Style="{StaticResource PrimaryButton}" Padding="12,6" Click="OnOpenAddEndpointDrawerClick"/>
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="MANAGED LAN ENDPOINTS" Style="{StaticResource Caption}" Margin="0,0,0,2"/>
                            <TextBlock x:Name="FleetSummaryText" Text="Select any endpoint card for Connect, Terminal, Wake-on-LAN, or Restart actions."
                                       FontSize="11.5" Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- 1-to-Many Mass Execution Bar -->
                    <Border DockPanel.Dock="Top" Style="{StaticResource CardStyle}" Padding="12,8" Margin="0,0,0,10">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Execute on All Online" Style="{StaticResource GhostButton}" Padding="12,5" Margin="8,0,0,0" Click="OnMassRunClick"/>
                            <TextBlock DockPanel.Dock="Left" Text="BROADCAST PS:" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox x:Name="MassCommandBox" FontFamily="{StaticResource MonoFont}" FontSize="12" Text="hostname; (Get-CimInstance Win32_OperatingSystem).LastBootUpTime"/>
                        </DockPanel>
                    </Border>

                    <!-- Power & Wake-on-LAN for the selected endpoint(s) (Views\EndpointActionBar.xaml) -->
                    <Border DockPanel.Dock="Top" Style="{StaticResource CardStyle}" Padding="12,7" Margin="0,0,0,10"
                            ToolTip="Acts on every selected endpoint card (Ctrl/Shift+click to select several)">
                        <ContentControl x:Name="FleetPowerHost"/>
                    </Border>

                    <!-- Live Activity Log / Recent Events Feed (Docked Bottom) -->
                    <Border DockPanel.Dock="Bottom" Style="{StaticResource CardStyle}" Padding="12,10" Height="160" Margin="0,10,0,0">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                <Button DockPanel.Dock="Right" Content="Clear" Style="{StaticResource SmallPillButton}" Click="OnClearActivityLogClick"/>
                                <TextBlock Text="CENTRAL HUB AUDIT LOG" Style="{StaticResource Caption}" Margin="0" VerticalAlignment="Center"/>
                            </DockPanel>
                            <ListBox x:Name="FleetActivityList" Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                     Padding="6,4" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="2,2">
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Timestamp}" FontFamily="{StaticResource MonoFont}" FontSize="10.5" Foreground="{StaticResource MutedBrush}" Margin="0,0,10,0"/>
                                            <Border DockPanel.Dock="Left" Background="{Binding BadgeBackground}" CornerRadius="3" Padding="5,1" Margin="0,0,10,0">
                                                <TextBlock Text="{Binding Category}" FontFamily="{StaticResource MonoFont}" FontSize="9.5" FontWeight="SemiBold" Foreground="{Binding BadgeForeground}"/>
                                            </Border>
                                            <TextBlock Text="{Binding Message}" FontSize="11.5" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <!-- Pro-Tool Endpoint Cards Grid (Zero DropShadow Glows, Crisp 1px Borders) -->
                    <ListBox x:Name="MachinesList" Background="Transparent" BorderThickness="0"
                             SelectionMode="Extended"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="OnMachineSelectionChanged"
                             MouseDoubleClick="OnMachineDoubleClick">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel IsItemsHost="True"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,10,10"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="CardBd" Width="328" Background="{StaticResource CardBrush}"
                                                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                                    CornerRadius="6" Padding="14,12">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="CardBd" Property="Background" Value="{StaticResource CardHoverBrush}"/>
                                                    <Setter TargetName="CardBd" Property="BorderBrush" Value="#2EFFFFFF"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="CardBd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                    <Setter TargetName="CardBd" Property="Background" Value="#1F2430"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <!-- Header: Status Dot + Hostname + Status Badge -->
                                    <DockPanel Margin="0,0,0,6">
                                        <Border DockPanel.Dock="Right" Background="{Binding BadgeBackground}" CornerRadius="4" Padding="7,2">
                                            <TextBlock Text="{Binding StatusLabel}" FontFamily="{StaticResource MonoFont}" FontSize="10" FontWeight="SemiBold"/>
                                        </Border>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="7" Height="7" Fill="{Binding DotBrush}" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding DisplayTitle}" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="190"/>
                                        </StackPanel>
                                    </DockPanel>

                                    <!-- Address + OS Badge -->
                                    <DockPanel Margin="0,0,0,10">
                                        <Border DockPanel.Dock="Right" Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding OsGlyph}" FontFamily="{StaticResource MonoFont}" FontSize="9.5" FontWeight="Bold" Margin="0,0,5,0" Foreground="{StaticResource AccentBrush}"/>
                                                <TextBlock Text="{Binding OsTag}" FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="{Binding Address}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                                    </DockPanel>

                                    <!-- Uptime / last seen (live telemetry + probes) -->
                                    <TextBlock Text="{Binding HealthLine}" FontFamily="{StaticResource MonoFont}" FontSize="10"
                                               Foreground="{StaticResource MutedBrush}" Margin="0,-4,0,8" TextTrimming="CharacterEllipsis"/>

                                    <!-- CPU / RAM Real-Time Mini Bars -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <DockPanel Margin="0,0,0,3">
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding CpuLabel}" FontFamily="{StaticResource MonoFont}" FontSize="10" FontWeight="SemiBold"/>
                                                <TextBlock Text="CPU" FontFamily="{StaticResource MonoFont}" FontSize="9.5" Foreground="{StaticResource MutedBrush}"/>
                                            </DockPanel>
                                            <ProgressBar Style="{StaticResource ThinProgressBar}" Value="{Binding CpuPercent, Mode=OneWay}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <DockPanel Margin="0,0,0,3">
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding RamLabel}" FontFamily="{StaticResource MonoFont}" FontSize="10" FontWeight="SemiBold"/>
                                                <TextBlock Text="RAM" FontFamily="{StaticResource MonoFont}" FontSize="9.5" Foreground="{StaticResource MutedBrush}"/>
                                            </DockPanel>
                                            <ProgressBar Style="{StaticResource ThinProgressBar}" Foreground="{StaticResource IndigoBrush}" Value="{Binding RamPercent, Mode=OneWay}"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Action Bar -->
                                    <Border x:Name="QuickActionsBar" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="{Binding ConnectActionText}" Style="{StaticResource PrimaryButton}" Padding="9,4" FontSize="11" Margin="0,0,5,0" Tag="{Binding}" Click="OnCardConnectClick"/>
                                            <Button Content="Shell" Style="{StaticResource SmallPillButton}" Padding="8,4" FontSize="11" Margin="0,0,5,0" Tag="{Binding}" Click="OnCardTerminalClick"/>
                                            <Button Content="Wake" Style="{StaticResource SmallPillButton}" Padding="8,4" FontSize="11" Margin="0,0,5,0" Tag="{Binding}" Click="OnCardWakeClick"/>
                                            <Button Content="Restart" Style="{StaticResource SmallPillButton}" Padding="8,4" FontSize="11" Margin="0,0,5,0" Tag="{Binding}" Click="OnCardRestartClick"/>
                                            <Button Content="Edit" Style="{StaticResource SmallPillButton}" Padding="8,4" FontSize="11" Tag="{Binding}" Click="OnCardEditClick"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <!-- ==================== 2. REMOTE DESKTOP VIEW ==================== -->
                <DockPanel x:Name="DesktopPanel" Visibility="Collapsed">
                    <Border x:Name="DesktopToolbarBorder" DockPanel.Dock="Top" Style="{StaticResource CardStyle}" Padding="12,8" Margin="0,0,0,10">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                <Button Content="Send Clipboard" Style="{StaticResource SmallPillButton}" Margin="0,0,6,0" Click="OnSendClipboardClick"/>
                                <Button Content="Pull Clipboard" Style="{StaticResource SmallPillButton}" Margin="0,0,8,0" Click="OnGetClipboardClick"/>
                                <Border Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                        CornerRadius="4" Padding="9,4" Margin="0,0,8,0">
                                    <TextBlock x:Name="StreamStatus" Text="Idle" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                                </Border>
                                <Button x:Name="FullScreenBtn" Content="Full Screen (F11)" Style="{StaticResource GhostButton}" Padding="10,5" Click="OnToggleFullScreenClick"/>
                            </StackPanel>

                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="StreamBtn" Content="Start Stream" Width="118" Style="{StaticResource PrimaryButton}" Padding="10,5" Click="OnToggleStream"/>
                                <CheckBox x:Name="ControlCheck" Content="Input Control" Margin="12,0,0,0" Checked="OnControlCheckChanged" Unchecked="OnControlCheckChanged"/>
                                <CheckBox x:Name="PrivacyCheck" Content="Curtain Mode" Margin="12,0,0,0" ToolTip="Blank remote screen &amp; lock physical input" Checked="OnPrivacyModeChanged" Unchecked="OnPrivacyModeChanged"/>
                                <Border Width="1" Height="18" Background="{StaticResource LineBrush}" Margin="12,0"/>
                                <ComboBox x:Name="MonitorCombo" Width="108" SelectedIndex="0" Margin="0,0,6,0" Background="{StaticResource FieldBrush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource LineBrush}" SelectionChanged="OnMonitorSelectionChanged">
                                    <ComboBoxItem Content="Screen 1" Tag="0"/>
                                </ComboBox>
                                <Button x:Name="Screen1Btn" Content="1" Style="{StaticResource SmallPillButton}" Margin="0,0,3,0" ToolTip="Switch to Display 1" Tag="0" Click="OnQuickMonitorSwitchClick"/>
                                <Button x:Name="Screen2Btn" Content="2" Style="{StaticResource SmallPillButton}" Margin="0,0,3,0" ToolTip="Switch to Display 2" Tag="1" Click="OnQuickMonitorSwitchClick"/>
                                <Button x:Name="ScreenAllBtn" Content="All" Style="{StaticResource SmallPillButton}" Margin="0,0,6,0" ToolTip="All-in-One Side-by-Side View" Tag="-1" Click="OnQuickMonitorSwitchClick"/>
                                <Button x:Name="DetachScreenBtn" Content="Detach 2nd" Style="{StaticResource SmallPillButton}" Margin="0,0,8,0" ToolTip="Detach Screen 2 into a separate window on your 2nd local display" Click="OnDetachSecondMonitorClick"/>
                                <Button x:Name="LaunchRdpBtn" Content="Launch RDP" Style="{StaticResource PrimaryButton}" Padding="10,4" Margin="0,0,8,0" Visibility="Collapsed" Click="OnLaunchAgentlessRdpClick"/>
                                <TextBlock Text="FPS" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBox x:Name="FpsBox" FontFamily="{StaticResource MonoFont}" Text="30" Width="44" Margin="0,0,8,0"/>
                                <TextBlock Text="JPEG" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBox x:Name="QualityBox" FontFamily="{StaticResource MonoFont}" Text="88" Width="44" Margin="0,0,8,0"/>
                                <ComboBox x:Name="ScaleBox" Width="108" SelectedIndex="0" Margin="0,0,6,0" Background="{StaticResource FieldBrush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource LineBrush}">
                                    <ComboBoxItem Content="Native" Tag="0"/>
                                    <ComboBoxItem Content="1080p" Tag="1920"/>
                                    <ComboBoxItem Content="720p" Tag="1280"/>
                                </ComboBox>
                                <ComboBox x:Name="UpscaleBox" Width="86" SelectedIndex="0" SelectionChanged="OnUpscaleModeChanged" Background="{StaticResource FieldBrush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource LineBrush}">
                                    <ComboBoxItem Content="CAS+" Tag="cas"/>
                                    <ComboBoxItem Content="Bicubic" Tag="bicubic"/>
                                    <ComboBoxItem Content="Raw" Tag="none"/>
                                </ComboBox>
                            </WrapPanel>
                        </DockPanel>
                    </Border>

                    <Border x:Name="ScreenCanvasBorder" Background="#08090B" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                        <Grid>
                            <Grid x:Name="SharpenHost">
                                <Image x:Name="ScreenImage" Stretch="Uniform" Focusable="True"
                                       Stylus.IsPressAndHoldEnabled="False" IsManipulationEnabled="False"
                                       SizeChanged="OnScreenImageSizeChanged"
                                       MouseMove="OnScreenMouseMove" MouseDown="OnScreenMouseDown" MouseUp="OnScreenMouseUp"
                                       TouchDown="OnScreenTouchDown" TouchMove="OnScreenTouchMove" TouchUp="OnScreenTouchUp"
                                       MouseWheel="OnScreenMouseWheel" KeyDown="OnScreenKeyDown" KeyUp="OnScreenKeyUp"/>
                            </Grid>
                            <Canvas x:Name="CursorLayer" IsHitTestVisible="False">
                                <Image x:Name="RemoteCursorImage" Stretch="None" Visibility="Collapsed"/>
                            </Canvas>

                            <Border x:Name="FullscreenHud" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="0,12,16,0" Background="#E615171C" BorderBrush="{StaticResource LineBrush}"
                                    BorderThickness="1" CornerRadius="6" Padding="10,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="FullscreenHudText" Text="FULL SCREEN" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <Button x:Name="HudUpscaleBtn" Style="{StaticResource SmallPillButton}" Margin="0,0,6,0" Click="OnHudUpscaleClick">
                                        <TextBlock x:Name="HudUpscaleText" Text="CAS+"/>
                                    </Button>
                                    <Button Content="Paste" Style="{StaticResource SmallPillButton}" Margin="0,0,6,0" Click="OnSendClipboardClick"/>
                                    <Button Content="Copy" Style="{StaticResource SmallPillButton}" Margin="0,0,8,0" Click="OnGetClipboardClick"/>
                                    <Button Content="Exit (Esc)" Style="{StaticResource SmallPillButton}" Margin="0,0,8,0" Click="OnToggleFullScreenClick"/>
                                    <Button Content="Stop" Style="{StaticResource DangerButton}" Padding="10,4" FontSize="11" Click="OnToggleStream"/>
                                </StackPanel>
                            </Border>

                            <StackPanel x:Name="DesktopOverlay" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="42" Height="42" CornerRadius="6" Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Margin="0,0,0,12" HorizontalAlignment="Center">
                                    <Path Style="{StaticResource VectorIcon}" Data="{StaticResource GeoDesktop}" Stroke="{StaticResource MutedBrush}" Width="18" Height="18" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Remote Desktop Session Standby" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Text="Click 'Start Stream' or press F11 for Full Screen. Stream routes through Central Hub mTLS."
                                           Foreground="{StaticResource MutedBrush}" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DockPanel>

                <!-- ==================== 3. MONITOR & INVENTORY VIEW ==================== -->
                <DockPanel x:Name="InventoryPanel" Visibility="Collapsed">
                    <UniformGrid DockPanel.Dock="Top" Columns="4" Margin="0,0,0,10">
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="PROCESSOR" Style="{StaticResource Caption}"/>
                                <TextBlock x:Name="CpuValueText" Text="—" Style="{StaticResource ValueText}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="CpuSubText" Text="Connect to inspect" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}" Margin="3,0,3,0">
                            <StackPanel>
                                <TextBlock Text="MEMORY" Style="{StaticResource Caption}"/>
                                <TextBlock x:Name="RamValueText" Text="—" FontFamily="{StaticResource MonoFont}" Style="{StaticResource ValueText}"/>
                                <TextBlock x:Name="RamSubText" Text="RAM &amp; active processes" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}" Margin="3,0,3,0">
                            <StackPanel>
                                <TextBlock Text="GRAPHICS" Style="{StaticResource Caption}"/>
                                <TextBlock x:Name="GpuValueText" Text="—" Style="{StaticResource ValueText}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="GpuSubText" Text="Display adapter" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock Text="STORAGE" Style="{StaticResource Caption}"/>
                                <TextBlock x:Name="DiskValueText" Text="—" FontFamily="{StaticResource MonoFont}" Style="{StaticResource ValueText}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="DiskSubText" Text="Fixed drives" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Button x:Name="RefreshInvBtn" DockPanel.Dock="Right" Content="Refresh Inventory" Style="{StaticResource PrimaryButton}" Click="OnRefreshInventory" Padding="12,6"/>
                        <TextBlock x:Name="InventoryTimestampText" DockPanel.Dock="Right" Text="" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="FILTER" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="SearchBox" Width="280" TextChanged="OnSearchChanged"/>
                        </StackPanel>
                    </DockPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.15*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="0.85*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="0">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" Padding="12,8" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right" Background="#183B82F6" CornerRadius="4" Padding="7,2">
                                            <TextBlock x:Name="AppsCountText" Text="0 apps" FontFamily="{StaticResource MonoFont}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                                        </Border>
                                        <TextBlock Text="INSTALLED APPLICATIONS" Style="{StaticResource Caption}" Margin="0"/>
                                    </DockPanel>
                                </Border>
                                <DataGrid x:Name="AppsGrid">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="APPLICATION" Binding="{Binding Name}" Width="2*"/>
                                        <DataGridTextColumn Header="VERSION" Binding="{Binding Version}" Width="110" FontFamily="{StaticResource MonoFont}"/>
                                        <DataGridTextColumn Header="PUBLISHER" Binding="{Binding Publisher}" Width="1.2*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="0">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" Padding="12,8" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Button Content="Terminate Process" Style="{StaticResource SmallPillButton}" Margin="0,0,8,0" Click="OnKillSelectedProcessClick"/>
                                            <Border Background="#1810B981" CornerRadius="4" Padding="7,2" VerticalAlignment="Center">
                                                <TextBlock x:Name="ProcsCountText" Text="0 procs" FontFamily="{StaticResource MonoFont}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource OkBrush}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="RUNNING PROCESSES" Style="{StaticResource Caption}" Margin="0" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </Border>
                                <DataGrid x:Name="ProcGrid">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="68" FontFamily="{StaticResource MonoFont}"/>
                                        <DataGridTextColumn Header="PROCESS" Binding="{Binding Name}" Width="*"/>
                                        <DataGridTextColumn Header="RAM (MB)" Binding="{Binding MemoryMb}" Width="88" FontFamily="{StaticResource MonoFont}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>
                    </Grid>
                </DockPanel>

                <!-- ==================== 4. REMOTE SHELL VIEW ==================== -->
                <DockPanel x:Name="ShellPanel" Visibility="Collapsed">
                    <Border DockPanel.Dock="Top" Style="{StaticResource CardStyle}" Padding="12,8" Margin="0,0,0,10">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Clear Buffer" Style="{StaticResource SmallPillButton}" Click="OnClearShellClick"/>
                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="PRESETS:" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <Button Content="whoami" Tag="whoami; hostname; $PSVersionTable.PSVersion.ToString()" Style="{StaticResource SmallPillButton}" Margin="0,0,6,0" Click="OnQuickCommandClick"/>
                                <Button Content="IP Config" Tag="Get-NetIPAddress -AddressFamily IPv4 | Select-Object InterfaceAlias, IPAddress | Format-Table -AutoSize" Style="{StaticResource SmallPillButton}" Margin="0,0,6,0" Click="OnQuickCommandClick"/>
                                <Button Content="Top CPU" Tag="Get-Process | Sort-Object CPU -Descending | Select-Object -First 10 Id, ProcessName, @{N='CPU(s)';E={[math]::Round($_.CPU,1)}}, @{N='RAM(MB)';E={[math]::Round($_.WorkingSet64/1MB,1)}} | Format-Table -AutoSize" Style="{StaticResource SmallPillButton}" Margin="0,0,6,0" Click="OnQuickCommandClick"/>
                                <Button Content="Disks" Tag="Get-PSDrive -PSProvider FileSystem | Select-Object Name, @{N='Used(GB)';E={[math]::Round($_.Used/1GB,1)}}, @{N='Free(GB)';E={[math]::Round($_.Free/1GB,1)}} | Format-Table -AutoSize" Style="{StaticResource SmallPillButton}" Margin="0,0,6,0" Click="OnQuickCommandClick"/>
                                <Button Content="Uptime" Tag="(Get-Date) - (Get-CimInstance Win32_OperatingSystem).LastBootUpTime | Select-Object Days, Hours, Minutes | Format-List" Style="{StaticResource SmallPillButton}" Click="OnQuickCommandClick"/>
                            </WrapPanel>
                        </DockPanel>
                    </Border>

                    <Border DockPanel.Dock="Bottom" Style="{StaticResource CardStyle}" Padding="8" Margin="0,10,0,0">
                        <DockPanel>
                            <Button x:Name="ShellSendBtn" DockPanel.Dock="Right" Content="Execute" Width="100" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="OnShellSend"/>
                            <Border DockPanel.Dock="Left" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="4" Padding="9,5" Margin="0,0,8,0">
                                <TextBlock Text="PS &gt;" FontFamily="{StaticResource MonoFont}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                            </Border>
                            <TextBox x:Name="ShellInputBox" FontFamily="{StaticResource MonoFont}" FontSize="12.5" KeyDown="OnShellInputKeyDown"/>
                        </DockPanel>
                    </Border>

                    <Border Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="2">
                        <TextBox x:Name="ShellOutput" IsReadOnly="True" Background="Transparent" Foreground="#E2E8F0" BorderThickness="0" Padding="12,10"
                                 FontFamily="{StaticResource MonoFont}" FontSize="12" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" AcceptsReturn="True"/>
                    </Border>
                </DockPanel>

                <!-- ==================== 5. WINSTALL-STYLE VISUAL DEPLOY VIEW ==================== -->
                <DockPanel x:Name="DeployPanel" Visibility="Collapsed" AllowDrop="True" PreviewDragOver="OnDeployDragOver" Drop="OnDeployFileDrop">
                    <!-- Top Search, Packs, & Deploy Queue Bar -->
                    <Border DockPanel.Dock="Top" Style="{StaticResource CardStyle}" Padding="14,10" Margin="0,0,0,10">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="#183B82F6" CornerRadius="4" Padding="8,3" Margin="0,0,8,0">
                                        <TextBlock x:Name="DeployStatusBadge" Text="READY" FontFamily="{StaticResource MonoFont}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                                    </Border>
                                    <Button x:Name="WingetDeploySelectedBtn" Content="Deploy Selected (0)" Style="{StaticResource PrimaryButton}" Padding="12,5" Click="OnDeploySelectedWingetClick"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="VISUAL SOFTWARE CATALOG (WINGET) &amp; PACKAGE DEPLOYMENT" Style="{StaticResource Caption}" Margin="0,0,0,2"/>
                                    <TextBlock Text="Select applications or preset packs, or drop .exe / .msi / .ps1 files to execute silently on the endpoint." FontSize="11.5" Foreground="{StaticResource MutedBrush}"/>
                                </StackPanel>
                            </DockPanel>

                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBox x:Name="WingetSearchBox" Width="210" Margin="0,0,6,0" ToolTip="Search cached + live Winget catalog" TextChanged="OnWingetSearchChanged"/>
                                <Button Content="Search Live" Style="{StaticResource GhostButton}" Padding="10,5" Margin="0,0,10,0" Click="OnWingetLiveSearchClick"/>
                                <ComboBox x:Name="WingetPackCombo" Width="165" SelectedIndex="0" Margin="0,0,6,0" Background="{StaticResource FieldBrush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource LineBrush}"/>
                                <Button Content="Load Pack" Style="{StaticResource SmallPillButton}" Margin="0,0,4,0" Click="OnApplyWingetPackClick"/>
                                <Button Content="Save Pack" Style="{StaticResource SmallPillButton}" Margin="0,0,4,0" Click="OnSaveWingetPackClick"/>
                                <Button Content="Import IDs" Style="{StaticResource SmallPillButton}" Margin="0,0,10,0" Click="OnImportWingetIdsClick"/>
                                <CheckBox x:Name="WingetSilentCheck" Content="Silent" IsChecked="True" Margin="0,0,8,0"/>
                                <CheckBox x:Name="WingetMachineScopeCheck" Content="Machine Scope" IsChecked="True" Margin="0,0,8,0"/>
                                <CheckBox x:Name="WingetUpgradeCheck" Content="Upgrade if installed" IsChecked="True"/>
