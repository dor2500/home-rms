<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--
        Home RMS design tokens — "Graphite & Iris" (strict dark).
        Layered graphite surfaces with a cool blue cast; one iris accent; semantic colours each with a
        soft tint (≈14% alpha) for pills/badges and a line tint (≈30%) for tinted borders.
        Every colour in the app resolves from here (XAML via StaticResource, code via Themes\Palette.cs).
    -->

    <!-- ===== Raw colours ===== -->
    <Color x:Key="CanvasColor">#0B0D12</Color>
    <Color x:Key="SurfaceColor">#10131A</Color>
    <Color x:Key="ElevatedColor">#151922</Color>
    <Color x:Key="ElevatedHoverColor">#1A1F2A</Color>
    <Color x:Key="OverlayColor">#1B202B</Color>
    <Color x:Key="FieldColor">#0E1117</Color>
    <Color x:Key="SunkenColor">#080A0E</Color>

    <Color x:Key="BorderSubtleColor">#222835</Color>
    <Color x:Key="BorderStrongColor">#323A4A</Color>

    <Color x:Key="TextPrimaryColor">#E7EAF0</Color>
    <Color x:Key="TextSecondaryColor">#A7AFBE</Color>
    <Color x:Key="TextMutedColor">#7C8597</Color>
    <Color x:Key="TextDisabledColor">#4E5666</Color>

    <Color x:Key="AccentColor">#8B96FF</Color>
    <Color x:Key="AccentStrongColor">#5D69EB</Color>
    <Color x:Key="AccentStrongHoverColor">#6C78F2</Color>
    <Color x:Key="AccentSoftColor">#248B96FF</Color>
    <Color x:Key="AccentLineColor">#4D8B96FF</Color>

    <Color x:Key="SuccessColor">#3DBE8B</Color>
    <Color x:Key="SuccessSoftColor">#243DBE8B</Color>
    <Color x:Key="SuccessLineColor">#4D3DBE8B</Color>
    <Color x:Key="WarningColor">#E8A73E</Color>
    <Color x:Key="WarningSoftColor">#24E8A73E</Color>
    <Color x:Key="WarningLineColor">#4DE8A73E</Color>
    <Color x:Key="DangerColor">#F06A72</Color>
    <Color x:Key="DangerStrongColor">#D8464F</Color>
    <Color x:Key="DangerStrongHoverColor">#E3545D</Color>
    <Color x:Key="DangerSoftColor">#26F06A72</Color>
    <Color x:Key="DangerLineColor">#4DF06A72</Color>
    <Color x:Key="InfoColor">#4FB2E8</Color>
    <Color x:Key="InfoSoftColor">#244FB2E8</Color>
    <Color x:Key="InfoLineColor">#4D4FB2E8</Color>
    <Color x:Key="NeutralColor">#7C8597</Color>
    <Color x:Key="NeutralSoftColor">#1F7C8597</Color>

    <!-- Second data series (RAM, CPU trend): teal, distinct from iris and from success green -->
    <Color x:Key="SeriesTealColor">#45B8C4</Color>

    <!-- ===== Surface brushes ===== -->
    <SolidColorBrush x:Key="CanvasBrush" Color="{StaticResource CanvasColor}"/>
    <SolidColorBrush x:Key="SurfaceLayerBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="ElevatedBrush" Color="{StaticResource ElevatedColor}"/>
    <SolidColorBrush x:Key="ElevatedHoverBrush" Color="{StaticResource ElevatedHoverColor}"/>
    <SolidColorBrush x:Key="OverlayBrush" Color="{StaticResource OverlayColor}"/>
    <SolidColorBrush x:Key="SunkenBrush" Color="{StaticResource SunkenColor}"/>
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtleColor}"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabledColor}"/>
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF"/>

    <!-- ===== Accent & semantic brushes ===== -->
    <SolidColorBrush x:Key="AccentStrongBrush" Color="{StaticResource AccentStrongColor}"/>
    <SolidColorBrush x:Key="AccentStrongHoverBrush" Color="{StaticResource AccentStrongHoverColor}"/>
    <SolidColorBrush x:Key="AccentLineBrush" Color="{StaticResource AccentLineColor}"/>
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="{StaticResource SuccessSoftColor}"/>
    <SolidColorBrush x:Key="SuccessLineBrush" Color="{StaticResource SuccessLineColor}"/>
    <SolidColorBrush x:Key="WarningSoftBrush" Color="{StaticResource WarningSoftColor}"/>
    <SolidColorBrush x:Key="WarningLineBrush" Color="{StaticResource WarningLineColor}"/>
    <SolidColorBrush x:Key="DangerStrongBrush" Color="{StaticResource DangerStrongColor}"/>
    <SolidColorBrush x:Key="DangerStrongHoverBrush" Color="{StaticResource DangerStrongHoverColor}"/>
    <SolidColorBrush x:Key="DangerSoftBrush" Color="{StaticResource DangerSoftColor}"/>
    <SolidColorBrush x:Key="DangerLineBrush" Color="{StaticResource DangerLineColor}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}"/>
    <SolidColorBrush x:Key="InfoSoftBrush" Color="{StaticResource InfoSoftColor}"/>
    <SolidColorBrush x:Key="InfoLineBrush" Color="{StaticResource InfoLineColor}"/>
    <SolidColorBrush x:Key="NeutralBrush" Color="{StaticResource NeutralColor}"/>
    <SolidColorBrush x:Key="NeutralSoftBrush" Color="{StaticResource NeutralSoftColor}"/>
    <SolidColorBrush x:Key="SeriesTealBrush" Color="{StaticResource SeriesTealColor}"/>

    <!-- Scrims, HUD and special surfaces -->
    <SolidColorBrush x:Key="ScrimBrush" Color="#B8050609"/>
    <SolidColorBrush x:Key="LockScrimBrush" Color="#F50B0D12"/>
    <SolidColorBrush x:Key="HudBrush" Color="#E610131A"/>
    <SolidColorBrush x:Key="StreamCanvasBrush" Color="#06070A"/>
    <SolidColorBrush x:Key="ChartGridBrush" Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="RowHoverBrush" Color="#0DFFFFFF"/>
    <SolidColorBrush x:Key="RowAltBrush" Color="#05FFFFFF"/>
    <SolidColorBrush x:Key="RowDividerBrush" Color="#10FFFFFF"/>
    <SolidColorBrush x:Key="HoverLayerBrush" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="TrackBrush" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="BorderHoverBrush" Color="#4A5468"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#3A4252"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#566075"/>
    <!-- QR codes must stay black-on-white to scan -->
    <SolidColorBrush x:Key="QrBackgroundBrush" Color="#FFFFFF"/>

    <!-- ===== Legacy keys (referenced by XAML and code-behind; values follow the new palette) ===== -->
    <SolidColorBrush x:Key="DeepBgBrush" Color="{StaticResource CanvasColor}"/>
    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource CanvasColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource ElevatedColor}"/>
    <SolidColorBrush x:Key="CardHoverBrush" Color="{StaticResource ElevatedHoverColor}"/>
    <SolidColorBrush x:Key="FieldBrush" Color="{StaticResource FieldColor}"/>
    <SolidColorBrush x:Key="LineBrush" Color="{StaticResource BorderSubtleColor}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="IndigoBrush" Color="{StaticResource SeriesTealColor}"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}"/>
    <SolidColorBrush x:Key="OkBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="SelectBrush" Color="#2E8B96FF"/>

    <!-- ===== Typography ===== -->
    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI, Inter</FontFamily>
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI Semibold, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, JetBrains Mono, Consolas</FontFamily>

    <!-- Type scale (device-independent px): 11 / 12 / 13 / 14 / 16 / 20 / 26 -->
    <sys:Double x:Key="FontSizeCaption">11</sys:Double>
    <sys:Double x:Key="FontSizeSmall">12</sys:Double>
    <sys:Double x:Key="FontSizeBody">13</sys:Double>
    <sys:Double x:Key="FontSizeSubtitle">14</sys:Double>
    <sys:Double x:Key="FontSizeTitle">16</sys:Double>
    <sys:Double x:Key="FontSizePageTitle">20</sys:Double>
    <sys:Double x:Key="FontSizeMetric">26</sys:Double>

    <!-- ===== Spacing (8px grid) & radii ===== -->
    <Thickness x:Key="CardPadding">16,14</Thickness>
    <Thickness x:Key="CardPaddingCompact">12,8</Thickness>
    <Thickness x:Key="PageMargin">24,16,24,16</Thickness>
    <CornerRadius x:Key="RadiusControl">6</CornerRadius>
    <CornerRadius x:Key="RadiusCard">8</CornerRadius>
    <CornerRadius x:Key="RadiusOverlay">12</CornerRadius>
    <CornerRadius x:Key="RadiusPill">10</CornerRadius>
    <sys:Double x:Key="RowHeight">32</sys:Double>

    <!-- ===== Elevation (used sparingly: popups, drawers, dialogs) ===== -->
    <DropShadowEffect x:Key="ShadowPopup" BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.45" Color="#000000"/>
    <DropShadowEffect x:Key="ShadowOverlay" BlurRadius="40" ShadowDepth="12" Direction="270" Opacity="0.55" Color="#000000"/>
    <DropShadowEffect x:Key="ShadowDrawer" BlurRadius="32" ShadowDepth="0" Direction="180" Opacity="0.5" Color="#000000"/>

    <!-- ===== Motion ===== -->
    <Duration x:Key="MotionFast">0:0:0.12</Duration>
    <Duration x:Key="MotionBase">0:0:0.18</Duration>
</ResourceDictionary>
