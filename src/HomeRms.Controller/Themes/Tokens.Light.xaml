<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Home RMS design tokens — "Alabaster & Iris" (Light mode).
        Overrides every colour and brush key defined in Tokens.xaml so DynamicResource lookups
        switch cleanly between Light and Dark mode without touching non-colour tokens.
    -->

    <!-- ===== Raw colours ===== -->
    <Color x:Key="CanvasColor">#F4F6FA</Color>
    <Color x:Key="SurfaceColor">#EBEEF5</Color>
    <Color x:Key="ElevatedColor">#FFFFFF</Color>
    <Color x:Key="ElevatedHoverColor">#F8F9FC</Color>
    <Color x:Key="OverlayColor">#FFFFFF</Color>
    <Color x:Key="FieldColor">#FFFFFF</Color>
    <Color x:Key="SunkenColor">#E4E8F1</Color>

    <Color x:Key="BorderSubtleColor">#D9DFE9</Color>
    <Color x:Key="BorderStrongColor">#B8C2D4</Color>

    <Color x:Key="TextPrimaryColor">#171B26</Color>
    <Color x:Key="TextSecondaryColor">#475166</Color>
    <Color x:Key="TextMutedColor">#697388</Color>
    <Color x:Key="TextDisabledColor">#9CA4B5</Color>

    <Color x:Key="AccentColor">#4E5BE6</Color>
    <Color x:Key="AccentStrongColor">#434FD9</Color>
    <Color x:Key="AccentStrongHoverColor">#3541C7</Color>
    <Color x:Key="AccentSoftColor">#1C4E5BE6</Color>
    <Color x:Key="AccentLineColor">#4D4E5BE6</Color>

    <Color x:Key="SuccessColor">#138A5C</Color>
    <Color x:Key="SuccessSoftColor">#1A138A5C</Color>
    <Color x:Key="SuccessLineColor">#4D138A5C</Color>
    <Color x:Key="WarningColor">#B87100</Color>
    <Color x:Key="WarningSoftColor">#1AB87100</Color>
    <Color x:Key="WarningLineColor">#4DB87100</Color>
    <Color x:Key="DangerColor">#C93640</Color>
    <Color x:Key="DangerStrongColor">#C93640</Color>
    <Color x:Key="DangerStrongHoverColor">#B32832</Color>
    <Color x:Key="DangerSoftColor">#1AC93640</Color>
    <Color x:Key="DangerLineColor">#4DC93640</Color>
    <Color x:Key="InfoColor">#0F7BB8</Color>
    <Color x:Key="InfoSoftColor">#1A0F7BB8</Color>
    <Color x:Key="InfoLineColor">#4D0F7BB8</Color>
    <Color x:Key="NeutralColor">#697388</Color>
    <Color x:Key="NeutralSoftColor">#17697388</Color>

    <Color x:Key="SeriesTealColor">#0E8D99</Color>

    <!-- ===== Surface brushes ===== -->
    <SolidColorBrush x:Key="CanvasBrush" Color="{StaticResource CanvasColor}"/>
    <SolidColorBrush x:Key="SurfaceLayerBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="ElevatedBrush" Color="{StaticResource ElevatedColor}"/>
    <SolidColorBrush x:Key="ElevatedHoverBrush" Color="{StaticResource ElevatedHoverColor}"/>
    <SolidColorBrush x:Key="OverlayBrush" Color="{StaticResource OverlayColor}"/>
    <SolidColorBrush x:Key="SunkenBrush" Color="{StaticResource SunkenColor}"/>
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtleColor}"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabledColor}"/>
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF"/>

    <!-- ===== Accent & semantic brushes ===== -->
    <SolidColorBrush x:Key="AccentStrongBrush" Color="{StaticResource AccentStrongColor}"/>
    <SolidColorBrush x:Key="AccentStrongHoverBrush" Color="{StaticResource AccentStrongHoverColor}"/>
    <SolidColorBrush x:Key="AccentLineBrush" Color="{StaticResource AccentLineColor}"/>
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="{StaticResource SuccessSoftColor}"/>
    <SolidColorBrush x:Key="SuccessLineBrush" Color="{StaticResource SuccessLineColor}"/>
    <SolidColorBrush x:Key="WarningSoftBrush" Color="{StaticResource WarningSoftColor}"/>
    <SolidColorBrush x:Key="WarningLineBrush" Color="{StaticResource WarningLineColor}"/>
    <SolidColorBrush x:Key="DangerStrongBrush" Color="{StaticResource DangerStrongColor}"/>
    <SolidColorBrush x:Key="DangerStrongHoverBrush" Color="{StaticResource DangerStrongHoverColor}"/>
    <SolidColorBrush x:Key="DangerSoftBrush" Color="{StaticResource DangerSoftColor}"/>
    <SolidColorBrush x:Key="DangerLineBrush" Color="{StaticResource DangerLineColor}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}"/>
    <SolidColorBrush x:Key="InfoSoftBrush" Color="{StaticResource InfoSoftColor}"/>
    <SolidColorBrush x:Key="InfoLineBrush" Color="{StaticResource InfoLineColor}"/>
    <SolidColorBrush x:Key="NeutralBrush" Color="{StaticResource NeutralColor}"/>
    <SolidColorBrush x:Key="NeutralSoftBrush" Color="{StaticResource NeutralSoftColor}"/>
    <SolidColorBrush x:Key="SeriesTealBrush" Color="{StaticResource SeriesTealColor}"/>

    <!-- Scrims, HUD and special surfaces -->
    <SolidColorBrush x:Key="ScrimBrush" Color="#78101420"/>
    <SolidColorBrush x:Key="LockScrimBrush" Color="#EBEEF5"/>
    <SolidColorBrush x:Key="HudBrush" Color="#EBFFFFFF"/>
    <SolidColorBrush x:Key="StreamCanvasBrush" Color="#10131A"/>
    <SolidColorBrush x:Key="ChartGridBrush" Color="#1A000000"/>
    <SolidColorBrush x:Key="RowHoverBrush" Color="#0B000000"/>
    <SolidColorBrush x:Key="RowAltBrush" Color="#05000000"/>
    <SolidColorBrush x:Key="RowDividerBrush" Color="#12000000"/>
    <SolidColorBrush x:Key="HoverLayerBrush" Color="#0F000000"/>
    <SolidColorBrush x:Key="TrackBrush" Color="#14000000"/>
    <SolidColorBrush x:Key="BorderHoverBrush" Color="#9AA5BA"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#C2CAD9"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#9AA5BA"/>
    <SolidColorBrush x:Key="QrBackgroundBrush" Color="#FFFFFF"/>

    <!-- ===== Legacy keys ===== -->
    <SolidColorBrush x:Key="DeepBgBrush" Color="{StaticResource CanvasColor}"/>
    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource CanvasColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource ElevatedColor}"/>
    <SolidColorBrush x:Key="CardHoverBrush" Color="{StaticResource ElevatedHoverColor}"/>
    <SolidColorBrush x:Key="FieldBrush" Color="{StaticResource FieldColor}"/>
    <SolidColorBrush x:Key="LineBrush" Color="{StaticResource BorderSubtleColor}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="IndigoBrush" Color="{StaticResource SeriesTealColor}"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}"/>
    <SolidColorBrush x:Key="OkBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="SelectBrush" Color="#294E5BE6"/>

    <!-- ===== Deploy catalog (light) ===== -->
    <Color x:Key="DeployCanvasColor">#F5F6FA</Color>
    <Color x:Key="DeployCardColor">#FFFFFF</Color>
    <Color x:Key="DeployCardHoverColor">#F2F4FA</Color>
    <Color x:Key="DeployFieldColor">#FFFFFF</Color>
    <Color x:Key="DeployCodeColor">#EEF1F7</Color>
    <Color x:Key="DeployBorderColor">#DCE1EC</Color>
    <Color x:Key="DeployBorderHoverColor">#B9C2D6</Color>
    <Color x:Key="DeployMutedTextColor">#626B80</Color>
    <Color x:Key="DeployAccentColor">#7C22E6</Color>
    <Color x:Key="DeployAccentHoverColor">#6A18CC</Color>
    <Color x:Key="DeployAccentPressedColor">#5611A8</Color>
    <Color x:Key="DeployAccentSoftColor">#1C7C22E6</Color>
    <Color x:Key="DeployAccentLineColor">#667C22E6</Color>
    <Color x:Key="DeployAccentTextColor">#6A18CC</Color>
    <Color x:Key="DeployBarButtonColor">#F0F2F7</Color>
    <Color x:Key="DeployBarButtonHoverColor">#E2E6F0</Color>
    <Color x:Key="DeployOnAccentMutedColor">#E6FFFFFF</Color>
    <Color x:Key="DeployHeroStartColor">#6D28D9</Color>
    <Color x:Key="DeployHeroEndColor">#4338CA</Color>

    <Color x:Key="DeployToneBrowserFillColor">#F2EBFC</Color>
    <Color x:Key="DeployToneBrowserBadgeColor">#E2D2FA</Color>
    <Color x:Key="DeployToneBrowserInkColor">#59259E</Color>
    <Color x:Key="DeployToneDevFillColor">#ECEBFC</Color>
    <Color x:Key="DeployToneDevBadgeColor">#D7D4FA</Color>
    <Color x:Key="DeployToneDevInkColor">#3B339E</Color>
    <Color x:Key="DeployToneDocsFillColor">#EBF2FC</Color>
    <Color x:Key="DeployToneDocsBadgeColor">#D2E1FA</Color>
    <Color x:Key="DeployToneDocsInkColor">#234D9E</Color>
    <Color x:Key="DeployToneCommsFillColor">#EBF7FC</Color>
    <Color x:Key="DeployToneCommsBadgeColor">#CFEEFA</Color>
    <Color x:Key="DeployToneCommsInkColor">#1A6282</Color>
    <Color x:Key="DeployToneUtilFillColor">#EBF7F5</Color>
    <Color x:Key="DeployToneUtilBadgeColor">#CCEAE6</Color>
    <Color x:Key="DeployToneUtilInkColor">#18635B</Color>

    <SolidColorBrush x:Key="DeployCanvasBrush" Color="{StaticResource DeployCanvasColor}"/>
    <SolidColorBrush x:Key="DeployCardBrush" Color="{StaticResource DeployCardColor}"/>
    <SolidColorBrush x:Key="DeployCardHoverBrush" Color="{StaticResource DeployCardHoverColor}"/>
    <SolidColorBrush x:Key="DeployFieldBrush" Color="{StaticResource DeployFieldColor}"/>
    <SolidColorBrush x:Key="DeployCodeBrush" Color="{StaticResource DeployCodeColor}"/>
    <SolidColorBrush x:Key="DeployBorderBrush" Color="{StaticResource DeployBorderColor}"/>
    <SolidColorBrush x:Key="DeployBorderHoverBrush" Color="{StaticResource DeployBorderHoverColor}"/>
    <SolidColorBrush x:Key="DeployMutedTextBrush" Color="{StaticResource DeployMutedTextColor}"/>
    <SolidColorBrush x:Key="DeployAccentBrush" Color="{StaticResource DeployAccentColor}"/>
    <SolidColorBrush x:Key="DeployAccentHoverBrush" Color="{StaticResource DeployAccentHoverColor}"/>
    <SolidColorBrush x:Key="DeployAccentPressedBrush" Color="{StaticResource DeployAccentPressedColor}"/>
    <SolidColorBrush x:Key="DeployAccentSoftBrush" Color="{StaticResource DeployAccentSoftColor}"/>
    <SolidColorBrush x:Key="DeployAccentLineBrush" Color="{StaticResource DeployAccentLineColor}"/>
    <SolidColorBrush x:Key="DeployAccentTextBrush" Color="{StaticResource DeployAccentTextColor}"/>
    <SolidColorBrush x:Key="DeployBarButtonBrush" Color="{StaticResource DeployBarButtonColor}"/>
    <SolidColorBrush x:Key="DeployBarButtonHoverBrush" Color="{StaticResource DeployBarButtonHoverColor}"/>
    <SolidColorBrush x:Key="DeployOnAccentMutedBrush" Color="{StaticResource DeployOnAccentMutedColor}"/>
    <SolidColorBrush x:Key="DeployHeroPanelBrush" Color="#26FFFFFF"/>
    <SolidColorBrush x:Key="DeployOnAccentLayerBrush" Color="#38FFFFFF"/>
    <LinearGradientBrush x:Key="DeployHeroBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource DeployHeroStartColor}" Offset="0"/>
        <GradientStop Color="{StaticResource DeployHeroEndColor}" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="DeployToneBrowserFillBrush" Color="{StaticResource DeployToneBrowserFillColor}"/>
    <SolidColorBrush x:Key="DeployToneBrowserBadgeBrush" Color="{StaticResource DeployToneBrowserBadgeColor}"/>
    <SolidColorBrush x:Key="DeployToneBrowserInkBrush" Color="{StaticResource DeployToneBrowserInkColor}"/>
    <SolidColorBrush x:Key="DeployToneDevFillBrush" Color="{StaticResource DeployToneDevFillColor}"/>
    <SolidColorBrush x:Key="DeployToneDevBadgeBrush" Color="{StaticResource DeployToneDevBadgeColor}"/>
    <SolidColorBrush x:Key="DeployToneDevInkBrush" Color="{StaticResource DeployToneDevInkColor}"/>
    <SolidColorBrush x:Key="DeployToneDocsFillBrush" Color="{StaticResource DeployToneDocsFillColor}"/>
    <SolidColorBrush x:Key="DeployToneDocsBadgeBrush" Color="{StaticResource DeployToneDocsBadgeColor}"/>
    <SolidColorBrush x:Key="DeployToneDocsInkBrush" Color="{StaticResource DeployToneDocsInkColor}"/>
    <SolidColorBrush x:Key="DeployToneCommsFillBrush" Color="{StaticResource DeployToneCommsFillColor}"/>
    <SolidColorBrush x:Key="DeployToneCommsBadgeBrush" Color="{StaticResource DeployToneCommsBadgeColor}"/>
    <SolidColorBrush x:Key="DeployToneCommsInkBrush" Color="{StaticResource DeployToneCommsInkColor}"/>
    <SolidColorBrush x:Key="DeployToneUtilFillBrush" Color="{StaticResource DeployToneUtilFillColor}"/>
    <SolidColorBrush x:Key="DeployToneUtilBadgeBrush" Color="{StaticResource DeployToneUtilBadgeColor}"/>
    <SolidColorBrush x:Key="DeployToneUtilInkBrush" Color="{StaticResource DeployToneUtilInkColor}"/>
</ResourceDictionary>
