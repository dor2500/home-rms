<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Theme entry point (merged by App.xaml). Keeps every historical key resolvable:
          Tokens.xaml   – colours, legacy brush keys, fonts, type scale, spacing, radii, shadows, motion
          Controls.xaml – icons and all control styles (merges Tokens.xaml itself so StaticResource lookups resolve)
    -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/HomeRmsController;component/Themes/Controls.xaml"/>
    </ResourceDictionary.MergedDictionaries>
</ResourceDictionary>
