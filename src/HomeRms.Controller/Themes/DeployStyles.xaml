<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:deploy="clr-namespace:HomeRms.Controller.Views.Deploy">
    <!--
        Styles and templates for the winstall-style Deploy tab (Views\Deploy\*). Colours come from the
        Deploy* tokens in Tokens.xaml (merged here so StaticResource lookups resolve at load time).
    -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/HomeRmsController;component/Themes/Tokens.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- ===== Icons (24x24 stroke geometry) ===== -->
    <Geometry x:Key="DGeoSearch">M11,4 A7,7 0 1,0 11,18 A7,7 0 1,0 11,4 M16,16 L21,21</Geometry>
    <Geometry x:Key="DGeoCheck">M5,12.5 L10,17 L19,7</Geometry>
    <Geometry x:Key="DGeoTrash">M4,7 H20 M10,11 V17 M14,11 V17 M6,7 L7,20 H17 L18,7 M9,7 V4 H15 V7</Geometry>
    <Geometry x:Key="DGeoDownload">M12,4 V16 M7,11 L12,16 L17,11 M4,20 H20</Geometry>
    <Geometry x:Key="DGeoUpload">M12,20 V8 M7,13 L12,8 L17,13 M4,4 H20</Geometry>
    <Geometry x:Key="DGeoCopy">M8,8 H20 V20 H8 Z M16,8 V4 H4 V16 H8</Geometry>
    <Geometry x:Key="DGeoPlus">M12,5 V19 M5,12 H19</Geometry>
    <Geometry x:Key="DGeoClose">M18,6 L6,18 M6,6 L18,18</Geometry>
    <Geometry x:Key="DGeoBack">M15,5 L8,12 L15,19</Geometry>
    <Geometry x:Key="DGeoChevronRight">M9,6 L15,12 L9,18</Geometry>
    <Geometry x:Key="DGeoChevronDown">M6,9 L12,15 L18,9</Geometry>
    <Geometry x:Key="DGeoPackage">M12,3 L20,7.5 V16.5 L12,21 L4,16.5 V7.5 Z M12,12 L20,7.5 M12,12 V21 M12,12 L4,7.5</Geometry>
    <Geometry x:Key="DGeoGlobe">M12,3 A9,9 0 1,0 12,21 A9,9 0 1,0 12,3 M3,12 H21 M12,3 C15,6 15,18 12,21 C9,18 9,6 12,3</Geometry>
    <Geometry x:Key="DGeoCode">M8,8 L4,12 L8,16 M16,8 L20,12 L16,16 M13.5,6 L10.5,18</Geometry>
    <Geometry x:Key="DGeoDoc">M6,3 H14 L19,8 V21 H6 Z M14,3 V8 H19 M9,13 H16 M9,17 H16</Geometry>
    <Geometry x:Key="DGeoChat">M4,5 H20 V16 H10 L6,20 V16 H4 Z</Geometry>
    <Geometry x:Key="DGeoWrench">M14.7,6.3 A1,1 0 0,0 14.7,7.7 L16.3,9.3 A1,1 0 0,0 17.7,9.3 L21.47,5.53 A6,6 0 0,1 13.53,13.47 L6.62,20.38 A2.12,2.12 0 0,1 3.62,17.38 L10.53,10.47 A6,6 0 0,1 18.47,2.53 Z</Geometry>
    <Geometry x:Key="DGeoShield">M12,3 L20,6 V12 C20,16.5 16.5,19.5 12,21 C7.5,19.5 4,16.5 4,12 V6 Z</Geometry>
    <Geometry x:Key="DGeoPlay">M4,5 H20 V19 H4 Z M10,9 L15,12 L10,15 Z</Geometry>
    <Geometry x:Key="DGeoImage">M4,5 H20 V19 H4 Z M4,16 L9,11 L13,15 L16,12 L20,16 M15,8.5 H15.01</Geometry>
    <Geometry x:Key="DGeoRefresh">M21,12 A9,9 0 1,1 18.36,5.64 M21,3 V9 H15</Geometry>
    <Geometry x:Key="DGeoServer">M4,4 H20 V10 H4 Z M4,14 H20 V20 H4 Z M8,7 H8.01 M8,17 H8.01</Geometry>
    <Geometry x:Key="DGeoExternal">M14,4 H20 V10 M20,4 L11,13 M18,14 V20 H4 V6 H10</Geometry>
    <Geometry x:Key="DGeoSpark">M12,3 L13.8,9.2 L20,11 L13.8,12.8 L12,19 L10.2,12.8 L4,11 L10.2,9.2 Z</Geometry>

    <Style x:Key="DeployIcon" TargetType="Path">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}"/>
        <Setter Property="StrokeThickness" Value="2"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>

    <!-- ===== Text ===== -->
    <Style x:Key="DeployH1" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="DeployH2" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
        <Setter Property="FontSize" Value="21"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>
    <Style x:Key="DeployLead" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource DeployMutedTextBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="DeployCardTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="DeployMeta" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{StaticResource DeployMutedTextBrush}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="DeployLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <!-- Status colour per deploy state (cards, queue rows, file rows) -->
    <Style x:Key="DeployStatusText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding DeployStatus}" Value="Queued"><Setter Property="Foreground" Value="{StaticResource DeployAccentTextBrush}"/></DataTrigger>
            <DataTrigger Binding="{Binding DeployStatus}" Value="Downloading"><Setter Property="Foreground" Value="{StaticResource InfoBrush}"/></DataTrigger>
            <DataTrigger Binding="{Binding DeployStatus}" Value="Installing"><Setter Property="Foreground" Value="{StaticResource InfoBrush}"/></DataTrigger>
            <DataTrigger Binding="{Binding DeployStatus}" Value="Success"><Setter Property="Foreground" Value="{StaticResource OkBrush}"/></DataTrigger>
            <DataTrigger Binding="{Binding DeployStatus}" Value="Skipped"><Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/></DataTrigger>
            <DataTrigger Binding="{Binding DeployStatus}" Value="Failed"><Setter Property="Foreground" Value="{StaticResource DangerBrush}"/></DataTrigger>
            <DataTrigger Binding="{Binding DeployStatus}" Value="Cancelled"><Setter Property="Foreground" Value="{StaticResource WarnBrush}"/></DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ===== Navigation tabs (Discover | Apps | Essentials | Packs | Files) ===== -->
    <Style x:Key="DeployNavTab" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource DeployMutedTextBrush}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,4,0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="{StaticResource DeployRadiusControl}" Padding="14,8">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource DeployCardBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource DeployAccentTextBrush}"/>
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource DeployAccentSoftBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource DeployAccentBrush}"/>
                            <Setter TargetName="Bd" Property="BorderThickness" Value="1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Pill tabs / filter chips (Install view tabs, Install|Upgrade, category filters) -->
    <Style x:Key="DeployPillTab" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Background" Value="{StaticResource DeployCardBrush}"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="Margin" Value="0,0,8,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="{StaticResource DeployRadiusPill}"
                            Padding="{TemplateBinding Padding}" BorderBrush="Transparent" BorderThickness="1">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource DeployCardHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource DeployAccentBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextOnAccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource DeployAccentLineBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Buttons ===== -->
    <Style x:Key="DeployButtonBase" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Background" Value="{StaticResource DeployCardBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource DeployBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="16,9"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource DeployRadiusControl}"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource DeployCardHoverBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource DeployBorderHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource DeployAccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="DeployDarkButton" TargetType="Button" BasedOn="{StaticResource DeployButtonBase}"/>

    <Style x:Key="DeployAccentButton" TargetType="Button" BasedOn="{StaticResource DeployButtonBase}">
        <Setter Property="Foreground" Value="{StaticResource TextOnAccentBrush}"/>
        <Setter Property="Background" Value="{StaticResource DeployAccentBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource DeployAccentBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource DeployRadiusControl}"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource DeployAccentHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource DeployAccentPressedBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource TextPrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Text-only link button ("View all apps ›", "Back") -->
    <Style x:Key="DeployLinkButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource DeployAccentTextBrush}"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" Padding="6,4" CornerRadius="6">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource DeployAccentSoftBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Dark pill buttons on the purple selection bar -->
    <Style x:Key="DeployBarButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextOnAccentBrush}"/>
        <Setter Property="Background" Value="{StaticResource DeployBarButtonBrush}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Padding" Value="18,10"/>
        <Setter Property="Margin" Value="8,0,0,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="22" Padding="{TemplateBinding Padding}"
                            BorderBrush="Transparent" BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource DeployBarButtonHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource TextPrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Small round icon button (remove ×, trash on the bar) -->
    <Style x:Key="DeployRoundButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource DeployMutedTextBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="22" BorderBrush="Transparent" BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverLayerBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource DeployAccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Clickable card (app cards, category tiles, pack cards): hover lifts with a light layer + border -->
    <Style x:Key="DeployCardButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Background" Value="{StaticResource DeployCardBrush}"/>
        <Setter Property="Padding" Value="18,16"/>
        <Setter Property="Margin" Value="0,0,14,14"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="{StaticResource DeployRadiusCard}"
                                BorderBrush="Transparent" BorderThickness="1.5" SnapsToDevicePixels="True"/>
                        <Border x:Name="Hover" Background="{StaticResource HoverLayerBrush}" CornerRadius="{StaticResource DeployRadiusCard}" Opacity="0"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource MotionFast}"/></Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource MotionBase}"/></Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource DeployBorderHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource DeployAccentBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Round select toggle on cards: hollow ring -> filled purple with a check (bound to WingetAppItem.IsSelected) -->
    <Style x:Key="DeploySelectToggle" TargetType="Button">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="ToolTip" Value="Select / deselect"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Ellipse x:Name="Ring" Stroke="{StaticResource DeployBorderHoverBrush}" StrokeThickness="2" Fill="Transparent"/>
                        <Path x:Name="Tick" Data="{StaticResource DGeoCheck}" Stroke="{StaticResource TextOnAccentBrush}" StrokeThickness="2.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform"
                              Width="12" Height="12" Opacity="0" IsHitTestVisible="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource DeployAccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource DeployAccentBrush}"/>
                        </Trigger>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter TargetName="Ring" Property="Fill" Value="{StaticResource DeployAccentBrush}"/>
                            <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource DeployAccentBrush}"/>
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard><DoubleAnimation Storyboard.TargetName="Tick" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource MotionFast}"/></Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard><DoubleAnimation Storyboard.TargetName="Tick" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource MotionFast}"/></Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Inputs ===== -->
    <Style x:Key="DeploySearchBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Background" Value="{StaticResource DeployFieldBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource DeployBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CaretBrush" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource DeployAccentBrush}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Height" Value="42"/>
        <Setter Property="Padding" Value="40,0,12,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" SnapsToDevicePixels="True">
                        <Grid>
                            <Path Data="{StaticResource DGeoSearch}" Stroke="{StaticResource DeployMutedTextBrush}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="15" Height="15" Stretch="Uniform"
                                  HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,0,0,0" IsHitTestVisible="False"/>
                            <TextBlock x:Name="Hint" Text="{TemplateBinding Tag}" Foreground="{StaticResource DeployMutedTextBrush}"
                                       Margin="{TemplateBinding Padding}" Padding="2,0,0,0" VerticalAlignment="Center"
                                       IsHitTestVisible="False" Visibility="Collapsed" TextTrimming="CharacterEllipsis"/>
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Hint" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource DeployBorderHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource DeployAccentBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Plain rounded field with a placeholder (Tag) -->
    <Style x:Key="DeployField" TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Background" Value="{StaticResource DeployFieldBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource DeployBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CaretBrush" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource DeployAccentBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource DeployRadiusControl}" SnapsToDevicePixels="True">
                        <Grid>
                            <TextBlock x:Name="Hint" Text="{TemplateBinding Tag}" Foreground="{StaticResource DeployMutedTextBrush}"
                                       Margin="{TemplateBinding Padding}" Padding="2,8,0,8" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                       IsHitTestVisible="False" Visibility="Collapsed" TextTrimming="CharacterEllipsis"/>
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Hint" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource DeployBorderHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource DeployAccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Read-only code box (generated scripts, logs) -->
    <Style x:Key="DeployCodeBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Background" Value="{StaticResource DeployCodeBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource DeployBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="SelectionBrush" Value="{StaticResource DeployAccentBrush}"/>
        <Setter Property="CaretBrush" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="Padding" Value="14,12"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="AcceptsReturn" Value="True"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="VerticalContentAlignment" Value="Top"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Purple check box / radio (winstall options) -->
    <Style x:Key="DeployCheck" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box" Width="20" Height="20" CornerRadius="6" Background="{StaticResource DeployFieldBrush}"
                                BorderBrush="{StaticResource DeployBorderHoverBrush}" BorderThickness="1.5" VerticalAlignment="Center">
                            <Path x:Name="Tick" Data="{StaticResource DGeoCheck}" Stroke="{StaticResource TextOnAccentBrush}" StrokeThickness="2.4"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" Width="11" Height="11" Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource DeployAccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource DeployAccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource DeployAccentBrush}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource DeployAccentBrush}"/>
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DeployRadio" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,20,0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Grid Width="20" Height="20" VerticalAlignment="Center">
                            <Ellipse x:Name="Ring" Stroke="{StaticResource DeployBorderHoverBrush}" StrokeThickness="1.5" Fill="{StaticResource DeployFieldBrush}"/>
                            <Ellipse x:Name="Dot" Width="10" Height="10" Fill="{StaticResource DeployAccentBrush}" Visibility="Collapsed"/>
                        </Grid>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource DeployAccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource DeployAccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource DeployAccentBrush}"/>
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Rounded card container (non-clickable) -->
    <Style x:Key="DeployPanelCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource DeployCardBrush}"/>
        <Setter Property="CornerRadius" Value="{StaticResource DeployRadiusCard}"/>
        <Setter Property="Padding" Value="20,18"/>
    </Style>

    <!-- Tag chip on the app page -->
    <Style x:Key="DeployChip" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource DeployCardBrush}"/>
        <Setter Property="CornerRadius" Value="{StaticResource DeployRadiusPill}"/>
        <Setter Property="Padding" Value="12,5"/>
        <Setter Property="Margin" Value="0,0,8,8"/>
    </Style>

    <!-- ===== Shared item templates ===== -->

    <!-- Apps grid card: icon + bold name + publisher, description, select toggle top-right -->
    <DataTemplate x:Key="DeployAppCardTemplate">
        <Button Style="{StaticResource DeployCardButton}" Height="164" Command="{x:Static deploy:DeployCommands.OpenApp}" CommandParameter="{Binding}"
                ToolTip="{Binding Id}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <Button DockPanel.Dock="Right" Style="{StaticResource DeploySelectToggle}" VerticalAlignment="Top"
                            Command="{x:Static deploy:DeployCommands.ToggleApp}" CommandParameter="{Binding}"/>
                    <deploy:AppIcon Size="42" Margin="0,0,12,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource DeployCardTitle}" FontSize="16"/>
                        <TextBlock Text="{Binding Publisher}" Style="{StaticResource DeployMeta}" Margin="0,2,0,0"/>
                    </StackPanel>
                </DockPanel>
                <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding StatusLabel}" Style="{StaticResource DeployStatusText}" Visibility="{Binding DetailVisibility}"/>
                    <ProgressBar Style="{DynamicResource ThinProgressBar}" Value="{Binding ProgressValue, Mode=OneWay}" IsIndeterminate="{Binding IsIndeterminate, Mode=OneWay}"
                                 Visibility="{Binding ProgressVisibility}" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBlock Text="{Binding Description}" FontSize="13.5" Foreground="{StaticResource DeployMutedTextBrush}" TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis" LineHeight="19" LineStackingStrategy="BlockLineHeight"/>
            </DockPanel>
        </Button>
    </DataTemplate>

    <!-- Trending card (Discover): icon + bold name + publisher -->
    <DataTemplate x:Key="DeployTrendingCardTemplate">
        <Button Style="{StaticResource DeployCardButton}" Padding="16,14" Command="{x:Static deploy:DeployCommands.OpenApp}" CommandParameter="{Binding}"
                ToolTip="{Binding Description}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource DeploySelectToggle}" Width="24" Height="24" VerticalAlignment="Center"
                        Command="{x:Static deploy:DeployCommands.ToggleApp}" CommandParameter="{Binding}"/>
                <deploy:AppIcon Size="40" Margin="0,0,12,0"/>
                <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock Text="{Binding Name}" Style="{StaticResource DeployCardTitle}"/>
                    <TextBlock Text="{Binding Publisher}" Style="{StaticResource DeployMeta}" Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>
        </Button>
    </DataTemplate>

    <!-- Category tile: tinted fill, bold label, icon badge on the right -->
    <DataTemplate x:Key="DeployCategoryTileTemplate">
        <Button Style="{StaticResource DeployCardButton}" Background="{Binding Fill}" Height="64" Padding="16,0"
                Command="{x:Static deploy:DeployCommands.OpenCategory}" CommandParameter="{Binding Slug}">
            <DockPanel VerticalAlignment="Center">
                <Border DockPanel.Dock="Right" Width="34" Height="34" CornerRadius="10" Background="{Binding Badge}">
                    <Path Data="{Binding Icon}" Stroke="{Binding Ink}" StrokeThickness="2.2" Width="16" Height="16" Stretch="Uniform"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                </Border>
                <TextBlock Text="{Binding Label}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
            </DockPanel>
        </Button>
    </DataTemplate>

    <!-- Pack card: title, 2-line description, 5 apps (icon + name), "+N more", actions -->
    <DataTemplate x:Key="DeployPackCardTemplate">
        <Border Style="{StaticResource DeployPanelCard}" Margin="0,0,14,14" Padding="20,18">
            <DockPanel>
                <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <Button DockPanel.Dock="Right" Style="{StaticResource DeployRoundButton}" ToolTip="Delete this custom pack"
                            Visibility="{Binding DeleteVisibility}" Command="{x:Static deploy:DeployCommands.DeletePack}" CommandParameter="{Binding}">
                        <Path Data="{StaticResource DGeoTrash}" Style="{StaticResource DeployIcon}" Width="14" Height="14"/>
                    </Button>
                    <Button Style="{StaticResource DeployAccentButton}" Padding="14,7" HorizontalAlignment="Left" FontSize="13"
                            Command="{x:Static deploy:DeployCommands.SelectPack}" CommandParameter="{Binding}" ToolTip="Add every app in this pack to the selection">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource DGeoPlus}" Style="{StaticResource DeployIcon}" Width="12" Height="12" Margin="0,0,6,0"/>
                            <TextBlock Text="Select apps"/>
                        </StackPanel>
                    </Button>
                </DockPanel>
                <StackPanel>
                    <DockPanel Margin="0,0,0,4">
                        <Border DockPanel.Dock="Right" Background="{StaticResource DeployAccentSoftBrush}" CornerRadius="8" Padding="8,2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Badge}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource DeployAccentTextBrush}"/>
                        </Border>
                        <TextBlock Text="{Binding Title}" Style="{StaticResource DeployCardTitle}" FontSize="16" Margin="0,0,8,0"/>
                    </DockPanel>
                    <TextBlock Text="{Binding Description}" Style="{StaticResource DeployMeta}" FontSize="13" TextWrapping="Wrap" Height="36"
                               TextTrimming="CharacterEllipsis" Margin="0,0,0,12"/>
                    <ItemsControl ItemsSource="{Binding Apps}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,0,0,8">
                                    <deploy:AppIcon Size="26" Margin="0,0,10,0"/>
                                    <TextBlock Text="{Binding Name}" FontSize="13.5" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding MoreText}" Style="{StaticResource DeployMeta}" Margin="36,0,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </DataTemplate>

    <!-- Compact selectable row (Essentials, selection list) -->
    <DataTemplate x:Key="DeployEssentialRowTemplate">
        <Button Style="{StaticResource DeployCardButton}" Padding="12,10" Margin="0,0,10,10"
                Command="{x:Static deploy:DeployCommands.ToggleApp}" CommandParameter="{Binding}" ToolTip="{Binding Description}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource DeploySelectToggle}" Width="22" Height="22" IsHitTestVisible="False" Focusable="False"/>
                <deploy:AppIcon Size="28" Margin="0,0,10,0"/>
                <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
            </DockPanel>
        </Button>
    </DataTemplate>
</ResourceDictionary>
