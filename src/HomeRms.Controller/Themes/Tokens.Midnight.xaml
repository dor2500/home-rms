    <Color x:Key="OverlayColor">#121824</Color>
    <Color x:Key="FieldColor">#080B10</Color>
    <Color x:Key="SunkenColor">#030407</Color>

    <Color x:Key="BorderSubtleColor">#1B2333</Color>
    <Color x:Key="BorderStrongColor">#2B374F</Color>

    <Color x:Key="TextPrimaryColor">#EDF2F7</Color>
    <Color x:Key="TextSecondaryColor">#A0AEC0</Color>
    <Color x:Key="TextMutedColor">#718096</Color>
    <Color x:Key="TextDisabledColor">#4A5568</Color>

    <Color x:Key="AccentColor">#38BDF8</Color>
    <Color x:Key="AccentStrongColor">#0284C7</Color>
    <Color x:Key="AccentStrongHoverColor">#0EA5E9</Color>
    <Color x:Key="AccentSoftColor">#2438BDF8</Color>
    <Color x:Key="AccentLineColor">#4D38BDF8</Color>

