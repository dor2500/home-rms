    <SolidColorBrush x:Key="RowDividerBrush" Color="#10FFFFFF"/>
    <SolidColorBrush x:Key="HoverLayerBrush" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="TrackBrush" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="BorderHoverBrush" Color="#3B4B6B"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#2C3850"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#47597D"/>
    <SolidColorBrush x:Key="QrBackgroundBrush" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="DeepBgBrush" Color="{StaticResource CanvasColor}"/>
    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource CanvasColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource ElevatedColor}"/>
    <SolidColorBrush x:Key="CardHoverBrush" Color="{StaticResource ElevatedHoverColor}"/>
    <SolidColorBrush x:Key="FieldBrush" Color="{StaticResource FieldColor}"/>
