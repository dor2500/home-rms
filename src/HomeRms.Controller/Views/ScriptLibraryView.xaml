<UserControl x:Class="HomeRms.Controller.Views.ScriptLibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <!-- Header -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="Script library" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Saved PowerShell / cmd snippets. Run them on many endpoints at once; every command is recorded in each agent's activity log."
                       Style="{StaticResource PageSubtitle}" TextTrimming="CharacterEllipsis"/>
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== Snippet list ===== -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="10">
                <DockPanel>
                    <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}" Tag="Search scripts..." DockPanel.Dock="Top" Margin="0,0,0,8" TextChanged="OnSearchChanged" ToolTip="Search name, description, tags"/>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="New" Style="{StaticResource SmallPillButton}" Margin="0,0,4,0" Click="OnNewClick"/>
                        <Button Content="Duplicate" Style="{StaticResource SmallPillButton}" Margin="0,0,4,0" Click="OnDuplicateClick"/>
                        <Button Content="Delete" Style="{StaticResource SmallPillButton}" Click="OnDeleteClick"/>
                    </StackPanel>
                    <ListBox x:Name="SnippetList" Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource LineBrush}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="OnSnippetSelected">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,2">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding ShellText}" FontFamily="{StaticResource MonoFont}" FontSize="9.5"
                                                   Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                    <TextBlock Text="{Binding TagsText}" FontSize="10.5" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ===== Editor ===== -->
                <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="12,10">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="200"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="NAME" Style="{StaticResource Caption}"/>
                                <TextBox x:Name="NameBox"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="SHELL" Style="{StaticResource Caption}"/>
                                <ComboBox x:Name="ShellCombo" SelectedIndex="0">
                                    <ComboBoxItem Content="PowerShell"/>
                                    <ComboBoxItem Content="cmd"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="TAGS (COMMA SEPARATED)" Style="{StaticResource Caption}"/>
                                <TextBox x:Name="TagsBox"/>
                            </StackPanel>
                        </Grid>
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <TextBlock Text="DESCRIPTION" Style="{StaticResource Caption}"/>
                            <TextBox x:Name="DescriptionBox"/>
                        </StackPanel>
                        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button x:Name="RevertBtn" Content="Revert" Style="{StaticResource SmallPillButton}" Margin="0,0,5,0" Click="OnRevertClick"/>
                                <Button x:Name="SaveBtn" Content="Save" Style="{StaticResource PrimaryButton}" Padding="12,4" Click="OnSaveClick"/>
                            </StackPanel>
                            <TextBlock x:Name="EditorNote" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </DockPanel>
                        <TextBox x:Name="BodyBox" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 FontFamily="{StaticResource MonoFont}" FontSize="12" Background="{StaticResource FieldBrush}"/>
                    </DockPanel>
                </Border>

                <!-- ===== Run ===== -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="10">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                <Button DockPanel.Dock="Right" Content="Online" Style="{StaticResource SmallPillButton}" Padding="6,2" FontSize="10.5"
                                        Margin="4,0,0,0" Click="OnPickOnlineClick" ToolTip="Tick every online Windows endpoint"/>
                                <Button DockPanel.Dock="Right" Content="Fleet sel." Style="{StaticResource SmallPillButton}" Padding="6,2" FontSize="10.5"
                                        Click="OnPickFleetSelectionClick" ToolTip="Tick the endpoints selected in the Endpoints view"/>
                                <TextBlock Text="TARGETS" Style="{StaticResource Caption}" Margin="0" VerticalAlignment="Center"/>
                            </DockPanel>
                            <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                <DockPanel Margin="0,0,0,6">
                                    <TextBox x:Name="TimeoutBox" DockPanel.Dock="Right" Width="44" Text="15" FontFamily="{StaticResource MonoFont}" FontSize="11"/>
                                    <TextBlock Text="Timeout (min)" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                                </DockPanel>
                                <DockPanel>
                                    <Button x:Name="CancelRunBtn" DockPanel.Dock="Right" Content="Cancel" Style="{StaticResource SmallPillButton}" Margin="5,0,0,0"
                                            IsEnabled="False" Click="OnCancelRunClick"/>
                                    <Button x:Name="RunBtn" Content="Run" Style="{StaticResource PrimaryButton}" Padding="10,5" Click="OnRunClick"/>
                                </DockPanel>
                            </StackPanel>
                            <ListBox x:Name="TargetsList" Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource LineBrush}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsChecked}" Checked="OnTargetToggled" Unchecked="OnTargetToggled">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="6" Height="6" Fill="{Binding Profile.DotBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Profile.DisplayTitle}" FontSize="11.5"/>
                                                <TextBlock Text="{Binding Profile.ModeBadge}" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </CheckBox>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto" MinHeight="70"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="RunCaption" Grid.Row="0" Text="RESULTS" Style="{StaticResource Caption}"/>
                            <DataGrid x:Name="RunsGrid" Grid.Row="1" MaxHeight="150" AutoGenerateColumns="False" IsReadOnly="True"
                                      HeadersVisibility="Column" GridLinesVisibility="None" SelectionMode="Single"
                                      Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource LineBrush}"
                                      SelectionChanged="OnRunSelected">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Endpoint" Binding="{Binding EndpointName}" Width="150"/>
                                    <DataGridTextColumn Header="State" Binding="{Binding StateText}" Width="90"/>
                                    <DataGridTextColumn Header="Time" Binding="{Binding DurationText}" Width="60"/>
                                    <DataGridTextColumn Header="Summary" Binding="{Binding Summary}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBox x:Name="OutputBox" Grid.Row="2" Margin="0,8,0,0" IsReadOnly="True" TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                     FontFamily="{StaticResource MonoFont}" FontSize="11.5" Background="{StaticResource FieldBrush}"
                                     Text="Select a result row to see that endpoint's output."/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
