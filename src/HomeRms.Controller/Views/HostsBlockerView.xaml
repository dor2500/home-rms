<UserControl x:Class="HomeRms.Controller.Views.HostsBlockerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <!-- Header -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Endpoint" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="EndpointCombo" Width="230" Margin="0,0,6,0" DisplayMemberPath="DisplayTitle" SelectionChanged="OnEndpointComboChanged"/>
                <Button Content="Load" Style="{StaticResource PrimaryButton}" Padding="12,5" Click="OnLoadClick"/>
            </StackPanel>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Hosts &amp; website blocker" Style="{StaticResource PageTitle}"/>
                <TextBlock x:Name="SubtitleText" Text="Manage blocked domains, edit the system hosts file safely, and optionally enable real-time blocked-access alerts."
                           Style="{StaticResource PageSubtitle}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </DockPanel>

        <!-- Endpoint status + Listener bar -->
        <Border DockPanel.Dock="Top" Style="{StaticResource CardStyle}" Padding="14,10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock x:Name="HostsPathText" Text="Path: --" FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold" Margin="0,0,14,0"/>
                        <Border x:Name="ElevationBadge" Style="{StaticResource Pill}" Background="{DynamicResource NeutralSoftBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Margin="0,0,8,0">
                            <TextBlock x:Name="ElevationText" Text="Not loaded" Style="{StaticResource PillText}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Border>
                        <TextBlock x:Name="EncodingText" Text="" Style="{StaticResource MonoMeta}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="ListenerSummaryText" Text="Listener off (blocked domains map to 0.0.0.0; ports 80/443 are not bound)."
                               Style="{StaticResource MetaText}" TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <CheckBox x:Name="ListenerEnabledCheck" Content="Enable Blocked-Access Listener &amp; Alerts"
                              VerticalAlignment="Center" Margin="0,0,12,0"
                              ToolTip="OFF by default. When ON, maps blocked domains to the loopback IP and listens on ports 80/443 to report blocked-site attempts."/>
                    <TextBlock Text="Loopback IP" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="LoopbackIpBox" Width="108" FontFamily="{StaticResource MonoFont}" Text="127.0.0.1" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <Button x:Name="ApplyListenerBtn" Content="Apply listener" Style="{StaticResource SmallPillButton}" Click="OnApplyListenerClick"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Operation steps / status -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource WellStyle}" Padding="10,8" Margin="0,10,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" x:Name="BackupPathText" Text="" Style="{StaticResource MonoMeta}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                <TextBlock x:Name="StatusText" Text="Select an agent endpoint and click Load." FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                           Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
            </DockPanel>
        </Border>

        <!-- Main Tabs: Quick Block List | Raw Hosts Editor | Push to Multiple -->
        <TabControl x:Name="Tabs" Background="Transparent" BorderThickness="0">
            <!-- Tab 1: Quick Block List -->
            <TabItem Header="Quick block list">
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="320"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                <Button DockPanel.Dock="Right" Content="Add domain" Style="{StaticResource PrimaryButton}" Padding="12,5" Click="OnAddDomainClick"/>
                                <TextBox x:Name="NewDomainBox" Style="{StaticResource SearchBox}" Tag="Add domain to block (e.g. facebook.com, tiktok.com)..."
                                         Margin="0,0,8,0" KeyDown="OnNewDomainKeyDown"/>
                            </DockPanel>

                            <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="Remove selected" Style="{StaticResource SmallPillButton}" Margin="0,0,6,0" Click="OnRemoveDomainClick"/>
                                    <Button Content="Dry run" Style="{StaticResource SmallPillButton}" Margin="0,0,6,0" Click="OnDryRunBlocklistClick"/>
                                    <Button x:Name="SaveBlocklistBtn" Content="Save blocklist" Style="{StaticResource PrimaryButton}" Padding="14,5" Click="OnSaveBlocklistClick"/>
                                </StackPanel>
                                <CheckBox x:Name="IncludeWwwCheck" Content="Automatically include www. subdomains" IsChecked="True" VerticalAlignment="Center"/>
                            </DockPanel>

                            <ListBox x:Name="DomainsList" SelectionMode="Extended"
                                     Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                     Padding="4" FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FontSizeSmall}"/>
                        </DockPanel>
                    </Border>

                    <!-- Multi-endpoint push panel -->
                    <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Multi-endpoint push" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                            <TextBlock DockPanel.Dock="Top" Text="Check agent endpoints below to push this blocklist (and listener state) to multiple PCs at once."
                                       Style="{StaticResource MetaText}" TextWrapping="Wrap" Margin="0,0,0,10"/>

                            <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                                <CheckBox x:Name="PushListenerTooCheck" Content="Also apply listener setting above" IsChecked="False" Margin="0,0,0,8"/>
                                <Button x:Name="PushMultiBtn" Content="Push to checked endpoints" Style="{StaticResource PrimaryButton}" Click="OnPushToTargetsClick"/>
                            </StackPanel>

                            <ListBox x:Name="TargetsList" Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Padding="4">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsChecked}" Content="{Binding Label}" Margin="4,3"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Tab 2: Raw Hosts Editor (Advanced) -->
            <TabItem Header="Raw hosts editor (advanced)">
                <Border Style="{StaticResource CardStyle}" Margin="0,8,0,0">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="Validate syntax" Style="{StaticResource SmallPillButton}" Margin="0,0,6,0" Click="OnValidateRawClick"/>
                                <Button Content="Reload from agent" Style="{StaticResource SmallPillButton}" Margin="0,0,6,0" Click="OnLoadClick"/>
                                <Button x:Name="SaveRawBtn" Content="Save raw hosts file" Style="{StaticResource PrimaryButton}" Padding="14,5" Click="OnSaveRawClick"/>
                            </StackPanel>
                            <TextBlock Text="Entries managed by Home RMS live between # BEGIN HOME-RMS BLOCKLIST and # END HOME-RMS BLOCKLIST."
                                       Style="{StaticResource MetaText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                        </DockPanel>

                        <TextBox x:Name="RawHostsBox" AcceptsReturn="True" AcceptsTab="True"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 FontFamily="{StaticResource MonoFont}" FontSize="12"
                                 Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource LineBrush}"
                                 Padding="10" VerticalContentAlignment="Top"/>
                    </DockPanel>
                </Border>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
