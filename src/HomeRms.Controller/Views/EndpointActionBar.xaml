<UserControl x:Class="HomeRms.Controller.Views.EndpointActionBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <TextBlock x:Name="CaptionText" DockPanel.Dock="Left" Text="POWER:" Style="{StaticResource Caption}"
                   VerticalAlignment="Center" Margin="0,0,10,0"/>
        <StackPanel x:Name="ButtonsPanel" DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Content="Wake" Tag="wake" Style="{StaticResource SmallPillButton}" Margin="0,0,5,0" Click="OnActionClick"
                    ToolTip="Send a Wake-on-LAN magic packet (asks for the MAC address if it is missing)"/>
            <Button Content="Restart" Tag="restart" Style="{StaticResource SmallPillButton}" Margin="0,0,5,0" Click="OnActionClick"/>
            <Button Content="Shut down" Tag="shutdown" Style="{StaticResource SmallPillButton}" Margin="0,0,5,0" Click="OnActionClick"/>
            <Button Content="Sleep" Tag="sleep" Style="{StaticResource SmallPillButton}" Margin="0,0,5,0" Click="OnActionClick"/>
            <Button Content="Lock" Tag="lock" Style="{StaticResource SmallPillButton}" Margin="0,0,5,0" Click="OnActionClick"/>
            <Button Content="Log off" Tag="logoff" Style="{StaticResource SmallPillButton}" Margin="0,0,5,0" Click="OnActionClick"/>
            <Button Content="Cancel shutdown" Tag="cancel" Style="{StaticResource SmallPillButton}" Margin="0,0,5,0" Click="OnActionClick"
                    ToolTip="Abort a pending restart / shutdown (shutdown /a)"/>
            <Button Content="Edit MAC" Style="{StaticResource SmallPillButton}" Margin="0,0,5,0" Click="OnEditMacClick"
                    ToolTip="Set the Wake-on-LAN MAC address of the selected endpoint"/>
        </StackPanel>
        <TextBlock x:Name="ResultText" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource MutedBrush}"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="8,0,0,0"/>
    </DockPanel>
</UserControl>
