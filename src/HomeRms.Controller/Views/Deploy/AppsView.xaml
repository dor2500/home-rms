<local:DeployGridView x:Class="HomeRms.Controller.Views.Deploy.AppsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:HomeRms.Controller.Views.Deploy"
             x:Name="Root">
    <ScrollViewer x:Name="Scroll" x:FieldModifier="public" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="24,20,10,120">
            <TextBlock x:Name="TitleText" x:FieldModifier="public" Text="All apps" Style="{StaticResource DeployH1}" Margin="0,0,14,18"/>

            <TextBlock Text="Search for apps" Style="{StaticResource DeployLabel}"/>
            <TextBox x:Name="SearchBox" x:FieldModifier="public" Style="{StaticResource DeploySearchBox}" Tag="Search by name, ID, publisher or tag"
                     Width="640" HorizontalAlignment="Left" Margin="0,0,14,14"/>

            <WrapPanel x:Name="CategoryPills" x:FieldModifier="public" Margin="0,0,14,6"/>

            <TextBlock x:Name="ResultText" x:FieldModifier="public" Style="{StaticResource DeployMeta}" Margin="0,0,14,14" TextWrapping="Wrap" TextTrimming="None"/>

            <ItemsControl x:Name="AppsList" x:FieldModifier="public" ItemTemplate="{StaticResource DeployAppCardTemplate}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="{Binding Columns, ElementName=Root}" VerticalAlignment="Top"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <TextBlock x:Name="EmptyText" x:FieldModifier="public" Style="{StaticResource DeployLead}" Visibility="Collapsed" Margin="0,20,14,0"
                       Text="No apps match this search."/>
            <Button x:Name="LoadMoreBtn" x:FieldModifier="public" Style="{StaticResource DeployDarkButton}" Content="Load more" HorizontalAlignment="Center"
                    Margin="0,10,14,0" Visibility="Collapsed"/>
        </StackPanel>
    </ScrollViewer>
</local:DeployGridView>
