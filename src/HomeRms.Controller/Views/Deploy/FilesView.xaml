<UserControl x:Class="HomeRms.Controller.Views.Deploy.FilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="24,20,24,120">
            <TextBlock Text="Deploy files" Style="{StaticResource DeployH1}"/>
            <TextBlock Style="{StaticResource DeployLead}" Margin="0,6,0,20"
                       Text="Stream local installers and scripts to the connected agent over mTLS and run them silently. Files can be dropped anywhere on the Deploy tab."/>

            <!-- Drop zone -->
            <Grid Margin="0,0,0,18" MinHeight="150">
                <Rectangle RadiusX="16" RadiusY="16" Stroke="{DynamicResource DeployBorderHoverBrush}" StrokeThickness="2" StrokeDashArray="5 4"
                           Fill="{DynamicResource DeployFieldBrush}"/>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                    <Border Width="52" Height="52" CornerRadius="14" Background="{DynamicResource DeployAccentSoftBrush}" HorizontalAlignment="Center">
                        <Path Data="{StaticResource DGeoUpload}" Stroke="{DynamicResource DeployAccentTextBrush}" StrokeThickness="2" Width="22" Height="22" Stretch="Uniform"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                    </Border>
                    <TextBlock Text="Drop .exe, .msi, .msp, .ps1, .cmd or .bat files here" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,4"/>
                    <TextBlock Text="or" Style="{StaticResource DeployMeta}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <Button x:Name="BrowseBtn" x:FieldModifier="public" Content="Browse files…" Style="{StaticResource DeployAccentButton}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- Options & actions -->
            <WrapPanel Margin="0,0,0,14">
                <TextBox x:Name="PathBox" x:FieldModifier="public" Style="{StaticResource DeployField}" Tag="Installer or script path" Width="340" Margin="0,0,8,8"
                         FontFamily="{StaticResource MonoFont}" FontSize="12" ToolTip="Local .exe / .msi / .msp / .ps1 / .cmd / .bat path"/>
                <TextBox x:Name="ArgsBox" x:FieldModifier="public" Style="{StaticResource DeployField}" Tag="Arguments" Text="AUTO" Width="130" Margin="0,0,8,8"
                         FontFamily="{StaticResource MonoFont}" FontSize="12" ToolTip="Installer arguments (AUTO = detect silent flags)"/>
                <Button x:Name="RunFilesBtn" x:FieldModifier="public" Content="Run files" Style="{StaticResource DeployAccentButton}" Margin="0,0,8,8"
                        ToolTip="Upload and run every pending file on the connected agent"/>
                <Button x:Name="RunScriptBtn" x:FieldModifier="public" Content="Run script…" Style="{StaticResource DeployDarkButton}" Margin="0,0,8,8"/>
                <Button x:Name="ClearFilesBtn" x:FieldModifier="public" Content="Clear files" Style="{StaticResource DeployDarkButton}" Margin="0,0,8,8"/>
                <Button x:Name="ClearLogBtn" x:FieldModifier="public" Content="Clear log" Style="{StaticResource DeployDarkButton}" Margin="0,0,8,8"/>
            </WrapPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" MinWidth="260"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource DeployPanelCard}" Padding="14,12" Height="300">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Files" Style="{StaticResource DeployCardTitle}" FontSize="16" Margin="4,0,0,10"/>
                        <Grid>
                            <TextBlock x:Name="EmptyText" Style="{StaticResource DeployMeta}" TextWrapping="Wrap" TextTrimming="None" TextAlignment="Center"
                                       VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12" Text="No files yet. Drop installers or scripts on this page, or click Browse."/>
                            <ListBox x:Name="FileList" x:FieldModifier="public" Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,4">
                                            <DockPanel>
                                                <Button x:Name="RemoveBtn" DockPanel.Dock="Right" Style="{StaticResource DeployRoundButton}" Width="24" Height="24" ToolTip="Remove" Tag="{Binding}">
                                                    <Path Data="{StaticResource DGeoClose}" Style="{StaticResource DeployIcon}" Width="9" Height="9"/>
                                                </Button>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding StatusLabel}" Style="{StaticResource DeployStatusText}" VerticalAlignment="Center" Margin="6,0"/>
                                                <TextBlock Text="{Binding FileName}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}" VerticalAlignment="Center"/>
                                            </DockPanel>
                                            <ProgressBar Style="{DynamicResource ThinProgressBar}" Value="{Binding ProgressValue, Mode=OneWay}" IsIndeterminate="{Binding IsIndeterminate, Mode=OneWay}"
                                                         Visibility="{Binding ProgressVisibility}" Margin="0,4,0,0"/>
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource DeployMeta}" ToolTip="{Binding Detail}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </DockPanel>
                </Border>
                <DockPanel Grid.Column="2" Height="300">
                    <TextBlock DockPanel.Dock="Top" Text="Live log" Style="{StaticResource DeployCardTitle}" FontSize="16" Margin="4,0,0,10"/>
                    <TextBox x:Name="LogBox" x:FieldModifier="public" Style="{StaticResource DeployCodeBox}" FontSize="11.5"/>
                </DockPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
