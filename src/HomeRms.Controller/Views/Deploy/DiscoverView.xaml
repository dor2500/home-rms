<local:DeployGridView x:Class="HomeRms.Controller.Views.Deploy.DiscoverView"
             xmlns:local="clr-namespace:HomeRms.Controller.Views.Deploy"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="24,20,10,120">

            <!-- Compact Home RMS hero (winstall's carousel slot) -->
            <Border Background="{DynamicResource DeployHeroBrush}" CornerRadius="20" Padding="30,26" Margin="0,0,14,30"
                    BorderBrush="{DynamicResource DeployBorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,24,0">
                        <TextBlock Text="Deploy software to your endpoints" Style="{StaticResource DeployH1}" FontSize="30" TextWrapping="Wrap" TextTrimming="None"/>
                        <TextBlock x:Name="HeroLead" x:FieldModifier="public" Style="{StaticResource DeployLead}" FontSize="15" Margin="0,8,0,18" MaxWidth="640" HorizontalAlignment="Left"
                                   Text="Pick apps from the winget catalog, bundle them into packs and push them to every endpoint silently, with live progress."/>
                        <WrapPanel>
                            <Button x:Name="BrowseAppsBtn" x:FieldModifier="public" Style="{StaticResource DeployAccentButton}" Margin="0,0,10,8" Padding="18,10">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource DGeoSearch}" Style="{StaticResource DeployIcon}" Width="14" Height="14" Margin="0,0,8,0"/>
                                    <TextBlock Text="Browse all apps"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="OpenPacksBtn" x:FieldModifier="public" Style="{StaticResource DeployDarkButton}" Margin="0,0,10,8" Padding="18,10">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource DGeoPackage}" Style="{StaticResource DeployIcon}" Width="14" Height="14" Margin="0,0,8,0"/>
                                    <TextBlock Text="Packs"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="RefreshIndexBtn" x:FieldModifier="public" Style="{StaticResource DeployDarkButton}" Margin="0,0,10,8" Padding="18,10"
                                    ToolTip="Check cdn.winget.microsoft.com for a newer winget index">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource DGeoRefresh}" Style="{StaticResource DeployIcon}" Width="14" Height="14" Margin="0,0,8,0"/>
                                    <TextBlock Text="Refresh index"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="UpdateAllBtn" x:FieldModifier="public" Style="{StaticResource DeployDarkButton}" Margin="0,0,10,8" Padding="18,10"
                                    ToolTip="Upgrade every installed package on the target endpoints (opens Deploy to endpoints)">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource DGeoServer}" Style="{StaticResource DeployIcon}" Width="14" Height="14" Margin="0,0,8,0"/>
                                    <TextBlock Text="Update all apps on endpoints"/>
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </StackPanel>
                    <Border Grid.Column="1" Background="{DynamicResource DeployHeroPanelBrush}" CornerRadius="16" Padding="22,18" VerticalAlignment="Center" MinWidth="230" MaxWidth="320">
                        <StackPanel>
                            <TextBlock x:Name="PackageCountText" x:FieldModifier="public" Text="—" FontSize="34" FontWeight="Bold" FontFamily="{StaticResource DisplayFont}"/>
                            <TextBlock Text="packages in the official winget index" Style="{StaticResource DeployMeta}" FontSize="13" TextWrapping="Wrap"/>
                            <Border Height="1" Background="{DynamicResource DeployBorderBrush}" Margin="0,12"/>
                            <TextBlock x:Name="IndexStatusText" x:FieldModifier="public" Style="{StaticResource DeployMeta}" TextWrapping="Wrap" TextTrimming="None"
                                       Text="Loading the official winget index..."/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <TextBlock x:Name="OfflineNote" x:FieldModifier="public" Style="{StaticResource DeployMeta}" Foreground="{DynamicResource WarnBrush}" TextWrapping="Wrap"
                       Margin="0,-18,14,18" Visibility="Collapsed"/>

            <!-- Top Categories -->
            <TextBlock Text="Top Categories" Style="{StaticResource DeployH2}" Margin="0,0,0,14"/>
            <ItemsControl x:Name="CategoryList" x:FieldModifier="public" ItemTemplate="{StaticResource DeployCategoryTileTemplate}" Focusable="False" Margin="0,0,0,26">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="{Binding TileColumns, ElementName=Root}"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <!-- Trending Apps -->
            <DockPanel Margin="0,0,14,14">
                <Button x:Name="ViewAllAppsBtn" x:FieldModifier="public" DockPanel.Dock="Right" Style="{StaticResource DeployLinkButton}" VerticalAlignment="Bottom">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="View all apps"/>
                        <Path Data="{StaticResource DGeoChevronRight}" Style="{StaticResource DeployIcon}" Width="10" Height="10" Margin="6,0,0,0"/>
                    </StackPanel>
                </Button>
                <StackPanel>
                    <TextBlock Text="Trending Apps" Style="{StaticResource DeployH2}"/>
                    <TextBlock x:Name="TrendingSubtitle" x:FieldModifier="public" Text="Popular downloads this week." Style="{StaticResource DeployLead}" Margin="0,4,0,0"/>
                </StackPanel>
            </DockPanel>
            <ItemsControl x:Name="TrendingList" x:FieldModifier="public" ItemTemplate="{StaticResource DeployTrendingCardTemplate}" Focusable="False" Margin="0,0,0,26">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="{Binding Columns, ElementName=Root}"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <!-- Featured Packs -->
            <DockPanel Margin="0,0,14,14">
                <Button x:Name="ViewAllPacksBtn" x:FieldModifier="public" DockPanel.Dock="Right" Style="{StaticResource DeployLinkButton}" VerticalAlignment="Bottom">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="View all packs"/>
                        <Path Data="{StaticResource DGeoChevronRight}" Style="{StaticResource DeployIcon}" Width="10" Height="10" Margin="6,0,0,0"/>
                    </StackPanel>
                </Button>
                <StackPanel>
                    <TextBlock Text="Featured Packs" Style="{StaticResource DeployH2}"/>
                    <TextBlock Text="Collections you can install as a set." Style="{StaticResource DeployLead}" Margin="0,4,0,0"/>
                </StackPanel>
            </DockPanel>
            <ItemsControl x:Name="FeaturedPacksList" x:FieldModifier="public" ItemTemplate="{StaticResource DeployPackCardTemplate}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="{Binding Columns, ElementName=Root}"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</local:DeployGridView>
