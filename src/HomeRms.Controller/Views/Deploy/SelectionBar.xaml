<UserControl x:Class="HomeRms.Controller.Views.Deploy.SelectionBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:HomeRms.Controller.Views.Deploy">
    <StackPanel>
        <!-- "Click to view & edit": selected apps list -->
        <Border x:Name="ListPanel" x:FieldModifier="public" Background="{DynamicResource DeployCardBrush}" CornerRadius="16" Padding="18,14" Margin="0,0,0,10"
                BorderBrush="{DynamicResource DeployBorderHoverBrush}" BorderThickness="1" Visibility="Collapsed" Effect="{StaticResource ShadowPopup}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <Button x:Name="CloseListBtn" x:FieldModifier="public" DockPanel.Dock="Right" Style="{StaticResource DeployRoundButton}" ToolTip="Close">
                        <Path Data="{StaticResource DGeoClose}" Style="{StaticResource DeployIcon}" Width="11" Height="11"/>
                    </Button>
                    <TextBlock x:Name="ListTitle" x:FieldModifier="public" Text="Selected apps" Style="{StaticResource DeployCardTitle}" FontSize="16" VerticalAlignment="Center"/>
                </DockPanel>
                <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <ItemsControl x:Name="SelectedList" x:FieldModifier="public" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="2" VerticalAlignment="Top"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource DeployFieldBrush}" CornerRadius="10" Padding="10,8" Margin="0,0,8,8">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource DeployRoundButton}" Width="26" Height="26" ToolTip="Deselect"
                                                Command="{x:Static local:DeployCommands.ToggleApp}" CommandParameter="{Binding}">
                                            <Path Data="{StaticResource DGeoClose}" Style="{StaticResource DeployIcon}" Width="10" Height="10"/>
                                        </Button>
                                        <local:AppIcon Size="28" Margin="0,0,10,0"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Publisher}" Style="{StaticResource DeployMeta}" FontSize="11.5"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- "Add to Pack" popover -->
        <Border x:Name="PackPanel" x:FieldModifier="public" Background="{DynamicResource DeployCardBrush}" CornerRadius="16" Padding="18,14" Margin="0,0,0,10"
                BorderBrush="{DynamicResource DeployBorderHoverBrush}" BorderThickness="1" Visibility="Collapsed" HorizontalAlignment="Right" Width="420"
                Effect="{StaticResource ShadowPopup}">
            <StackPanel>
                <DockPanel Margin="0,0,0,10">
                    <Button x:Name="ClosePackBtn" x:FieldModifier="public" DockPanel.Dock="Right" Style="{StaticResource DeployRoundButton}" ToolTip="Close">
                        <Path Data="{StaticResource DGeoClose}" Style="{StaticResource DeployIcon}" Width="11" Height="11"/>
                    </Button>
                    <TextBlock Text="Add to Pack" Style="{StaticResource DeployCardTitle}" FontSize="16" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBlock Text="Save the selection as a new pack" Style="{StaticResource DeployMeta}" Margin="0,0,0,6"/>
                <DockPanel Margin="0,0,0,12">
                    <Button x:Name="SaveNewPackBtn" x:FieldModifier="public" DockPanel.Dock="Right" Content="Save" Style="{StaticResource DeployAccentButton}" Margin="8,0,0,0"/>
                    <TextBox x:Name="NewPackNameBox" x:FieldModifier="public" Style="{StaticResource DeployField}" Tag="Pack name" MaxLength="60"/>
                </DockPanel>
                <TextBlock x:Name="ExistingPacksLabel" x:FieldModifier="public" Text="Or add to one of your packs" Style="{StaticResource DeployMeta}" Margin="0,0,0,6"/>
                <ItemsControl x:Name="ExistingPacksList" x:FieldModifier="public" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource DeployDarkButton}" Padding="12,6" Margin="0,0,8,8" FontSize="12.5"
                                    Command="{x:Static local:DeployCommands.AddSelectionToPack}" CommandParameter="{Binding}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource DGeoPlus}" Style="{StaticResource DeployIcon}" Width="10" Height="10" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding Name}"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="PackResultText" x:FieldModifier="public" Style="{StaticResource DeployMeta}" TextWrapping="Wrap" TextTrimming="None"/>
            </StackPanel>
        </Border>

        <!-- The purple bar -->
        <Border x:Name="Bar" Background="{DynamicResource DeployAccentBrush}" CornerRadius="16" Height="70" Padding="12,0,14,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ClearBtn" x:FieldModifier="public" Style="{StaticResource DeployRoundButton}" Width="40" Height="40" Foreground="{DynamicResource TextOnAccentBrush}"
                            ToolTip="Clear the selection">
                        <Path Data="{StaticResource DGeoTrash}" Style="{StaticResource DeployIcon}" Width="17" Height="17"/>
                    </Button>
                    <Button x:Name="InstallBtn" x:FieldModifier="public" Style="{StaticResource DeployBarButton}" ToolTip="Deploy or generate an install script for the selected apps">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource DGeoDownload}" Style="{StaticResource DeployIcon}" Width="15" Height="15" Margin="0,0,8,0"/>
                            <TextBlock Text="Install"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="AddToPackBtn" x:FieldModifier="public" Style="{StaticResource DeployBarButton}" ToolTip="Save the selection as a pack">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource DGeoPackage}" Style="{StaticResource DeployIcon}" Width="15" Height="15" Margin="0,0,8,0"/>
                            <TextBlock Text="Add to Pack"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Button x:Name="ToggleListBtn" x:FieldModifier="public" Cursor="Hand" FocusVisualStyle="{x:Null}" HorizontalAlignment="Left" ToolTip="View &amp; edit the selected apps">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="12" Padding="6,6,12,6">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverLayerBrush}"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverLayerBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal">
                        <ItemsControl x:Name="IconStack" x:FieldModifier="public" Focusable="False" VerticalAlignment="Center" Margin="0,0,10,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource DeployAccentBrush}" CornerRadius="10" Padding="2" Margin="0,0,-8,0">
                                        <local:AppIcon Size="36"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border x:Name="OverflowBadge" x:FieldModifier="public" Width="36" Height="36" CornerRadius="8" Background="{DynamicResource DeployOnAccentLayerBrush}"
                                Margin="10,0,0,0" Visibility="Collapsed" VerticalAlignment="Center">
                            <TextBlock x:Name="OverflowText" x:FieldModifier="public" Text="+0" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextOnAccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Margin="14,0,0,0">
                            <TextBlock x:Name="CountText" x:FieldModifier="public" Text="Selected 0 apps so far" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextOnAccentBrush}"/>
                            <TextBlock x:Name="HintText" Text="Click to view &amp; edit" FontSize="13" Foreground="{DynamicResource DeployOnAccentMutedBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Button>
            </DockPanel>
        </Border>
    </StackPanel>
</UserControl>
