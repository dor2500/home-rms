<UserControl x:Class="HomeRms.Controller.Views.Deploy.InstallView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:local="clr-namespace:HomeRms.Controller.Views.Deploy">
    <UserControl.Resources>
        <Style x:Key="FlagText" TargetType="Run">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource DeployMutedTextBrush}"/>
        </Style>
    </UserControl.Resources>
    <ScrollViewer x:Name="Scroll" x:FieldModifier="public" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="24,16,24,120" MaxWidth="1180" HorizontalAlignment="Stretch">
            <Button x:Name="BackBtn" x:FieldModifier="public" Style="{StaticResource DeployLinkButton}" HorizontalAlignment="Left" Margin="-6,0,0,10">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource DGeoBack}" Style="{StaticResource DeployIcon}" Width="11" Height="11" Margin="0,0,6,0"/>
                    <TextBlock Text="Back"/>
                </StackPanel>
            </Button>

            <TextBlock Text="Your apps are ready" Style="{StaticResource DeployH1}" FontSize="30"/>
            <TextBlock Style="{StaticResource DeployLead}" FontSize="15" Margin="0,6,0,20">
                <Run Text="Make sure you have"/>
                <Hyperlink x:Name="WingetLink" x:FieldModifier="public" Foreground="{StaticResource DeployAccentTextBrush}">Windows Package Manager</Hyperlink>
                <Run Text="installed :)  Deploy straight to your endpoints, or copy a script to run yourself."/>
            </TextBlock>

            <!-- Output tabs -->
            <WrapPanel Margin="0,0,0,10">
                <RadioButton x:Name="TabDeploy" x:FieldModifier="public" Style="{StaticResource DeployPillTab}" GroupName="InstallTab" IsChecked="True">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource DGeoServer}" Style="{StaticResource DeployIcon}" Width="13" Height="13" Margin="0,0,8,0"/>
                        <TextBlock Text="Deploy to endpoints"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="TabBatch" x:FieldModifier="public" Content="Batch" Style="{StaticResource DeployPillTab}" GroupName="InstallTab"/>
                <RadioButton x:Name="TabPowerShell" x:FieldModifier="public" Content="PowerShell" Style="{StaticResource DeployPillTab}" GroupName="InstallTab"/>
                <RadioButton x:Name="TabImport" x:FieldModifier="public" Content="Winget Import" Style="{StaticResource DeployPillTab}" GroupName="InstallTab"/>
            </WrapPanel>

            <!-- Default Options (collapsible) -->
            <Border Style="{StaticResource DeployPanelCard}" Padding="0" Margin="0,0,0,16">
                <StackPanel>
                    <Button x:Name="OptionsToggleBtn" x:FieldModifier="public" Cursor="Hand" Focusable="True" FocusVisualStyle="{x:Null}" Background="Transparent">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="Transparent" Padding="20,14">
                                    <ContentPresenter/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <DockPanel>
                            <Path x:Name="OptionsChevron" DockPanel.Dock="Right" Data="{StaticResource DGeoChevronDown}" Stroke="{StaticResource DeployMutedTextBrush}"
                                  StrokeThickness="2" Width="12" Height="12" Stretch="Uniform" RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform><RotateTransform x:Name="ChevronRotate" Angle="0"/></Path.RenderTransform>
                            </Path>
                            <TextBlock Text="Default Options" Style="{StaticResource DeployCardTitle}" FontSize="16"/>
                            <TextBlock x:Name="OptionsSummary" x:FieldModifier="public" Style="{StaticResource DeployMeta}" Margin="12,2,12,0" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Button>
                    <StackPanel x:Name="OptionsPanel" x:FieldModifier="public" Margin="20,0,20,16">
                        <Border Height="1" Background="{StaticResource DeployBorderBrush}" Margin="0,0,0,14"/>
                        <TextBlock Margin="0,0,0,10" FontSize="13.5" FontWeight="SemiBold">
                            <Run Text="Installation scope"/>
                            <Run Text="  --scope" Style="{StaticResource FlagText}"/>
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <RadioButton x:Name="ScopeDefault" x:FieldModifier="public" Content="Default" Style="{StaticResource DeployRadio}" GroupName="InstallScope" IsChecked="True"/>
                            <RadioButton x:Name="ScopeUser" x:FieldModifier="public" Content="User" Style="{StaticResource DeployRadio}" GroupName="InstallScope"/>
                            <RadioButton x:Name="ScopeMachine" x:FieldModifier="public" Content="Machine" Style="{StaticResource DeployRadio}" GroupName="InstallScope"/>
                        </StackPanel>
                        <WrapPanel>
                            <CheckBox x:Name="SilentCheck" x:FieldModifier="public" Style="{StaticResource DeployCheck}" IsChecked="True" Margin="0,0,28,10">
                                <TextBlock><Run Text="Silent installation"/><Run Text="  --silent" Style="{StaticResource FlagText}"/></TextBlock>
                            </CheckBox>
                            <CheckBox x:Name="UpgradeCheck" x:FieldModifier="public" Style="{StaticResource DeployCheck}" IsChecked="True" Margin="0,0,28,10"
                                      ToolTip="Try 'winget upgrade' first and install when the package is not present">
                                <TextBlock><Run Text="Upgrade if already installed"/><Run Text="  upgrade → install" Style="{StaticResource FlagText}"/></TextBlock>
                            </CheckBox>
                            <CheckBox x:Name="InteractiveCheck" x:FieldModifier="public" Style="{StaticResource DeployCheck}" Margin="0,0,28,10"
                                      ToolTip="Scripts only: remote deploys always run unattended">
                                <TextBlock><Run Text="Request interactive installation"/><Run Text="  --interactive" Style="{StaticResource FlagText}"/></TextBlock>
                            </CheckBox>
                            <CheckBox x:Name="ForceCheck" x:FieldModifier="public" Style="{StaticResource DeployCheck}" Margin="0,0,28,10"
                                      ToolTip="Scripts only: the agent never skips the installer hash check">
                                <TextBlock><Run Text="Override the installer hash check"/><Run Text="  --force" Style="{StaticResource FlagText}"/></TextBlock>
                            </CheckBox>
                        </WrapPanel>
                        <TextBlock x:Name="OptionsNote" x:FieldModifier="public" Style="{StaticResource DeployMeta}" TextWrapping="Wrap" TextTrimming="None"
                                   Text="Remote deploys honour scope (Default/User = winget default, Machine = --scope machine), silent, upgrade and the version picked per app. --interactive, --force, --override, --log and --location apply to the generated scripts only."/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Script output (Batch / PowerShell / Winget Import) -->
            <StackPanel x:Name="ScriptPanel" x:FieldModifier="public" Visibility="Collapsed" Margin="0,0,0,24">
                <TextBox x:Name="ScriptBox" x:FieldModifier="public" Style="{StaticResource DeployCodeBox}" Height="230" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto"/>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button x:Name="CopyScriptBtn" x:FieldModifier="public" Style="{StaticResource DeployAccentButton}" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource DGeoCopy}" Style="{StaticResource DeployIcon}" Width="13" Height="13" Margin="0,0,8,0"/>
                            <TextBlock x:Name="CopyScriptText" x:FieldModifier="public" Text="Copy to clipboard"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="DownloadScriptBtn" x:FieldModifier="public" Style="{StaticResource DeployDarkButton}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource DGeoDownload}" Style="{StaticResource DeployIcon}" Width="13" Height="13" Margin="0,0,8,0"/>
                            <TextBlock x:Name="DownloadScriptText" x:FieldModifier="public" Text="Download .bat"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <TextBlock x:Name="ScriptNote" x:FieldModifier="public" Style="{StaticResource DeployMeta}" TextWrapping="Wrap" TextTrimming="None" Margin="0,10,0,0"/>
            </StackPanel>

            <!-- Deploy to endpoints -->
            <StackPanel x:Name="DeployTabPanel" x:FieldModifier="public" Margin="0,0,0,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="6*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource DeployPanelCard}">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                <Button x:Name="RefreshTargetsBtn" x:FieldModifier="public" DockPanel.Dock="Right" Style="{StaticResource DeployLinkButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource DGeoRefresh}" Style="{StaticResource DeployIcon}" Width="12" Height="12" Margin="0,0,6,0"/>
                                        <TextBlock Text="Refresh"/>
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="Target endpoints" Style="{StaticResource DeployCardTitle}" FontSize="16" VerticalAlignment="Center"/>
                            </DockPanel>
                            <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="DeployBtn" x:FieldModifier="public" Style="{StaticResource DeployAccentButton}" Padding="20,10" Margin="0,0,10,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource DGeoServer}" Style="{StaticResource DeployIcon}" Width="14" Height="14" Margin="0,0,8,0"/>
                                            <TextBlock x:Name="DeployBtnText" x:FieldModifier="public" Text="Deploy"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="CancelBtn" x:FieldModifier="public" Style="{StaticResource DeployDarkButton}" Content="Cancel" IsEnabled="False" Padding="18,10"/>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock x:Name="TargetHint" x:FieldModifier="public" DockPanel.Dock="Bottom" Style="{StaticResource DeployMeta}" TextWrapping="Wrap" TextTrimming="None" Margin="0,8,0,0"/>
                            <ListBox x:Name="TargetList" x:FieldModifier="public" MinHeight="60" MaxHeight="170" Background="{StaticResource DeployFieldBrush}"
                                     BorderBrush="{StaticResource DeployBorderBrush}" BorderThickness="1" Padding="6" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" ToolTip="{Binding Address}" Style="{StaticResource DeployCheck}" Margin="2,3">
                                            <TextBlock FontSize="13">
                                                <Run Text="{Binding Name, Mode=OneWay}" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <Run Text="{Binding Detail, Mode=OneWay}" Foreground="{StaticResource DeployMutedTextBrush}"/>
                                            </TextBlock>
                                        </CheckBox>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource DeployPanelCard}">
                        <DockPanel>
                            <TextBlock x:Name="QueueTitle" x:FieldModifier="public" DockPanel.Dock="Top" Text="Progress" Style="{StaticResource DeployCardTitle}" FontSize="16" Margin="0,4,0,12"/>
                            <Grid>
                                <TextBlock x:Name="QueueEmptyText" x:FieldModifier="public" Style="{StaticResource DeployMeta}" TextWrapping="Wrap" TextTrimming="None" VerticalAlignment="Center"
                                           HorizontalAlignment="Center" TextAlignment="Center" Text="Per-app progress and exit codes appear here while deploying."/>
                                <ItemsControl x:Name="QueueList" x:FieldModifier="public" Focusable="False" MaxHeight="230">
                                    <ItemsControl.Template>
                                        <ControlTemplate TargetType="ItemsControl">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False"><ItemsPresenter/></ScrollViewer>
                                        </ControlTemplate>
                                    </ItemsControl.Template>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="0,6" BorderBrush="{StaticResource DeployBorderBrush}" BorderThickness="0,0,0,1">
                                                <StackPanel>
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding StatusLabel}" Style="{StaticResource DeployStatusText}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                        <local:AppIcon Size="24" Margin="0,0,10,0"/>
                                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    </DockPanel>
                                                    <ProgressBar Style="{DynamicResource ThinProgressBar}" Value="{Binding ProgressValue, Mode=OneWay}" IsIndeterminate="{Binding IsIndeterminate, Mode=OneWay}"
                                                                 Visibility="{Binding ProgressVisibility}" Margin="34,6,0,0"/>
                                                    <TextBlock Text="{Binding StatusDetail}" Visibility="{Binding DetailVisibility}" Style="{StaticResource DeployMeta}" TextWrapping="Wrap" TextTrimming="None" Margin="34,3,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </DockPanel>
                    </Border>
                </Grid>

                <DockPanel Margin="0,18,0,8">
                    <Button x:Name="ClearLogBtn" x:FieldModifier="public" DockPanel.Dock="Right" Style="{StaticResource DeployLinkButton}" Content="Clear log"/>
                    <TextBlock Text="Live log" Style="{StaticResource DeployCardTitle}" FontSize="16" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBox x:Name="OutputBox" x:FieldModifier="public" Style="{StaticResource DeployCodeBox}" Height="210" FontSize="11.5"/>
            </StackPanel>

            <!-- Selected apps -->
            <DockPanel Margin="0,0,0,14">
                <Button x:Name="AddMoreBtn" x:FieldModifier="public" DockPanel.Dock="Right" Style="{StaticResource DeployDarkButton}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource DGeoPlus}" Style="{StaticResource DeployIcon}" Width="12" Height="12" Margin="0,0,8,0"/>
                        <TextBlock Text="Add more"/>
                    </StackPanel>
                </Button>
                <TextBlock x:Name="SelectedTitle" x:FieldModifier="public" Text="Selected apps (0)" Style="{StaticResource DeployH2}" VerticalAlignment="Center"/>
            </DockPanel>
            <TextBlock x:Name="SelectedEmptyText" x:FieldModifier="public" Style="{StaticResource DeployLead}" Text="No apps selected yet. Pick some in Discover, Apps, Essentials or Packs." Visibility="Collapsed"/>
            <ItemsControl x:Name="SelectedList" x:FieldModifier="public" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource DeployPanelCard}" Margin="0,0,0,12" Padding="20,16">
                            <StackPanel>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource DeployRoundButton}" Margin="10,0,0,0" ToolTip="Remove from the selection"
                                            Command="{x:Static local:DeployCommands.ToggleApp}" CommandParameter="{Binding}" VerticalAlignment="Center">
                                        <Path Data="{StaticResource DGeoClose}" Style="{StaticResource DeployIcon}" Width="11" Height="11"/>
                                    </Button>
                                    <ComboBox DockPanel.Dock="Right" Width="230" VerticalAlignment="Center" ItemsSource="{Binding VersionOptions}" DisplayMemberPath="Label"
                                              SelectedItem="{Binding SelectedVersionOption, Mode=TwoWay}" ToolTip="Version to install"/>
                                    <TextBlock DockPanel.Dock="Right" Text="Version" Style="{StaticResource DeployMeta}" VerticalAlignment="Center" Margin="12,0,8,0"/>
                                    <Button Style="{StaticResource DeployLinkButton}" DockPanel.Dock="Left" Padding="0" Margin="0,0,14,0"
                                            Command="{x:Static local:DeployCommands.OpenApp}" CommandParameter="{Binding}" ToolTip="Open the app page">
                                        <local:AppIcon Size="44"/>
                                    </Button>
                                    <StackPanel VerticalAlignment="Center">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding StatusLabel}" Style="{StaticResource DeployStatusText}" VerticalAlignment="Center" Margin="10,0,0,0"
                                                       Visibility="{Binding DetailVisibility}"/>
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource DeployCardTitle}" FontSize="16"/>
                                        </DockPanel>
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource DeployMeta}" FontSize="13" Margin="0,3,0,0" ToolTip="{Binding Id}"/>
                                    </StackPanel>
                                </DockPanel>
                                <Expander Header="Advanced Options" Margin="58,12,0,0" Foreground="{StaticResource TextPrimaryBrush}">
                                    <StackPanel Margin="0,10,0,0">
                                        <CheckBox Content="Use custom configuration" Style="{StaticResource DeployCheck}" IsChecked="{Binding Advanced.UseCustom, Mode=TwoWay}"/>
                                        <StackPanel IsEnabled="{Binding Advanced.UseCustom}">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                <TextBlock VerticalAlignment="Center" Width="170" FontSize="13">
                                                    <Run Text="Installation scope"/><Run Text="  --scope" Style="{StaticResource FlagText}"/>
                                                </TextBlock>
                                                <ComboBox Width="160" SelectedIndex="{Binding Advanced.ScopeIndex, Mode=TwoWay}">
                                                    <sys:String>Default</sys:String>
                                                    <sys:String>User</sys:String>
                                                    <sys:String>Machine</sys:String>
                                                </ComboBox>
                                            </StackPanel>
                                            <WrapPanel>
                                                <CheckBox Style="{StaticResource DeployCheck}" IsChecked="{Binding Advanced.Interactive, Mode=TwoWay}" Margin="0,0,24,10">
                                                    <TextBlock><Run Text="Interactive"/><Run Text="  --interactive" Style="{StaticResource FlagText}"/></TextBlock>
                                                </CheckBox>
                                                <CheckBox Style="{StaticResource DeployCheck}" IsChecked="{Binding Advanced.Force, Mode=TwoWay}" Margin="0,0,24,10">
                                                    <TextBlock><Run Text="Override hash check"/><Run Text="  --force" Style="{StaticResource FlagText}"/></TextBlock>
                                                </CheckBox>
                                            </WrapPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0" Style="{StaticResource DeployField}" Tag="--override  installer arguments" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                                         Text="{Binding Advanced.Override, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="--override: replace the installer arguments"/>
                                                <TextBox Grid.Column="2" Style="{StaticResource DeployField}" Tag="--log  C:\Logs\app.log" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                                         Text="{Binding Advanced.Log, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="--log: write an installer log to this path"/>
                                                <TextBox Grid.Column="4" Style="{StaticResource DeployField}" Tag="--location  install folder" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                                         Text="{Binding Advanced.Location, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="--location: install into this folder"/>
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
