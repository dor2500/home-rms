<UserControl x:Class="HomeRms.Controller.Views.FileManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:HomeRms.Controller.Views">
    <DockPanel>
        <!-- Header -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Endpoint" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="EndpointCombo" Width="230" Margin="0,0,6,0" DisplayMemberPath="DisplayTitle"
                          SelectionChanged="OnEndpointChanged"/>
                <Button Content="Open" Style="{StaticResource PrimaryButton}" Padding="12,5" Click="OnOpenEndpointClick"/>
            </StackPanel>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Remote file manager" Style="{StaticResource PageTitle}"/>
                <TextBlock x:Name="SubtitleText" Text="Browse, upload, download and manage files on a paired agent. Drag files between panes or from Explorer."
                           Style="{StaticResource PageSubtitle}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </DockPanel>

        <!-- Power bar for the picked endpoint -->
        <Border DockPanel.Dock="Top" Style="{StaticResource CardStyle}" Padding="12,7" Margin="0,0,0,10">
            <v:EndpointActionBar x:Name="ActionBar"/>
        </Border>

        <!-- Transfers -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource CardStyle}" Padding="10,8" Height="170" Margin="0,10,0,0">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Cancel all" Style="{StaticResource SmallPillButton}" Margin="0,0,5,0" Click="OnCancelAllClick"/>
                        <Button Content="Clear finished" Style="{StaticResource SmallPillButton}" Click="OnClearFinishedClick"/>
                    </StackPanel>
                    <TextBlock x:Name="TransfersCaption" Text="Transfers" Style="{StaticResource Caption}" Margin="0" VerticalAlignment="Center"/>
                </DockPanel>
                <ListView x:Name="TransfersList" Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource LineBrush}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Dir" Width="56">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DirectionText}" FontFamily="{StaticResource MonoFont}" FontSize="10.5" Foreground="{DynamicResource AccentBrush}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="File" Width="230">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" ToolTip="{Binding Route}" TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Progress" Width="170">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid Width="150">
                                            <ProgressBar Style="{StaticResource ThinProgressBar}" Height="5" Value="{Binding Percent, Mode=OneWay}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Size" Width="150">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SizeText}" FontFamily="{StaticResource MonoFont}" FontSize="11"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Status" Width="260">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock x:Name="StatusTb" Text="{Binding Status}" ToolTip="{Binding Status}" TextTrimming="CharacterEllipsis" FontSize="11.5"/>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                                <Setter TargetName="StatusTb" Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="" Width="80">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Cancel" Style="{StaticResource SmallPillButton}" Padding="7,2" FontSize="10.5"
                                                IsEnabled="{Binding IsActive}" Tag="{Binding}" Click="OnCancelTransferClick"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>
        </Border>

        <!-- Dual panes -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <v:FilePaneView x:Name="LocalPane" Grid.Column="0"/>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0">
                <Button Content="Upload  →" Style="{StaticResource PrimaryButton}" Padding="10,6" Margin="0,0,0,8"
                        Click="OnUploadClick" ToolTip="Copy the selected local items into the current remote folder"/>
                <Button Content="←  Download" Style="{StaticResource GhostButton}" Padding="10,6"
                        Click="OnDownloadClick" ToolTip="Copy the selected remote items into the current local folder"/>
            </StackPanel>
            <v:FilePaneView x:Name="RemotePane" Grid.Column="2"/>
        </Grid>
    </DockPanel>
</UserControl>
