<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows SDK TFM: exposes the WinRT projection (Windows.Security.Credentials.UI for Windows Hello) -->
    <TargetFramework>net11.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>HomeRms.Controller</RootNamespace>
    <AssemblyName>HomeRmsController</AssemblyName>
    <AssemblyTitle>Home RMS Controller Console</AssemblyTitle>
    <Description>Home RMS Remote Management Console (mTLS / HTTP2)</Description>
    <!-- Built-in Fluent theme (ThemeMode) is marked experimental in .NET 9 -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <ApplicationIcon>Assets\controller.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <PublishSingleFile Condition="'$(RuntimeIdentifier)' != ''">true</PublishSingleFile>
    <SelfContained Condition="'$(RuntimeIdentifier)' != ''">true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\controller.ico" />
    <Resource Include="Assets\controller.png" />
    <!-- Precompiled pixel shaders (sources: Shaders\*.fx, rebuild with tools\Build-Shaders.ps1) -->
    <Resource Include="Shaders\*.ps" />
  </ItemGroup>

  <ItemGroup>
    <!-- Central Hub web console (single-page app served by CentralHubService; no external CDNs) -->
    <EmbeddedResource Include="Web\*.html;Web\*.js;Web\*.css;Web\*.svg" LogicalName="HomeRms.Web.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HomeRms.Shared\HomeRms.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SSH.NET" Version="2026.0.1" />
    <!-- Queries Microsoft's official winget source index (Public/index.db inside source2.msix) -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="11.0.0" />
  </ItemGroup>

</Project>
