<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="using:HomeRms.Controller.Mac.Models"
        x:Class="HomeRms.Controller.Mac.MainWindow"
        Title="Home RMS — Remote Management Console"
        Width="1320" Height="820"
        MinWidth="1040" MinHeight="680"
        Icon="avares://HomeRmsController/Assets/controller.ico"
        Background="#0F1117"
        Foreground="#F3F4F6"
        KeyDown="OnWindowKeyDown"
        KeyUp="OnWindowKeyUp"
        WindowStartupLocation="CenterScreen">

    <Grid ColumnDefinitions="Auto,*">

        <!-- ==================== LEFT SIDEBAR: COMPUTERS ==================== -->
        <Border x:Name="SidebarBorder" Grid.Column="0" Width="325" Background="#151922" BorderBrush="#282F40" BorderThickness="0,0,1,0" Padding="18">
            <DockPanel LastChildFill="True">

                <!-- Brand Header -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,2,0,20" Spacing="12">
                    <Image Source="avares://HomeRmsController/Assets/controller.png" Width="44" Height="44"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Home RMS" FontSize="18" FontWeight="Bold" Foreground="#F3F4F6"/>
                        <TextBlock Text="Consent-Based LAN Console" FontSize="11.5" Foreground="#9CA3AF"/>
                    </StackPanel>
                </StackPanel>

                <!-- Add / Edit Endpoint Card (Docked Bottom) -->
                <Border DockPanel.Dock="Bottom" Background="#1C212E" BorderBrush="#282F40" BorderThickness="1"
                        CornerRadius="12" Padding="14" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="ADD / EDIT ENDPOINT" FontSize="11" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,0,0,10"/>

                        <TextBlock Text="Display Name" FontSize="11.5" Foreground="#9CA3AF" Margin="0,0,0,4"/>
                        <TextBox x:Name="NameBox" Text="Home Windows PC" Margin="0,0,0,8"/>

                        <Grid ColumnDefinitions="*,8,82" Margin="0,0,0,12">
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Host / LAN IP" FontSize="11.5" Foreground="#9CA3AF" Margin="0,0,0,4"/>
                                <TextBox x:Name="HostBox" Text="192.168.1.122"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Port" FontSize="11.5" Foreground="#9CA3AF" Margin="0,0,0,4"/>
                                <TextBox x:Name="PortBox" Text="7443"/>
                            </StackPanel>
                        </Grid>

                        <Grid ColumnDefinitions="*,8,Auto">
                            <Button Grid.Column="0" Content="Save Endpoint" HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center" Click="OnSaveMachineClick"/>
                            <Button Grid.Column="2" Content="Remove" Click="OnRemoveMachineClick"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Computers Section Header -->
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <Button x:Name="ProbeBtn" DockPanel.Dock="Right" Content="↻ Check Status"
                            FontSize="11.5" Padding="10,5" Click="OnProbeMachinesClick"/>
                    <TextBlock Text="HOME COMPUTERS" FontSize="11" FontWeight="Bold" Foreground="#9CA3AF"
                               VerticalAlignment="Center"/>
                </DockPanel>

                <!-- Computers List -->
                <ListBox x:Name="MachinesList" Background="Transparent" BorderThickness="0"
                         SelectionChanged="OnMachineSelectionChanged"
                         DoubleTapped="OnMachineDoubleTapped">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:MachineProfile">
                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="2,4">
                                <Ellipse Grid.Column="0" Width="10" Height="10" Fill="{Binding DotBrush}"
                                         VerticalAlignment="Center" Margin="2,0,12,0"/>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" FontSize="13.5"
                                               Foreground="#F3F4F6" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Subtitle}" FontSize="11.5" Foreground="#9CA3AF"
                                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                </StackPanel>

                                <Border Grid.Column="2" Background="{Binding BadgeBackground}" CornerRadius="6"
                                        Padding="8,3" VerticalAlignment="Center" Margin="6,0,0,0">
                                    <TextBlock Text="{Binding StatusLabel}" FontSize="10.5" FontWeight="SemiBold"
                                               Foreground="#F3F4F6"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

            </DockPanel>
        </Border>

        <!-- ==================== RIGHT WORKSPACE ==================== -->
        <DockPanel Grid.Column="1" LastChildFill="True">

            <!-- Top Machine Connection Bar -->
            <Border x:Name="TopBarBorder" DockPanel.Dock="Top" Background="#151922" BorderBrush="#282F40" BorderThickness="0,0,0,1" Padding="24,16">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Spacing="12">
                        <Border Background="#1A2232" BorderBrush="#282F40" BorderThickness="1"
                                CornerRadius="8" Padding="12,7" VerticalAlignment="Center">
                            <TextBlock Text="🔒 Mutual TLS (Zero-Prompt PKI)" FontSize="11.5" Foreground="#9CA3AF"/>
                        </Border>
                        <Button x:Name="ConnectBtn" Content="Connect" Width="136" HorizontalContentAlignment="Center"
                                Background="#3B82F6" Foreground="White" FontWeight="SemiBold" Padding="14,8"
                                Click="OnConnectClick"/>
                    </StackPanel>

                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4" Spacing="12">
                            <TextBlock x:Name="TargetTitleText" Text="Select or connect to a computer"
                                       FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Border x:Name="ConnBadgeBorder" Background="#256B7280" CornerRadius="6"
                                    Padding="9,3" VerticalAlignment="Center">
                                <TextBlock x:Name="ConnBadgeText" Text="Disconnected" FontSize="11"
                                           FontWeight="SemiBold" Foreground="#9CA3AF"/>
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="StatusText"
                                   Text="Choose an endpoint on the left or enter a host/IP and click Connect."
                                   FontSize="12.5" Foreground="#9CA3AF"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Navigation Tabs Bar -->
            <Border x:Name="NavBarBorder" DockPanel.Dock="Top" Background="#0F1117" BorderBrush="#282F40" BorderThickness="0,0,0,1" Padding="24,10">
                <WrapPanel Orientation="Horizontal">
                    <RadioButton x:Name="NavInventory" Classes="nav" Content="📊  Inventory" GroupName="Nav"
                                 Margin="0,0,6,4" IsChecked="True" IsCheckedChanged="OnNavTabChanged"/>
                    <RadioButton x:Name="NavDesktop" Classes="nav" Content="🖥️  Remote Desktop" GroupName="Nav"
                                 Margin="0,0,6,4" IsCheckedChanged="OnNavTabChanged"/>
                    <RadioButton x:Name="NavShell" Classes="nav" Content="⌨️  Remote Shell" GroupName="Nav"
                                 Margin="0,0,6,4" IsCheckedChanged="OnNavTabChanged"/>
                    <RadioButton x:Name="NavDeploy" Classes="nav" Content="📦  Deploy" GroupName="Nav"
                                 Margin="0,0,6,4" IsCheckedChanged="OnNavTabChanged"/>
                    <RadioButton x:Name="NavUpdates" Classes="nav" Content="🔄  Windows Update" GroupName="Nav"
                                 Margin="0,0,6,4" IsCheckedChanged="OnNavTabChanged"/>
                    <RadioButton x:Name="NavSystem" Classes="nav" Content="⚙️  System &amp; Settings" GroupName="Nav"
                                 Margin="0,0,6,4" IsCheckedChanged="OnNavTabChanged"/>
                </WrapPanel>
            </Border>

            <!-- Workspace Body -->
            <Grid x:Name="WorkspaceGrid" Margin="24,18,24,22">

                <!-- ==================== 1. SYSTEM INVENTORY VIEW ==================== -->
                <DockPanel x:Name="InventoryPanel" IsVisible="True">

                    <!-- Hardware Summary Stat Cards -->
                    <UniformGrid DockPanel.Dock="Top" Columns="4" Margin="0,0,0,16">
                        <Border Background="#1C212E" BorderBrush="#282F40" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="PROCESSOR (CPU)" FontSize="11" FontWeight="Bold" Foreground="#9CA3AF"/>
                                <TextBlock x:Name="CpuValueText" Text="—" FontSize="15" FontWeight="SemiBold" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="CpuSubText" Text="Connect to inspect CPU" FontSize="11.5" Foreground="#9CA3AF" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#1C212E" BorderBrush="#282F40" BorderThickness="1" CornerRadius="12" Padding="16" Margin="4,0,4,0">
                            <StackPanel>
                                <TextBlock Text="SYSTEM MEMORY (RAM)" FontSize="11" FontWeight="Bold" Foreground="#9CA3AF"/>
                                <TextBlock x:Name="RamValueText" Text="—" FontSize="15" FontWeight="SemiBold" Margin="0,6,0,0"/>
                                <TextBlock x:Name="RamSubText" Text="Physical memory &amp; processes" FontSize="11.5" Foreground="#9CA3AF" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#1C212E" BorderBrush="#282F40" BorderThickness="1" CornerRadius="12" Padding="16" Margin="4,0,4,0">
                            <StackPanel>
                                <TextBlock Text="GRAPHICS &amp; DISPLAY" FontSize="11" FontWeight="Bold" Foreground="#9CA3AF"/>
                                <TextBlock x:Name="GpuValueText" Text="—" FontSize="15" FontWeight="SemiBold" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="GpuSubText" Text="Primary monitor resolution" FontSize="11.5" Foreground="#9CA3AF" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#1C212E" BorderBrush="#282F40" BorderThickness="1" CornerRadius="12" Padding="16" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="STORAGE VOLUMES" FontSize="11" FontWeight="Bold" Foreground="#9CA3AF"/>
                                <TextBlock x:Name="DiskValueText" Text="—" FontSize="15" FontWeight="SemiBold" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="DiskSubText" Text="Free / total capacity" FontSize="11.5" Foreground="#9CA3AF" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Filter & Refresh Toolbar -->
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                        <Button x:Name="RefreshInvBtn" DockPanel.Dock="Right" Content="↻  Refresh Inventory"
                                Background="#3B82F6" Foreground="White" FontWeight="SemiBold" Padding="16,8"
                                Click="OnRefreshInventory"/>
                        <TextBlock x:Name="InventoryTimestampText" DockPanel.Dock="Right"
                                   Text="" Foreground="#9CA3AF" FontSize="12"
                                   VerticalAlignment="Center" Margin="0,0,16,0"/>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                            <TextBlock Text="Filter apps &amp; processes:" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                            <TextBox x:Name="SearchBox" Width="280" TextChanged="OnSearchChanged"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Split Lists View -->
                    <Grid ColumnDefinitions="1.15*,16,0.85*">
                        <!-- Installed Apps Card -->
                        <Border Grid.Column="0" Background="#1C212E" BorderBrush="#282F40" BorderThickness="1" CornerRadius="12">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" Padding="16,12" BorderBrush="#282F40" BorderThickness="0,0,0,1">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right" Background="#243B82F6" CornerRadius="6" Padding="8,2">
                                            <TextBlock x:Name="AppsCountText" Text="0 apps" FontSize="11" FontWeight="SemiBold" Foreground="#93C5FD"/>
                                        </Border>
                                        <TextBlock Text="INSTALLED APPLICATIONS (REGISTRY)" FontSize="11" FontWeight="Bold" Foreground="#9CA3AF"/>
                                    </DockPanel>
                                </Border>
                                <ListBox x:Name="AppsList" Background="Transparent" BorderThickness="0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:AppItem">
                                            <Grid ColumnDefinitions="2*,110,1.2*" Margin="6,2">
                                                <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="#F3F4F6" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Version}" Foreground="#9CA3AF" Margin="8,0"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Publisher}" Foreground="#9CA3AF" TextTrimming="CharacterEllipsis"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>

                        <!-- Running Processes Card -->
                        <Border Grid.Column="2" Background="#1C212E" BorderBrush="#282F40" BorderThickness="1" CornerRadius="12">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" Padding="16,12" BorderBrush="#282F40" BorderThickness="0,0,0,1">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                                            <Button Content="✕ End Process" FontSize="11" Padding="8,3" Click="OnKillSelectedProcessClick"/>
                                            <Border Background="#2422C55E" CornerRadius="6" Padding="8,2" VerticalAlignment="Center">
                                                <TextBlock x:Name="ProcsCountText" Text="0 processes" FontSize="11" FontWeight="SemiBold" Foreground="#86EFAC"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="RUNNING PROCESSES" FontSize="11" FontWeight="Bold" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </Border>
                                <ListBox x:Name="ProcList" Background="Transparent" BorderThickness="0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:ProcItem">
                                            <Grid ColumnDefinitions="72,*,95" Margin="6,2">
                                                <TextBlock Grid.Column="0" Text="{Binding Pid}" Foreground="#9CA3AF"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="#F3F4F6" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="2" Text="{Binding MemoryLabel}" Foreground="#86EFAC" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>
                    </Grid>
                </DockPanel>

                <!-- ==================== 2. REMOTE DESKTOP VIEW ==================== -->
                <DockPanel x:Name="DesktopPanel" IsVisible="False">

                    <Border x:Name="DesktopToolbarBorder" DockPanel.Dock="Top" Background="#1C212E" BorderBrush="#282F40" BorderThickness="1"
                            CornerRadius="12" Padding="16,12" Margin="0,0,0,14">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                                <Button Content="📋 Paste to Remote" Click="OnSendClipboardClick"/>
                                <Button Content="📥 Copy from Remote" Click="OnGetClipboardClick"/>
                                <Border Background="#141822" BorderBrush="#282F40" BorderThickness="1"
                                        CornerRadius="7" Padding="10,6" VerticalAlignment="Center">
                                    <TextBlock x:Name="StreamStatus" Text="Idle — not streaming" FontSize="12" Foreground="#9CA3AF"/>
                                </Border>
                                <Button Content="⛶  Full Screen (F11)" Click="OnToggleFullScreenClick"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                                <Button x:Name="StreamBtn" Content="▶  Start Viewing" Width="142" HorizontalContentAlignment="Center"
                                        Background="#3B82F6" Foreground="White" FontWeight="SemiBold" Click="OnToggleStream"/>

                                <CheckBox x:Name="ControlCheck" Content="Control + Auto Copy/Paste"
                                          Margin="6,0,0,0" IsCheckedChanged="OnControlCheckChanged"/>

                                <TextBlock Text="FPS:" Foreground="#9CA3AF" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                <TextBox x:Name="FpsBox" Text="20" Width="46"/>

                                <TextBlock Text="Quality:" Foreground="#9CA3AF" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                <TextBox x:Name="QualityBox" Text="65" Width="46"/>

                                <TextBlock Text="Res:" Foreground="#9CA3AF" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                <ComboBox x:Name="ScaleBox" Width="118" SelectedIndex="0">
                                    <ComboBoxItem Content="1080p (Fast)" Tag="1920"/>
                                    <ComboBoxItem Content="720p (Ultra)" Tag="1280"/>
                                    <ComboBoxItem Content="Native (Full)" Tag="0"/>
                                </ComboBox>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border x:Name="ScreenCanvasBorder" Background="#07090D" BorderBrush="#282F40" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
                        <Grid>
                            <Image x:Name="ScreenImage" Stretch="Uniform" Focusable="True"
                                   PointerMoved="OnScreenPointerMoved"
                                   PointerPressed="OnScreenPointerPressed"
                                   PointerReleased="OnScreenPointerReleased"
                                   PointerWheelChanged="OnScreenPointerWheelChanged"
                                   KeyDown="OnScreenKeyDown"
                                   KeyUp="OnScreenKeyUp"/>

                            <!-- Floating HUD in Full Screen Mode -->
                            <Border x:Name="FullscreenHud" IsVisible="False" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="0,14,18,0" Background="#CC151922" BorderBrush="#282F40"
                                    BorderThickness="1" CornerRadius="10" Padding="12,7">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock x:Name="FullscreenHudText" Text="Full Screen Remote Control" Foreground="#E2E8F0"
                                               FontSize="12" VerticalAlignment="Center"/>
                                    <Button Content="📋 Paste" Click="OnSendClipboardClick"/>
                                    <Button Content="📥 Copy" Click="OnGetClipboardClick"/>
                                    <Button Content="⛶  Exit Full Screen (Esc)" Click="OnToggleFullScreenClick"/>
                                    <Button Content="⏹  Stop Stream" Background="#EF4444" Foreground="White" Click="OnToggleStream"/>
                                </StackPanel>
                            </Border>

                            <StackPanel x:Name="DesktopOverlay" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="🖥️  Remote Desktop Stream Ready" FontSize="16" FontWeight="SemiBold"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Click 'Start Viewing' above (or press F11 for Full Screen). The remote Windows computer will show an on-screen Allow/Deny consent prompt."
                                           Foreground="#9CA3AF" FontSize="12.5" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DockPanel>

                <!-- ==================== 3. REMOTE SHELL VIEW ==================== -->
                <DockPanel x:Name="ShellPanel" IsVisible="False">

                    <Border DockPanel.Dock="Top" Background="#1C212E" BorderBrush="#282F40" BorderThickness="1"
                            CornerRadius="12" Padding="14,10" Margin="0,0,0,12">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Clear Console" Click="OnClearShellClick"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                                <TextBlock Text="QUICK COMMANDS:" FontSize="11" FontWeight="Bold" Foreground="#9CA3AF"
                                           VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <Button Content="whoami &amp; hostname" Tag="whoami; hostname; $PSVersionTable.PSVersion.ToString()" Click="OnQuickCommandClick"/>
                                <Button Content="IP Configuration" Tag="Get-NetIPAddress -AddressFamily IPv4 | Select-Object InterfaceAlias, IPAddress | Format-Table -AutoSize" Click="OnQuickCommandClick"/>
                                <Button Content="Top CPU Processes" Tag="Get-Process | Sort-Object CPU -Descending | Select-Object -First 10 Id, ProcessName, @{N='CPU(s)';E={[math]::Round($_.CPU,1)}}, @{N='RAM(MB)';E={[math]::Round($_.WorkingSet64/1MB,1)}} | Format-Table -AutoSize" Click="OnQuickCommandClick"/>
                                <Button Content="Disk Volumes" Tag="Get-PSDrive -PSProvider FileSystem | Select-Object Name, @{N='Used(GB)';E={[math]::Round($_.Used/1GB,1)}}, @{N='Free(GB)';E={[math]::Round($_.Free/1GB,1)}} | Format-Table -AutoSize" Click="OnQuickCommandClick"/>
                                <Button Content="Uptime" Tag="(Get-Date) - (Get-CimInstance Win32_OperatingSystem).LastBootUpTime | Select-Object Days, Hours, Minutes | Format-List" Click="OnQuickCommandClick"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border DockPanel.Dock="Bottom" Background="#1C212E" BorderBrush="#282F40" BorderThickness="1"
                            CornerRadius="12" Padding="10" Margin="0,12,0,0">
                        <DockPanel>
                            <Button x:Name="ShellSendBtn" DockPanel.Dock="Right" Content="Run Command" Width="130"
                                    HorizontalContentAlignment="Center" Background="#3B82F6" Foreground="White"
                                    FontWeight="SemiBold" Margin="10,0,0,0" Click="OnShellSend"/>
                            <Border DockPanel.Dock="Left" Background="#1E293B" CornerRadius="6" Padding="10,6" Margin="0,0,10,0">
                                <TextBlock Text="PS &gt;" FontFamily="Menlo, Consolas, monospace" FontWeight="Bold"
                                           Foreground="#60A5FA" VerticalAlignment="Center"/>
                            </Border>
                            <TextBox x:Name="ShellInputBox" FontFamily="Menlo, Consolas, monospace" FontSize="13"
                                     KeyDown="OnShellInputKeyDown"/>
                        </DockPanel>
                    </Border>

                    <Border Background="#090C12" BorderBrush="#282F40" BorderThickness="1" CornerRadius="12" Padding="4">
                        <TextBox x:Name="ShellOutput" IsReadOnly="True" Background="Transparent"
                                 Foreground="#E2E8F0" BorderThickness="0" Padding="14,12"
                                 FontFamily="Menlo, Consolas, monospace" FontSize="12.5"
                                 TextWrapping="Wrap" AcceptsReturn="True"/>
                    </Border>
                </DockPanel>

                <!-- ==================== 4. SILENT SOFTWARE DEPLOYMENT VIEW ==================== -->
                <DockPanel x:Name="DeployPanel" IsVisible="False">

                    <Border DockPanel.Dock="Top" Background="#1C212E" BorderBrush="#282F40" BorderThickness="1"
                            CornerRadius="12" Padding="18,16" Margin="0,0,0,14">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <Border DockPanel.Dock="Right" Background="#243B82F6" CornerRadius="6" Padding="10,3">
                                    <TextBlock x:Name="DeployStatusBadge" Text="Ready to Deploy" FontSize="11.5"
                                               FontWeight="SemiBold" Foreground="#93C5FD"/>
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="UPLOAD &amp; SILENTLY INSTALL PACKAGE (.EXE / .MSI / .MSP / .PS1)" FontSize="11" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,0,0,3"/>
                                    <TextBlock Text="Streams your local installer file from macOS over Mutual TLS to the Windows Agent and runs it silently."
                                               FontSize="12" Foreground="#9CA3AF"/>
                                </StackPanel>
                            </DockPanel>

                            <Grid ColumnDefinitions="2*,10,Auto,16,1.2*,14,Auto" Margin="0,0,0,12">
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Local Installer File (.exe, .msi, .msp, .ps1)" FontSize="11.5" Foreground="#9CA3AF" Margin="0,0,0,4"/>
                                    <TextBox x:Name="DeployFilePathBox" Text=""/>
                                </StackPanel>

                                <Button Grid.Column="2" Content="📂  Browse File…" VerticalAlignment="Bottom" Click="OnBrowseDeployFileClick"/>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Silent Flags (AUTO detects NSIS / Inno / MSI / Burn)" FontSize="11.5" Foreground="#9CA3AF" Margin="0,0,0,4"/>
                                    <TextBox x:Name="DeployArgsBox" Text="AUTO"/>
                                </StackPanel>

                                <Button x:Name="DeployRunBtn" Grid.Column="6" Content="🚀  Upload &amp; Install Silently"
                                        Background="#3B82F6" Foreground="White" FontWeight="SemiBold"
                                        VerticalAlignment="Bottom" Padding="18,8" Click="OnStartDeployClick"/>
                            </Grid>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                                <TextBlock Text="FLAG PRESETS:" FontSize="11" FontWeight="Bold" Foreground="#9CA3AF" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <Button Content="Smart Auto-Detect (AUTO)" Tag="AUTO" Click="OnDeployPresetFlagClick"/>
                                <Button Content="NSIS / Standard (/S)" Tag="/S" Click="OnDeployPresetFlagClick"/>
                                <Button Content="Inno Setup (/VERYSILENT)" Tag="/VERYSILENT /SUPPRESSMSGBOXES /NORESTART /SP-" Click="OnDeployPresetFlagClick"/>
                                <Button Content="MSI Quiet (/qn /norestart)" Tag="/qn /norestart" Click="OnDeployPresetFlagClick"/>
                                <Button Content="Burn / WiX (/quiet /norestart)" Tag="/quiet /norestart" Click="OnDeployPresetFlagClick"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border DockPanel.Dock="Top" Background="#1C212E" BorderBrush="#282F40" BorderThickness="1"
                            CornerRadius="12" Padding="14,10" Margin="0,0,0,14">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Clear Log" Click="OnClearDeployLogClick"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                                <TextBlock Text="ONE-CLICK WINGET SILENT INSTALL:" FontSize="11" FontWeight="Bold" Foreground="#9CA3AF"
                                           VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <Button Content="7-Zip" Tag="7zip.7zip" Click="OnWingetQuickInstallClick"/>
                                <Button Content="Google Chrome" Tag="Google.Chrome" Click="OnWingetQuickInstallClick"/>
                                <Button Content="Mozilla Firefox" Tag="Mozilla.Firefox" Click="OnWingetQuickInstallClick"/>
                                <Button Content="VLC Media Player" Tag="VideoLAN.VLC" Click="OnWingetQuickInstallClick"/>
                                <Button Content="Notepad++" Tag="Notepad++.Notepad++" Click="OnWingetQuickInstallClick"/>
                                <Button Content="VS Code" Tag="Microsoft.VisualStudioCode" Click="OnWingetQuickInstallClick"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border Background="#090C12" BorderBrush="#282F40" BorderThickness="1" CornerRadius="12" Padding="4">
                        <TextBox x:Name="DeployOutputBox" IsReadOnly="True" Background="Transparent"
                                 Foreground="#E2E8F0" BorderThickness="0" Padding="14,12"
                                 FontFamily="Menlo, Consolas, monospace" FontSize="12.5"
                                 TextWrapping="Wrap" AcceptsReturn="True"/>
                    </Border>
                </DockPanel>

                <!-- ==================== 5. DEDICATED WINDOWS UPDATE VIEW ==================== -->
                <DockPanel x:Name="UpdatesPanel" IsVisible="False">

                    <Border DockPanel.Dock="Top" Background="#1C212E" BorderBrush="#282F40" BorderThickness="1"
                            CornerRadius="12" Padding="16,14" Margin="0,0,0,12">
                        <StackPanel Spacing="10">
                            <DockPanel>
                                <Border x:Name="UpdatesAdminBadge" DockPanel.Dock="Right" Background="#24F59E0B" CornerRadius="6" Padding="10,3">
                                    <TextBlock x:Name="UpdatesAdminText" Text="Checking elevation…" FontSize="11.5" FontWeight="SemiBold" Foreground="#FBBF24"/>
                                </Border>
                                <TextBlock Text="WINDOWS UPDATE CONTROL CENTER" FontSize="11" FontWeight="Bold" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                            </DockPanel>

                            <WrapPanel>
                                <Button Content="↻  Status" Margin="0,0,8,6" Click="OnUpdateOpClick" Tag="status"/>
                                <Button Content="🔍  Check Pending" Background="#3B82F6" Foreground="White" Margin="0,0,8,6" Click="OnUpdateOpClick" Tag="list-pending"/>
                                <Button Content="⬇  Install ALL Updates" Foreground="#F87171" Margin="0,0,8,6" Click="OnUpdateOpClick" Tag="install-all"/>
                                <Button Content="🎯  Install Specific KB" Foreground="#F87171" Margin="0,0,8,6" Click="OnUpdateOpClick" Tag="install-kb"/>
                                <Button Content="📜  Update History" Margin="0,0,8,6" Click="OnUpdateOpClick" Tag="history"/>
                                <Button Content="⏸  Pause (Days)" Margin="0,0,8,6" Click="OnUpdateOpClick" Tag="pause"/>
                                <Button Content="▶  Resume Updates" Margin="0,0,8,6" Click="OnUpdateOpClick" Tag="resume"/>
                                <Button Content="🚫  Disable Auto-Update" Foreground="#F87171" Margin="0,0,8,6" Click="OnUpdateOpClick" Tag="disable-auto"/>
                                <Button Content="✅  Enable Auto-Update" Margin="0,0,8,6" Click="OnUpdateOpClick" Tag="enable-auto"/>
                                <Button Content="🔄  Restart Update Service" Margin="0,0,8,6" Click="OnUpdateOpClick" Tag="restart-service"/>
                                <Button Content="🧹  Reset Components" Foreground="#F87171" Margin="0,0,8,6" Click="OnUpdateOpClick" Tag="reset"/>
                            </WrapPanel>

                            <Grid ColumnDefinitions="1.2*,12,*">
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="KB Number (for 'Install Specific KB', e.g. KB5030211)" FontSize="11.5" Foreground="#9CA3AF" Margin="0,0,0,4"/>
                                    <TextBox x:Name="UpdateKbBox" Text=""/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Pause Duration in Days (1–35, for 'Pause')" FontSize="11.5" Foreground="#9CA3AF" Margin="0,0,0,4"/>
                                    <TextBox x:Name="UpdateDaysBox" Text="7"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock x:Name="UpdatesMessageText" Text="Click 'Status' or 'Check Pending' to inspect Windows Update on the remote PC."
                                   Foreground="#9CA3AF" FontSize="12.5" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </DockPanel>

                    <Border Background="#090C12" BorderBrush="#282F40" BorderThickness="1" CornerRadius="12" Padding="4">
                        <DockPanel>
                            <TextBlock x:Name="UpdatesHeaderText" DockPanel.Dock="Top" FontFamily="Menlo, Consolas, monospace" FontSize="12.5"
                                       FontWeight="Bold" Foreground="#93C5FD" Margin="14,10,14,6"/>
                            <ListBox x:Name="UpdatesRowsList" Background="Transparent" BorderThickness="0"
                                     FontFamily="Menlo, Consolas, monospace" FontSize="12.5"
                                     SelectionChanged="OnUpdatesRowSelected"/>
                        </DockPanel>
                    </Border>
                </DockPanel>

                <!-- ==================== 6. SYSTEM CONTROL VIEW ==================== -->
                <DockPanel x:Name="SystemPanel" IsVisible="False">

                    <Border DockPanel.Dock="Top" Background="#1C212E" BorderBrush="#282F40" BorderThickness="1"
                            CornerRadius="12" Padding="16,12" Margin="0,0,0,12">
                        <StackPanel Spacing="10">
                            <TextBlock Text="SYSTEM CONTROL — WINDOWS UPDATE, SERVICES, POWER, REGISTRY &amp; SETTINGS" FontSize="11" FontWeight="Bold" Foreground="#9CA3AF"/>
                            <WrapPanel x:Name="SystemAreaPanel"/>
                            <WrapPanel x:Name="SystemActionPanel"/>
                            <Grid ColumnDefinitions="1.4*,12,*">
                                <StackPanel Grid.Column="0">
                                    <TextBlock x:Name="SystemTargetLabel" Text="Target" FontSize="11.5" Foreground="#9CA3AF" Margin="0,0,0,4"/>
                                    <TextBox x:Name="SystemTargetBox"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock x:Name="SystemExtraLabel" Text="Extra argument" FontSize="11.5" Foreground="#9CA3AF" Margin="0,0,0,4"/>
                                    <TextBox x:Name="SystemExtraBox"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Filter:" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                            <TextBox x:Name="SystemFilterBox" Width="220" TextChanged="OnSystemFilterChanged"/>
                        </StackPanel>
                        <TextBlock x:Name="SystemMessageText" Text="Pick an area and an action. Changes need the agent to run as Administrator (HomeRmsAgent.exe --elevate)."
                                   Foreground="#9CA3AF" FontSize="12.5" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
                    </DockPanel>

                    <Border Background="#090C12" BorderBrush="#282F40" BorderThickness="1" CornerRadius="12" Padding="4">
                        <DockPanel>
                            <TextBlock x:Name="SystemHeaderText" DockPanel.Dock="Top" FontFamily="Menlo, Consolas, monospace" FontSize="12.5"
                                       FontWeight="Bold" Foreground="#93C5FD" Margin="14,10,14,6"/>
                            <ListBox x:Name="SystemRowsList" Background="Transparent" BorderThickness="0"
                                     FontFamily="Menlo, Consolas, monospace" FontSize="12.5"
                                     SelectionChanged="OnSystemRowSelected"/>
                        </DockPanel>
                    </Border>
                </DockPanel>

            </Grid>
        </DockPanel>
    </Grid>
</Window>
