<Window x:Class="HomeRms.Controller.Setup.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Home RMS Controller — Setup" Height="470" Width="620"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Icon="controller.ico" Background="#07080C" Foreground="#F8FAFC">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,22">
            <Image Source="controller.png" Width="48" Height="48" Margin="0,0,14,0" RenderOptions.BitmapScalingMode="HighQuality"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Home RMS Controller Setup" FontSize="20" FontWeight="Bold" Foreground="#F8FAFC"/>
                <TextBlock x:Name="VersionSubtitle" Text="Fleet Command Center • GitHub Auto-Update Ready" FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0"/>
            </StackPanel>
        </StackPanel>

        <!-- Body Card -->
        <Border Grid.Row="1" Background="#151926" BorderBrush="#23293B" BorderThickness="1" CornerRadius="14" Padding="20">
            <StackPanel>
                <TextBlock Text="INSTALL LOCATION" FontSize="10.5" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="InstallPathBox" Grid.Column="0" Background="#0C0F17" Foreground="#F8FAFC"
                             BorderBrush="#23293B" Padding="10,8" VerticalContentAlignment="Center"/>
                    <Button Grid.Column="2" Content="Browse…" Padding="14,8" Background="#1B2030" Foreground="#F8FAFC"
                            BorderBrush="#23293B" Cursor="Hand" Click="OnBrowseClick"/>
                </Grid>

                <CheckBox x:Name="DesktopShortcutCheck" Content="Create Desktop shortcut" IsChecked="True"
                          Foreground="#F8FAFC" Margin="0,0,0,10" Cursor="Hand"/>
                <CheckBox x:Name="StartMenuCheck" Content="Create Start Menu shortcut &amp; register in Apps &amp; Features" IsChecked="True"
                          Foreground="#F8FAFC" Margin="0,0,0,10" Cursor="Hand"/>
                <CheckBox x:Name="LaunchAfterCheck" Content="Launch Home RMS Controller after installation" IsChecked="True"
                          Foreground="#F8FAFC" Margin="0,0,0,18" Cursor="Hand"/>

                <ProgressBar x:Name="Progress" Height="8" Minimum="0" Maximum="100" Value="0"
                             Background="#0C0F17" Foreground="#38BDF8" BorderThickness="0" Margin="0,0,0,10"/>
                <TextBlock x:Name="StatusLabel" Text="Ready to install Home RMS Controller on this computer."
                           FontSize="12" Foreground="#94A3B8"/>
            </StackPanel>
        </Border>

        <!-- Footer Buttons -->
        <DockPanel Grid.Row="2" Margin="0,20,0,0">
            <Button DockPanel.Dock="Left" Content="Uninstall Existing" Padding="14,9" Background="#151926"
                    Foreground="#94A3B8" BorderBrush="#23293B" Cursor="Hand" Click="OnUninstallClick"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Padding="16,9" Margin="0,0,10,0" Background="#151926"
                        Foreground="#F8FAFC" BorderBrush="#23293B" Cursor="Hand" Click="OnCancelClick"/>
                <Button x:Name="InstallBtn" Content="Install Now" Padding="22,9" Background="#0284C7"
                        Foreground="White" BorderBrush="#38BDF8" FontWeight="SemiBold" Cursor="Hand" Click="OnInstallClick"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
